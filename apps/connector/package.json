{
  "name": "@hrms/connector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Polls a ZKTeco terminal on its own LAN and posts what it reads to the HRMS.",
  "main": "./dist/main.js",
  "bin": {
    "hrms-connector": "./dist/hrms-connector.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/hrms-connector.mjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/hrms-connector.mjs",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@hrms/shared": "*",
    "@hrms/zkteco": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
