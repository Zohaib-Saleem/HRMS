// ---------------------------------------------------------------------------
// HRMS data model
//
// Conventions
//  - cuid primary keys, createdAt/updatedAt on every table
//  - companyId on every business table from day one, so a second company is a
//    feature flag rather than a migration nightmare
//  - User (login account) is deliberately separate from Employee (HR record):
//    not every employee gets a login, and not every login is an employee
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------- enums

enum UserStatus {
  /// Created but has never set a password. Cannot sign in; the only thing an
  /// invited account may do is complete a password reset, which activates it.
  INVITED
  ACTIVE
  SUSPENDED
}

/// Why an account is suspended.
///
/// The distinction is the whole point: an account switched off because the
/// person left may be switched back on when they return, and an account
/// switched off because of a security concern may not. Without recording
/// which, reactivating an employee would silently undo a deliberate lock.
enum UserSuspensionReason {
  /// Suspended automatically because the employee was terminated.
  EMPLOYMENT_TERMINATED
  /// Suspended deliberately by an administrator, for any other reason.
  ADMINISTRATIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  /// Employed but not currently working and not on a recorded leave: a
  /// sabbatical, a long unpaid break, a record parked pending paperwork.
  /// Distinct from SUSPENDED, which is a disciplinary state, and from
  /// TERMINATED, which ends the employment.
  INACTIVE
  /// Left of their own accord. Kept apart from TERMINATED because who ended
  /// the employment is a fact people ask about, and because a resignation
  /// carries a resignation date of its own alongside the last working day.
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// How much data a role reaches. Orthogonal to permissions: a permission says
/// which operation is allowed, the scope says which records it applies to.
enum DataScope {
  NONE
  OWN
  REPORTS
  REPORTS_AND_OWN
  DEPARTMENT
  ALL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

// ------------------------------------------------------------------- company

model Company {
  id           String  @id @default(cuid())
  name         String
  legalName    String?
  email        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  /// Prefix for auto-generated employee numbers, e.g. "EMP-" -> EMP-0007.
  employeeNumberPrefix String @default("EMP-")

  // Localisation defaults inherited by every module added later
  timezone     String    @default("UTC")
  currency     String    @default("USD") @db.Char(3)
  dateFormat   String    @default("dd MMM yyyy")
  weekStartsOn WeekDay   @default(MONDAY)
  /// Non-working days of the week. Data-driven so a Sunday-to-Thursday working
  /// week is configuration, not a code change.
  weekendDays  WeekDay[] @default([SATURDAY, SUNDAY])

  // --- attendance policy (phase 5) ---------------------------------------
  // Every threshold below is configuration. Nothing in the attendance
  // calculation may hard-code a number that appears here.

  /// Lateness forgiven entirely at or below this many minutes past shift start.
  graceMinutes            Int     @default(10)
  /// Worked minutes at or above this - but below fullDayMinutes - earn a half day.
  halfDayMinutes          Int     @default(240)
  /// Worked minutes at or above this earn a full present day.
  fullDayMinutes          Int     @default(480)
  /// Leaving early is forgiven at or below this many minutes before shift end.
  earlyLeaveGraceMinutes  Int     @default(10)
  overtimeEnabled         Boolean @default(true)
  /// Worked minutes beyond this count as overtime. Not additional time - a
  /// labelled portion of workedMinutes, so the two are never double-counted.
  overtimeAfterMinutes    Int     @default(480)
  /// Ceiling on overtime credited in one day, so a forgotten check-out cannot
  /// silently book 14 hours of overtime.
  overtimeDailyCapMinutes Int     @default(240)

  // --- attendance rules -----------------------------------------------------
  // The shift window an employee is measured against, and how the day either
  // side of it is scored. Defaults reproduce the confirmed office policy:
  // 09:00-18:00 with the break inside the window, overtime only after the
  // shift ends, and early arrival never earning any.

  /// Fallback shift window for an employee with no assignment. An assigned
  /// shift always wins; this is only the floor beneath it.
  defaultShiftStart String @default("09:00")
  defaultShiftEnd   String @default("18:00")

  /// Overtime measured from the applicable shift end rather than from a
  /// duration threshold. False restores the legacy behaviour, where anything
  /// past overtimeAfterMinutes of elapsed presence counted - which charges the
  /// unpaid break to the company on every ordinary day.
  overtimeFromShiftEnd         Boolean @default(true)
  /// Whether arriving before shift start earns overtime. Off: turning up early
  /// is not overtime.
  overtimeCountsEarlyArrival   Boolean @default(false)
  /// Whether arriving late is deducted from the overtime earned after shift
  /// end. Off: lateness and overtime are independent facts about the day.
  overtimeReducedByLateArrival Boolean @default(false)

  /// Whether lateness against shift start is measured at all.
  lateTrackingEnabled           Boolean @default(true)
  /// Whether leaving before shift end is measured at all.
  earlyDepartureTrackingEnabled Boolean @default(true)
  /// How far short of a full day someone may fall and still be credited one.
  ///
  /// Distinct from earlyLeaveGraceMinutes, which decides whether an early
  /// departure is RECORDED. This decides whether it costs them the day. Leaving
  /// half an hour early is worth reporting and not worth downgrading a day
  /// over, and the two thresholds are set independently because they answer
  /// different questions.
  fullDayToleranceMinutes       Int     @default(30)

  /// A check-in later than the cutoff makes the day irregular: it does not fit
  /// the shift it would otherwise be scored against, so no overtime is derived
  /// from it rather than crediting the whole evening.
  irregularCheckInEnabled         Boolean             @default(true)
  irregularCheckInCutoff          String              @default("11:00")
  irregularCheckInMode            IrregularCutoffMode @default(ABSOLUTE_TIME)
  /// Used when the mode is AFTER_SHIFT_START. 120 is the same distance the
  /// default 09:00 shift and 11:00 cutoff already express.
  irregularAfterShiftStartMinutes Int                 @default(120)

  /// Whether the break sits inside the shift window. True: the window already
  /// accounts for it and nothing is subtracted. False: the shift's break is
  /// deducted from the day before it is scored.
  breakIncludedInWindow Boolean @default(true)

  /// Overtime shorter than this is not credited at all, so a two-minute
  /// overrun does not become a payable figure. Zero credits every minute.
  overtimeMinimumMinutes    Int  @default(0)
  /// Credited overtime is rounded down to a multiple of this. Zero is no
  /// rounding.
  overtimeRoundingMinutes   Int  @default(0)
  /// Ceilings across a week and a month, applied after the daily cap. Null is
  /// no ceiling at that level.
  overtimeWeeklyCapMinutes  Int?
  overtimeMonthlyCapMinutes Int?

  /// What a day with a check-in and no check-out is worth, and what a day with
  /// neither is worth. Held as configuration because "still present" and
  /// "absent until corrected" are both defensible answers and the choice
  /// belongs to the company, not to this code.
  missingCheckOutStatus AttendanceMissingPunchRule @default(PRESENT)
  missingCheckInStatus  AttendanceMissingPunchRule @default(ABSENT)

  // --- punch integrity ----------------------------------------------------
  // What makes a day's punches trustworthy enough to derive hours from. These
  // exist because a terminal reports events, not intent: it will happily
  // record the same badge twice in a second, or a single stray evening swipe
  // that turns an ordinary day into fourteen hours. Both are configuration
  // rather than constants, because "how long is an implausible day?" is a
  // question about how this company works and has no universal answer.

  /// Two punches closer together than this are the same event seen twice, and
  /// the later one is ignored when pairing. Zero switches the collapsing off
  /// and takes every punch at face value.
  duplicatePunchWindowSeconds Int @default(60)

  /// The longest span between the first and last punch that is still believed.
  /// Beyond it the day is reported as irregular with no hours rather than
  /// crediting a figure nobody worked; the punches are untouched and the day
  /// stays visible for correction. Zero switches the check off.
  maxPlausibleSpanMinutes Int @default(960)

  /// Whether a day whose span exceeds the bound is scored on its punches
  /// anyway. Off by default: fabricating hours is the failure this prevents.
  /// On, it restores the previous behaviour for a company that wants it.
  allowImplausibleSpans Boolean @default(false)

  // --- attendance module (step 1) ----------------------------------------
  // Flags and non-working-day behaviour. Defaults reproduce what the engine
  // did before these existed, so nothing derived changes until Super Admin
  // changes a setting.

  /// Break length assumed for the default schedule when no shift is assigned.
  /// Only subtracted when breakIncludedInWindow is false.
  defaultBreakMinutes Int @default(0)

  /// Lateness at or above this many minutes carries the LATE flag. Zero flags
  /// any lateness the grace period did not forgive. Grace decides what is
  /// recorded; this decides what is reported as a late day.
  lateThresholdMinutes       Int @default(0)
  /// Same rule for leaving early.
  earlyLeaveThresholdMinutes Int @default(0)

  /// What time worked on a weekend or holiday is worth.
  weekendWorkRule NonWorkingDayWorkRule @default(AS_WORKING_DAY)
  holidayWorkRule NonWorkingDayWorkRule @default(AS_WORKING_DAY)

  // --- check-in location restriction (phase 5) ----------------------------
  /// Off by default: existing companies keep unrestricted check-in.
  locationRestrictionEnabled Boolean  @default(false)
  /// Fallback radius for locations that do not set their own.
  defaultGeofenceRadiusM     Int      @default(200)
  /// Off by default: existing companies keep unrestricted check-in.
  ipRestrictionEnabled       Boolean  @default(false)
  /// Networks permitted to check in, as CIDR blocks or bare addresses. Empty
  /// while the restriction is on means nothing is permitted - fail closed.
  allowedCheckInCidrs        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments  Department[]
  teams        Team[]
  designations Designation[]
  locations    Location[]
  employees    Employee[]
  users        User[]
  roles        Role[]
  auditLogs    AuditLog[]

  // --- phase 3 ---
  approvalRequests      ApprovalRequest[]
  notifications         Notification[]
  attendanceRecords     AttendanceRecord[]
  attendanceAdjustments AttendanceAdjustment[]
  regularizations       AttendanceRegularizationRequest[]
  shifts                Shift[]
  shiftAssignments      EmployeeShiftAssignment[]
  shiftChangeRequests   ShiftChangeRequest[]
  timesheets            Timesheet[]

  // --- phase 6 ---
  attendancePolicies          AttendancePolicy[]
  attendancePolicyAssignments AttendancePolicyAssignment[]

  // --- phase 7 ---
  attendanceDevices        AttendanceDevice[]
  attendanceDeviceMappings AttendanceDeviceUserMapping[]
  attendanceDeviceSyncs    AttendanceDeviceSync[]
  attendanceRawPunches     AttendanceRawPunch[]
  attendanceDeviceUsers    AttendanceDeviceEnrolledUser[]

  // --- phase 4 ---
  leaveTypes    LeaveType[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  holidays      Holiday[]

  // --- phase 9 ---
  payrollSettings          PayrollSettings?
  payrollProfiles          PayrollProfile[]
  employeeSalaries         EmployeeSalary[]
  salaryComponents         SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollPeriods           PayrollPeriod[]
  payrollRuns              PayrollRun[]
  payrollLines             PayrollLine[]
  payrollAdjustments       PayrollAdjustment[]
  payslips                 Payslip[]
  payrollExceptions        PayrollException[]

  // --- phase 10 ---
  links             CompanyLink[]
  employeeContracts EmployeeContract[]
  policies          CompanyPolicy[]
  policyAssignments EmployeePolicyAssignment[]
  salaryRevisions   SalaryRevision[]
  employeeLoans     EmployeeLoan[]
  loanInstallments  EmployeeLoanInstallment[]

  @@map("companies")
}

// -------------------------------------------------------------- organisation

model Department {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true)

  // Optional org-chart head. Named relation keeps it distinct from employees.
  headEmployeeId String?   @unique
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  // Self-hierarchy. Cycles are prevented in the service layer, not the database.
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams     Team[]
  employees Employee[] @relation("EmployeeDepartment")

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([parentDepartmentId])
  @@map("departments")
}

/// Job title as a lookup record rather than free text, so reporting and
/// filtering stay consistent across the organisation.
model Designation {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("designations")
}

/// Physical work location. Holiday calendars, shifts and attendance policies
/// hang off this in later phases.
model Location {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  timezone     String?

  /// Geofence centre. Optional: a location without coordinates simply cannot
  /// be used to restrict check-in, which is reported rather than assumed.
  latitude             Float?
  longitude            Float?
  /// Overrides the company default radius for this site.
  geofenceRadiusMeters Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  holidays  Holiday[]
  devices   AttendanceDevice[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("locations")
}

model Team {
  id           String  @id @default(cuid())
  companyId    String
  departmentId String
  name         String
  description  String?
  isActive     Boolean @default(true)

  leadEmployeeId String?   @unique
  leadEmployee   Employee? @relation("TeamLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[] @relation("EmployeeTeam")

  @@unique([departmentId, name])
  @@index([companyId, isActive])
  @@map("teams")
}

model Employee {
  id             String @id @default(cuid())
  companyId      String
  employeeNumber String

  // --- identity -------------------------------------------------------------
  firstName     String
  middleName    String?
  lastName      String
  displayName   String?
  workEmail     String?
  personalEmail String?
  phone         String?
  personalPhone String?
  photoUrl      String?
  /// Father's name, as carried by the payroll roster this record was imported
  /// from. Kept distinct from middleName: it is a separate person, not part of
  /// this employee's own name.
  fatherName    String?

  // --- job ------------------------------------------------------------------
  /// Retained alongside designationId as a free-text fallback for imported
  /// records whose title does not yet map to a Designation.
  jobTitle           String?
  designationId      String?
  departmentId       String?
  teamId             String?
  locationId         String?
  managerId          String?
  /// Dual reporting - a second manager for matrix organisations.
  secondaryManagerId String?

  employmentType        EmploymentType @default(FULL_TIME)
  status                EmployeeStatus @default(ACTIVE)
  hireDate              DateTime?      @db.Date
  confirmationDate      DateTime?      @db.Date
  terminationDate       DateTime?      @db.Date
  /// The day the employee handed in their resignation. Set when the status is
  /// RESIGNED. Deliberately separate from terminationDate, which is the last
  /// day worked - the two are rarely the same and payroll reads the latter.
  resignationDate       DateTime?      @db.Date
  sourceOfHire          String?
  linkedinUrl           String?
  /// Prior experience in whole months, kept as a number so it can be summed.
  priorExperienceMonths Int?

  // --- personal -------------------------------------------------------------
  dateOfBirth   DateTime?      @db.Date
  gender        Gender?
  maritalStatus MaritalStatus?
  nationality   String?
  bloodGroup    String?
  placeOfBirth  String?
  religion      String?

  presentAddress   String?
  permanentAddress String?
  /// Structured address parts, imported alongside the free-text address above
  /// rather than parsed out of it, because the roster supplies them separately.
  addressCity      String?
  addressProvince  String?
  addressState     String?
  addressCountry   String?
  addressZipCode   String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // --- restricted ------------------------------------------------------------
  // Readable only with employee.sensitive.read. Field-level enforcement and
  // read-auditing land in phase 8; until then the API strips these from
  // responses for callers without that permission.
  nationalId        String?
  /// Issue and expiry of the national identity document above (CNIC / Emirates
  /// ID). Separate from the passport dates: they are different documents.
  nationalIdIssued  DateTime? @db.Date
  nationalIdExpiry  DateTime? @db.Date
  passportNumber    String?
  passportExpiry    DateTime? @db.Date
  visaNumber        String?
  visaExpiry        DateTime? @db.Date
  bankAccountNumber String?
  bankAccountTitle  String?
  bankName          String?

  // --- roster attributes (imported) ----------------------------------------
  // Values carried by the payroll roster that have no behavioural meaning here
  // yet. Held as supplied so the import is lossless and nothing has to be
  // re-keyed when a feature does start reading them.

  /// Site grouping as the roster labels it. Parallel to locationId, which is
  /// the HRMS's own record - this is the source system's wording, kept verbatim.
  area                     String?
  employeeGroup            String?
  /// Outsourcing arrangement, where the roster records one.
  vendor                   String?
  familyCode               String?
  /// "Probation" / "Permanent" as supplied. Deliberately not an enum and not
  /// folded into `status`: EmployeeStatus answers whether someone is employed,
  /// this answers whether their employment is confirmed. Two different questions.
  confirmationStatus       String?
  expectedConfirmationDays Int?
  /// Access template named by the roster. Not a Role: nothing reads it, and
  /// mapping it onto one would grant permissions the import never intended.
  roleTemplate             String?
  allowManualAttendance    Boolean?
  allowEmployeeLogin       Boolean?

  notes String?

  // Optional link to a login account (1:1)
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department?                   @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  team             Team?                         @relation("EmployeeTeam", fields: [teamId], references: [id], onDelete: SetNull)
  designation      Designation?                  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location         Location?                     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  deviceMappings   AttendanceDeviceUserMapping[]
  rawPunches       AttendanceRawPunch[]
  manager          Employee?                     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]                    @relation("EmployeeManager")
  secondaryManager Employee?                     @relation("EmployeeSecondaryManager", fields: [secondaryManagerId], references: [id], onDelete: SetNull)
  secondaryReports Employee[]                    @relation("EmployeeSecondaryManager")
  user             User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)

  workExperience EmployeeWorkExperience[]

  headOfDepartment Department? @relation("DepartmentHead")
  leadOfTeam       Team?       @relation("TeamLead")

  // --- phase 3 ---
  approvalRequests      ApprovalRequest[]                 @relation("ApprovalRequester")
  approvalSteps         ApprovalStep[]                    @relation("ApprovalApprover")
  attendanceRecords     AttendanceRecord[]
  attendanceAdjustments AttendanceAdjustment[]
  regularizations       AttendanceRegularizationRequest[]
  shiftAssignments      EmployeeShiftAssignment[]
  shiftChangeRequests   ShiftChangeRequest[]
  timesheets            Timesheet[]

  // --- phase 4 ---
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  // --- phase 9 ---
  payrollProfile     PayrollProfile?
  salaries           EmployeeSalary[]
  salaryComponents   EmployeeSalaryComponent[]
  payrollLines       PayrollLine[]
  payrollAdjustments PayrollAdjustment[]
  payslips           Payslip[]

  // --- phase 10: contracts, policies, salary revisions and loans ---
  contracts         EmployeeContract[]
  policyAssignments EmployeePolicyAssignment[]
  salaryRevisions   SalaryRevision[]
  loans             EmployeeLoan[]
  loanInstallments  EmployeeLoanInstallment[]

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, designationId])
  @@index([companyId, locationId])
  @@index([managerId])
  @@index([lastName, firstName])
  @@map("employees")
}

/// Repeating sub-record: employment history before joining this company.
model EmployeeWorkExperience {
  id         String @id @default(cuid())
  employeeId String

  companyName String
  jobTitle    String?
  fromDate    DateTime? @db.Date
  toDate      DateTime? @db.Date
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_work_experience")
}

// ---------------------------------------------------------------- auth & rbac

model User {
  id        String @id @default(cuid())
  companyId String

  email        String
  passwordHash String
  firstName    String
  lastName     String

  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)

  /// Set while suspended, cleared on restore. Null on an account that has never
  /// been suspended.
  suspendedReason        UserSuspensionReason?
  suspendedAt            DateTime?
  /// The user who suspended this account. Null when the system did it.
  suspendedById          String?
  /// What the status was before suspension, so restoring puts it back rather
  /// than assuming everyone was ACTIVE. An invited account that never signed in
  /// returns to INVITED, not to a working login it never had.
  statusBeforeSuspension UserStatus?

  // Deterministic avatar tint so the UI needs no uploaded images yet
  avatarColor String @default("#3f6cd6")

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              Employee?
  userRoles             UserRole[]
  sessions              Session[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  attendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustmentActor")

  /// Who suspended this account, when an administrator did.
  suspendedBy    User?  @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers User[] @relation("UserSuspendedBy")

  // --- phase 3 ---
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  @@unique([email])
  @@index([companyId, status])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?

  /// How far this role can see. Narrows every list query and record fetch,
  /// independently of which permissions the role holds.
  dataScope DataScope @default(OWN)

  /// Seeded by the system - cannot be deleted.
  isSystem Boolean @default(false)

  /// SUPER_ADMIN - permissions cannot be edited away, which prevents lock-out.
  isProtected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  groupKey    String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Server-side session. The cookie carries an opaque token; only its SHA-256
/// hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// --------------------------------------------------------------------- audit

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  actorId   String?

  /// Dotted verb, e.g. auth.login, company.update, role.permissions.update
  action     String
  entityType String
  entityId   String?
  summary    String?

  /// Field-level diff. Secrets are redacted before they reach here.
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ===========================================================================
// PHASE 3 - approvals, notifications, and the time-tracking foundation
// ===========================================================================

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Which domain record an approval is about. The engine stays generic: it
/// never imports the domain modules, it only stores the pair
/// (subjectType, subjectId) and lets each module resolve its own record.
enum ApprovalSubjectType {
  ATTENDANCE_REGULARIZATION
  SHIFT_CHANGE
  TIMESHEET
  LEAVE_REQUEST
  /// An employee asking for a salary advance or loan. Same engine as every
  /// other request; the loan record is the subject.
  LOAN_REQUEST
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_CANCELLED
  PASSWORD_RESET
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  /// Worked at least halfDayMinutes but less than fullDayMinutes.
  HALF_DAY
  ABSENT
  ON_LEAVE
  WEEKEND
  HOLIDAY
}

enum AttendanceSource {
  SELF
  SYSTEM
  ADMIN
  /// Derived from punches captured by a physical attendance terminal.
  DEVICE
}

/// Where the person worked from. Recorded at check-in.
/// What a day with a punch missing on one end is worth.
/// How the irregular-arrival cutoff is expressed.
enum IrregularCutoffMode {
  /// A wall-clock time, e.g. 11:00. Right for one shared office schedule.
  ABSOLUTE_TIME
  /// Minutes past the employee's own shift start. The only form that works
  /// when different people start at different times.
  AFTER_SHIFT_START
}

enum AttendanceMissingPunchRule {
  /// Counted present. The day is still running, or somebody forgot.
  PRESENT
  /// Counted absent until a correction is approved.
  ABSENT
  /// Scored on the elapsed thresholds like any other day.
  THRESHOLD
}

enum AttendanceMode {
  OFFICE
  REMOTE
}

/// What time worked on a non-working day is worth.
enum NonWorkingDayWorkRule {
  /// Scored by the ordinary rules: overtime after the shift end, and any
  /// overtime flows to payroll at the non-working-day multiplier. The
  /// behaviour in force before the rule existed.
  AS_WORKING_DAY
  /// Every worked minute is overtime, up to the daily cap.
  ALL_OVERTIME
  /// The punches are kept and shown; nothing is credited.
  IGNORE
}

/// Why an attendance adjustment was written.
enum AttendanceAdjustmentKind {
  /// A person corrected a processed day.
  CORRECTION
  /// A PunchCode mapping changed and punches were re-attributed.
  MAPPING_CHANGE
}

/// A reported property of a day, alongside its status. A late day is still a
/// present day; the flag says what else was true about it.
enum AttendanceFlag {
  LATE
  EARLY_LEAVE
  OVERTIME
  MISSING_PUNCH
  IRREGULAR
  MANUAL
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------ approvals

/// One approval request, whatever it is about.
model ApprovalRequest {
  id        String @id @default(cuid())
  companyId String

  subjectType ApprovalSubjectType
  /// Id of the domain record. Deliberately not a foreign key - the engine is
  /// shared by several tables and must not depend on any of them.
  subjectId   String

  requesterEmployeeId String
  requesterUserId     String?

  title   String
  summary String?

  status      ApprovalStatus @default(PENDING)
  currentStep Int            @default(1)

  decidedAt       DateTime?
  decidedByUserId String?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterEmployee Employee        @relation("ApprovalRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  steps             ApprovalStep[]
  events            ApprovalEvent[]

  @@unique([subjectType, subjectId])
  @@index([companyId, status])
  @@index([companyId, subjectType, subjectId])
  @@index([requesterEmployeeId, status])
  @@map("approval_requests")
}

/// One level of an approval chain. Multi-level flows are several rows with
/// increasing stepOrder; the request advances as each is approved.
model ApprovalStep {
  id                String @id @default(cuid())
  approvalRequestId String
  stepOrder         Int

  /// Either a named employee, or a role key resolved at decision time.
  approverEmployeeId String?
  approverRoleKey    String?

  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  comment         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalRequest  ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?       @relation("ApprovalApprover", fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@unique([approvalRequestId, stepOrder])
  @@index([approverEmployeeId, status])
  @@map("approval_steps")
}

/// Append-only transition history. Never updated, never deleted - the API
/// exposes no mutation for this table at all.
model ApprovalEvent {
  id                String @id @default(cuid())
  approvalRequestId String

  actorUserId String?
  action      String
  fromStatus  ApprovalStatus?
  toStatus    ApprovalStatus
  comment     String?

  createdAt DateTime @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId, createdAt])
  @@map("approval_events")
}

// -------------------------------------------------------------- notifications

model Notification {
  id        String @id @default(cuid())
  companyId String
  /// Recipient login account.
  userId    String

  type    NotificationType
  title   String
  message String

  /// Optional pointer back to whatever this is about.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------ password resets

/// Only the SHA-256 hash of the token is stored, exactly as with sessions, so
/// a database leak cannot be replayed as a reset.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestedIp String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------- attendance

model AttendanceRecord {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime @db.Date

  status        AttendanceStatus @default(PRESENT)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  workedMinutes Int?
  notes         String?
  source        AttendanceSource @default(SELF)
  mode          AttendanceMode?

  /// The shift in force on the day, captured at check-in so a later shift
  /// change cannot retrospectively alter how late someone was.
  shiftId     String?
  lateMinutes Int?

  /// Derived from the policy at write time so reports never have to recompute.
  earlyLeaveMinutes Int?
  /// The portion of workedMinutes beyond the configured overtime threshold.
  overtimeMinutes   Int?
  /// The day started too late to fit the shift it was scored against. Stored
  /// by the engine at write time; rows from before the column existed read
  /// false, which is what they were reported as.
  irregular         Boolean @default(false)

  /// Where the check-in came from, when the company records it. Stored for the
  /// audit trail even when the restriction is switched off.
  checkInLatitude  Float?
  checkInLongitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift       Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  adjustments AttendanceAdjustment[]

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@index([companyId, status])
  @@map("attendance_records")
}

/// One manual change to processed attendance, or one re-attribution of
/// punches after a mapping correction.
///
/// The raw punch is never edited and the record is overwritten in place, so
/// this ledger is what makes a correction auditable: old value, new value,
/// who, why and when, per field. Nothing here is ever deleted.
model AttendanceAdjustment {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime @db.Date
  recordId   String?

  kind          AttendanceAdjustmentKind @default(CORRECTION)
  /// Names of the fields that changed, in the order they are shown.
  changedFields String[]
  before        Json
  after         Json
  reason        String
  actorId       String?

  createdAt DateTime @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  actor    User?             @relation("AttendanceAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([companyId, createdAt])
  @@map("attendance_adjustments")
}

/// A request to correct an attendance record. Carries its own status mirroring
/// the approval so the domain table can be queried without joining the engine.
model AttendanceRegularizationRequest {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  attendanceDate DateTime @db.Date

  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  requestedStatus     AttendanceStatus?
  reason              String

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, attendanceDate])
  @@map("attendance_regularization_requests")
}

// --------------------------------------------------------------------- shifts

model Shift {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?

  /// Local wall-clock times as HH:mm. Timezone comes from the work location.
  startTime    String
  endTime      String
  breakMinutes Int     @default(0)
  isActive     Boolean @default(true)
  description  String?

  /// Days this shift works. Empty means the company's working days (every day
  /// that is not a configured weekend day). A day outside the list is an off
  /// day for anyone on the shift.
  workingDays WeekDay[] @default([])

  /// Rostered minutes, for reports and payroll. Null derives it from the
  /// window and the break, the way it always has been.
  expectedMinutes Int?

  /// Rule overrides. Null inherits the company attendance rules, so a shift
  /// states only what is different about it.
  graceMinutes                  Int?
  earlyLeaveGraceMinutes        Int?
  lateTrackingEnabled           Boolean?
  earlyDepartureTrackingEnabled Boolean?
  overtimeEnabled               Boolean?
  overtimeDailyCapMinutes       Int?
  overtimeMinimumMinutes        Int?

  /// When the definition took effect, for the record. Assignments carry their
  /// own dates; this documents the shift itself.
  effectiveFrom DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeShiftAssignment[]
  attendance  AttendanceRecord[]
  requestedBy ShiftChangeRequest[]      @relation("RequestedShift")
  currentOf   ShiftChangeRequest[]      @relation("CurrentShift")

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("shifts")
}

model EmployeeShiftAssignment {
  id         String @id @default(cuid())
  companyId  String
  employeeId String
  shiftId    String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([companyId, shiftId])
  @@map("employee_shift_assignments")
}

model ShiftChangeRequest {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  currentShiftId   String?
  requestedShiftId String
  effectiveFrom    DateTime @db.Date
  reason           String

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentShift   Shift?   @relation("CurrentShift", fields: [currentShiftId], references: [id], onDelete: SetNull)
  requestedShift Shift    @relation("RequestedShift", fields: [requestedShiftId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, effectiveFrom])
  @@map("shift_change_requests")
}

// ----------------------------------------------------------------- timesheets

model Timesheet {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status       TimesheetStatus @default(DRAFT)
  totalMinutes Int             @default(0)
  notes        String?

  submittedAt       DateTime?
  approvalRequestId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  TimesheetEntry[]

  @@unique([employeeId, periodStart])
  @@index([companyId, status])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  date        DateTime @db.Date
  minutes     Int
  description String?

  /// MANUAL unless the line was filled from captured attendance.
  source             TimesheetEntrySource @default(MANUAL)
  /// The attendance day this line mirrors, when it came from one.
  attendanceRecordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId, date])
  @@map("timesheet_entries")
}

// ===========================================================================
// PHASE 4 - leave and holidays
// ===========================================================================

/// Half-day support. A range longer than one day is always FULL_DAY; the half
/// options only make sense for a single-day request.
enum LeaveDayPart {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

/// Leave policy, entirely data-driven. Nothing about entitlement, accrual or
/// carry-forward is hard-coded in the services - they read these columns.
model LeaveType {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?

  /// Days granted per full year. Accrual is capped at this figure so an
  /// employee can never silently exceed their entitlement.
  annualEntitlementDays Decimal @db.Decimal(6, 2)

  /// Days earned per completed month. Usually annualEntitlement / 12, but kept
  /// separate so a policy can accrue faster or slower than a flat twelfth.
  monthlyAccrualDays Decimal @db.Decimal(6, 2)

  carryForwardEnabled Boolean  @default(false)
  /// Maximum days that survive a year boundary. Null means uncapped, which is
  /// only meaningful when carryForwardEnabled is true.
  carryForwardCapDays Decimal? @db.Decimal(6, 2)

  /// Unpaid leave still consumes a balance but is flagged for payroll later.
  isPaid   Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]
  balances LeaveBalance[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("leave_types")
}

/// Per employee, per leave type, per year.
///
/// Deliberately stores only what cannot be derived: the opening balance carried
/// in from last year, and any manual adjustment an administrator has made.
/// Accrued, used and pending are all computed from the leave type policy and
/// the request rows, so a stored total can never drift from reality.
model LeaveBalance {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  year        Int

  /// Carried forward from the previous year, already capped on write.
  openingDays    Decimal @default(0) @db.Decimal(6, 2)
  /// Administrative correction, positive or negative.
  adjustmentDays Decimal @default(0) @db.Decimal(6, 2)
  adjustmentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String

  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  dayPart   LeaveDayPart @default(FULL_DAY)

  /// Working days consumed, weekends and applicable holidays already removed.
  /// Stored because the holiday calendar may change after approval and the
  /// figure the decision was made on must not move retrospectively.
  totalDays Decimal @db.Decimal(6, 2)

  reason String

  /// Supporting evidence for the request - a medical certificate, a booking.
  /// Held as a link rather than a file: there is no document store yet, and a
  /// URL is lossless where a missing upload endpoint would be a blocker.
  documentUrl  String?
  documentName String?

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  decidedAt   DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([employeeId, status])
  @@map("leave_requests")
}

/// A non-working day. `locationId` null means the holiday applies company-wide;
/// employees otherwise inherit the calendar of the location they are assigned to.
model Holiday {
  id        String   @id @default(cuid())
  companyId String
  name      String
  date      DateTime @db.Date

  /// Null = all locations.
  locationId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct, so this stops duplicates for a named
  // location only. The company-wide case is enforced in the service layer.
  @@unique([companyId, date, locationId])
  @@index([companyId, date])
  @@index([locationId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------- phase 6

/// How broadly an attendance policy applies. Resolution runs most specific
/// first, so an employee override beats a team one, which beats a department
/// one, which beats the company baseline.
enum AttendancePolicyScope {
  COMPANY
  DEPARTMENT
  TEAM
  EMPLOYEE
}

/// A named set of attendance thresholds.
///
/// The Company row still carries the baseline every employee falls back to, so
/// nothing here is required for the system to work. A policy exists only to
/// override that baseline for part of the workforce, or to change it from a
/// date onwards without rewriting how past days were scored.
model AttendancePolicy {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?

  graceMinutes            Int     @default(10)
  halfDayMinutes          Int     @default(240)
  fullDayMinutes          Int     @default(480)
  earlyLeaveGraceMinutes  Int     @default(10)
  overtimeEnabled         Boolean @default(true)
  overtimeAfterMinutes    Int     @default(480)
  overtimeDailyCapMinutes Int     @default(240)

  /// Nullable throughout: null means "inherit the company value". An override
  /// that had to restate every rule would drift from the baseline the moment
  /// the baseline changed.
  defaultShiftStart               String?
  defaultShiftEnd                 String?
  overtimeFromShiftEnd            Boolean?
  overtimeCountsEarlyArrival      Boolean?
  overtimeReducedByLateArrival    Boolean?
  fullDayToleranceMinutes         Int?
  overtimeMinimumMinutes          Int?
  overtimeRoundingMinutes         Int?
  overtimeWeeklyCapMinutes        Int?
  overtimeMonthlyCapMinutes       Int?
  breakIncludedInWindow           Boolean?
  irregularCheckInEnabled         Boolean?
  irregularCheckInMode            IrregularCutoffMode?
  irregularAfterShiftStartMinutes Int?
  irregularCheckInCutoff          String?
  lateTrackingEnabled             Boolean?
  earlyDepartureTrackingEnabled   Boolean?
  duplicatePunchWindowSeconds     Int?
  maxPlausibleSpanMinutes         Int?
  allowImplausibleSpans           Boolean?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments AttendancePolicyAssignment[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("attendance_policies")
}

/// Where and when a policy applies.
///
/// Effective dates are what keep history honest: rescoring a day in March has
/// to use the policy that was in force in March, not whatever is current. A
/// null `effectiveTo` means "still in force".
model AttendancePolicyAssignment {
  id        String                @id @default(cuid())
  companyId String
  policyId  String
  scope     AttendancePolicyScope

  /// Null for COMPANY scope; otherwise the department, team or employee id.
  /// Deliberately not a foreign key: one column cannot reference three tables,
  /// and the routes validate the target exists before writing.
  targetId String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policy  AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([companyId, scope, targetId])
  @@index([policyId])
  @@map("attendance_policy_assignments")
}

/// Where a timesheet line came from.
///
/// CAPTURED lines mirror attendance and are rewritten whenever the timesheet is
/// synced. MANUAL lines were typed by a person and a sync never touches them,
/// so the two can coexist on one timesheet without either overwriting the other.
enum TimesheetEntrySource {
  MANUAL
  CAPTURED
}

// ------------------------------------------------- attendance devices (P7)

/// How the HRMS talks to a physical attendance terminal.
enum AttendanceDeviceProtocol {
  /// ZKTeco standalone "SDK" protocol. The HRMS opens a socket to the device
  /// and pulls transaction records. Default port 4370.
  ZKTECO_TCP
  /// ZKTeco ADMS / iclock push. The device posts records to the HRMS on a
  /// schedule it manages itself; nothing is pulled.
  ZKTECO_ADMS
  /// ZKTeco terminal reached by a connector running on the device's own LAN.
  ///
  /// The terminal still speaks the plain TCP protocol above; what changes is
  /// who opens the socket. A device sitting on an office LAN that this server
  /// has no route to cannot be polled from here at all, and a terminal whose
  /// firmware has no ADMS option cannot push either. The connector closes that
  /// gap: it polls over the LAN exactly as ZKTECO_TCP would, then posts what it
  /// read over ordinary outbound HTTPS.
  ///
  /// Deliberately its own protocol rather than a flag on ZKTECO_TCP. The
  /// scheduler polls by protocol, so a device recorded as TCP is dialled every
  /// interval whether or not a route exists - which is precisely the failure
  /// this value exists to stop.
  ZKTECO_LAN_CONNECTOR
}

enum AttendanceDeviceStatus {
  /// Configured but never contacted.
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

/// How raw punches become an in and an out.
///
/// Many terminals report a punch state, but plenty are configured so every
/// punch is state 0. Guessing wrongly turns a genuine second entry into a
/// check-out, so which rule applies is per-device configuration.
enum AttendancePunchPairing {
  /// Earliest punch of the day is the in, latest is the out.
  FIRST_IN_LAST_OUT
  /// Trust the state the device reports, and ignore punches carrying none.
  DEVICE_STATE
}

enum AttendanceSyncStatus {
  RUNNING
  SUCCESS
  /// Finished, but at least one transaction could not be imported.
  PARTIAL
  FAILED
}

enum AttendanceSyncTrigger {
  SCHEDULED
  MANUAL
  STARTUP
  /// The device sent the records itself; nothing was polled.
  PUSH
}

/// A physical attendance terminal.
model AttendanceDevice {
  id         String  @id @default(cuid())
  companyId  String
  locationId String?

  name         String
  protocol     AttendanceDeviceProtocol @default(ZKTECO_TCP)
  host         String
  port         Int                      @default(4370)
  serialNumber String?

  /// The zone the device clock is set to. Punches arrive as local wall-clock
  /// readings with no offset, so without this they cannot be placed on the
  /// timeline at all.
  timeZone String @default("UTC")

  /// Comm key, encrypted at rest. Never returned by any endpoint - the API
  /// exposes only whether one is set.
  commKeyCipher String?

  isEnabled           Boolean                @default(true)
  syncIntervalMinutes Int                    @default(15)
  punchPairing        AttendancePunchPairing @default(FIRST_IN_LAST_OUT)

  status      AttendanceDeviceStatus @default(UNKNOWN)
  lastSeenAt  DateTime?
  lastSyncAt  DateTime?
  lastPunchAt DateTime?
  /// Most recent failure, kept so the screen can explain a red status without
  /// an administrator having to read server logs.
  lastError   String?

  /// Watermark. Only transactions at or after this instant are requested, which
  /// makes catch-up after an outage an ordinary sync rather than a special case.
  syncCursorAt DateTime?

  /// Held for the duration of a sync so two never overlap on one device.
  syncLockedAt  DateTime?
  syncLockToken String?

  // --- ADMS push (phase 8) -------------------------------------------------

  /// Last time the device - or its connector - posted anything, whether or not
  /// it carried records.
  lastPushAt DateTime?

  /// Version string the LAN connector last reported, so an operator can tell a
  /// stale connector from a stale device without going to the office.
  connectorVersion String?

  /// The device's shared secret, encrypted at rest.
  ///
  /// Used two ways, because both callers have the same problem: a serial number
  /// printed on a case is an identifier, not a credential. An ADMS terminal
  /// carries it as a path segment in its server URL, which is the only place
  /// its firmware can put one; a LAN connector sends it as a bearer token.
  /// Either way it is what turns a guessable identifier into a credential.
  pushTokenCipher String?

  /// Networks the device may push from. Empty means any source, which is the
  /// out-of-the-box behaviour: a terminal is plugged in and starts posting
  /// before anyone has had a chance to write down its address.
  allowedPushCidrs String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  mappings      AttendanceDeviceUserMapping[]
  syncs         AttendanceDeviceSync[]
  punches       AttendanceRawPunch[]
  enrolledUsers AttendanceDeviceEnrolledUser[]

  @@unique([companyId, name])
  @@unique([companyId, serialNumber])
  @@index([companyId, isEnabled])
  @@map("attendance_devices")
}

/// Device user id to HRMS employee.
///
/// Deliberately its own table. The number on the terminal is whatever whoever
/// enrolled the finger typed; assuming it equals an employee number, let alone a
/// database id, is how biometric imports end up attributed to the wrong person.
model AttendanceDeviceUserMapping {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  /// The identifier the device sends, as a string. Terminals pad and reuse
  /// these, so it is never treated as a number here.
  deviceUserId   String
  /// The name held on the device, for recognising a mapping at a glance.
  deviceUserName String?

  employeeId String
  isActive   Boolean @default(true)

  /// The period this mapping attributes punches for. Null `effectiveFrom`
  /// means "since the beginning", null `effectiveTo` means "still in force".
  /// A PIN reassigned to a new joiner keeps its old mapping, closed, so the
  /// leaver's punches stay theirs and the history is readable.
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One device user resolves to exactly one employee on a given DAY. The
  /// service refuses overlapping periods; the index only speeds the lookup.
  @@index([deviceId, deviceUserId])
  @@index([companyId, employeeId])
  @@map("attendance_device_user_mappings")
}

/// The enrolment roster a device holds, as last reported.
///
/// A cache, never a source of truth. It exists so the mapping screen can show
/// "PIN 1007 - AHMED" instead of asking an administrator to guess which number
/// belongs to whom, which is the difference between a mapping step that takes
/// ten minutes and one that takes an afternoon at the terminal.
///
/// Nothing here attributes a punch. Attribution is AttendanceDeviceUserMapping
/// and only that: a roster entry appearing or disappearing must never silently
/// change whose attendance a punch became.
model AttendanceDeviceEnrolledUser {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  /// The PIN as the device reports it, as a string. Terminals pad and reuse
  /// these, so it is never treated as a number.
  deviceUserId String
  name         String?
  privilege    Int?
  cardNumber   String?

  /// When the connector last saw this user on the device.
  seenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@index([companyId, deviceId])
  @@map("attendance_device_enrolled_users")
}

/// One synchronisation run, kept whether it succeeded or not.
model AttendanceDeviceSync {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  status  AttendanceSyncStatus  @default(RUNNING)
  trigger AttendanceSyncTrigger @default(SCHEDULED)

  fetched    Int @default(0)
  inserted   Int @default(0)
  duplicates Int @default(0)
  unmapped   Int @default(0)
  rejected   Int @default(0)

  /// The window actually requested, so a gap in coverage is visible.
  cursorFrom DateTime?
  cursorTo   DateTime?

  /// How many connection attempts this run took, including the successful one.
  attempts Int @default(1)

  error        String?
  /// Per-record failures: what was wrong, and with which transaction. Bounded
  /// so one broken batch cannot write an unbounded blob, and never carries a
  /// credential.
  errorDetails Json?

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  AttendanceDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  punches AttendanceRawPunch[]

  @@index([deviceId, startedAt])
  @@index([companyId, status])
  @@map("attendance_device_syncs")
}

/// A transaction exactly as the device reported it.
///
/// This is the audit trail and it is never rewritten. Attendance calculations
/// read punches and write AttendanceRecord; nothing writes back here, so a
/// recalculation can always be redone from the original evidence.
model AttendanceRawPunch {
  id        String  @id @default(cuid())
  companyId String
  deviceId  String
  syncId    String?

  deviceUserId String
  /// Resolved at import. Null means unmapped - the punch is kept and surfaced
  /// rather than dropped, and can be attributed later.
  employeeId   String?

  /// The device transaction identifier, where it provides one.
  deviceTransactionId String?
  /// The raw reading, untouched, for when a normalisation is ever questioned.
  rawTimestamp        String
  /// The zone used to normalise it, captured at import in case the device is
  /// later reconfigured.
  deviceTimeZone      String
  /// The normalised instant. This is what calculations use.
  punchedAt           DateTime
  /// The local day the punch belongs to, in the company zone.
  localDayKey         String

  /// Whatever the device said about direction, preserved verbatim.
  punchState String?
  /// Fingerprint, card, face, password - as reported.
  verifyMode String?

  /// Deterministic identity. Built from device, user, instant and whatever
  /// transaction identifier exists, so re-importing the same transaction is a
  /// no-op at the database level rather than a matter of application care.
  fingerprint String

  importedAt  DateTime  @default(now())
  /// Set once the punch has been folded into an AttendanceRecord.
  processedAt DateTime?

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device   AttendanceDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sync     AttendanceDeviceSync? @relation(fields: [syncId], references: [id], onDelete: SetNull)

  @@unique([deviceId, fingerprint])
  @@index([companyId, employeeId, localDayKey])
  @@index([companyId, deviceUserId])
  @@index([deviceId, punchedAt])
  @@index([companyId, employeeId, processedAt])
  @@map("attendance_raw_punches")
}

// ===========================================================================
// PHASE 9 - payroll
//
// The engine above decides what happened; this decides what it is worth. The
// boundary matters: nothing here reads a punch, re-derives a day or second
// guesses an attendance status. Payroll consumes DerivedDay, the same shape the
// attendance screens are built from, so a figure on a payslip can always be
// traced to a day an administrator can look at.
//
// Two rules shape most of these tables:
//
//   - Nothing is hard-coded. What a day is worth, what an absence costs, what
//     overtime multiplies by - all of it is configuration, because no two
//     companies agree and the ones that do change their minds.
//   - A finalized run is immutable. Every figure it used is copied onto the
//     line at calculation time, so a later salary edit, attendance correction
//     or policy change cannot silently rewrite what someone was paid.
// ===========================================================================

/// How an employee is paid. Effective-dated on the salary record rather than
/// the profile: moving someone from monthly to hourly is a change to their
/// terms, and last month's payroll must keep using the old ones.
enum PayrollSalaryType {
  MONTHLY
  DAILY
  HOURLY
}

/// What a monthly salary is divided by to reach a daily rate.
///
/// The single most argued-about number in payroll. A company paying by calendar
/// days and one paying by a fixed thirty produce different figures from the
/// same salary and the same attendance, and both are correct for their own
/// contracts, so this cannot be a constant in the code.
enum PayrollBasis {
  /// The actual number of days in the pay period.
  CALENDAR_DAYS
  /// A fixed figure, whatever the month contains. Usually 30 or 26.
  FIXED_DAYS
  /// Scheduled working days: the period less weekends and holidays.
  WORKING_DAYS
}

/// How often payroll is run.
///
/// Reporting and period suggestion only: the calculation reads the period's
/// actual start and end dates, so a company can run an irregular period without
/// this having to agree with it.
enum PayrollFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

/// How overtime is priced.
enum PayrollOvertimeMode {
  /// Overtime is not paid at all. Hours are still recorded and reported.
  NONE
  /// The employee's hourly rate multiplied by a factor.
  MULTIPLIER
  /// A flat amount per hour, ignoring the employee's own rate.
  FIXED_RATE
}

/// How lateness and early leaving translate into money.
enum PayrollTimeDeductionMode {
  NONE
  /// A rate for every minute past the grace period.
  PER_MINUTE
  /// A flat amount each time it happens, regardless of how long.
  PER_OCCURRENCE
}

enum PayrollComponentKind {
  EARNING
  DEDUCTION
}

/// How a component's amount is arrived at.
enum PayrollComponentCalc {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  /// value x payable days in the period
  PER_DAY
  /// value x hours actually worked in the period
  PER_HOUR
}

/// How a monthly salary is split across the days a salary segment covers.
enum PayrollProrationMethod {
  /// share = calendar days covered / calendar days in period
  CALENDAR_DAYS
  /// share = scheduled working days covered / scheduled working days in period
  WORKING_DAYS
}

/// Whether a component repeats every period or applies once.
enum PayrollComponentFrequency {
  RECURRING
  ONE_TIME
}

enum PayrollPeriodStatus {
  OPEN
  /// A finalized run exists for this period; it no longer accepts new runs.
  CLOSED
}

/// The life of a payroll run.
///
/// CALCULATING is a real state, not a UI nicety: a run being calculated must
/// refuse a second calculation, and a process that dies mid-calculation has to
/// be distinguishable from one that never started.
enum PayrollRunStatus {
  DRAFT
  CALCULATING
  REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

/// Something the calculation could not resolve confidently.
///
/// Recorded rather than guessed at. A payroll that quietly pays zero because a
/// salary was missing is worse than one that refuses to finalize and says so.
enum PayrollExceptionCode {
  MISSING_SALARY
  MISSING_PROFILE
  OVERLAPPING_SALARY
  INVALID_ATTENDANCE
  MISSING_SHIFT
  UNAPPROVED_OVERTIME
  NON_POSITIVE_NET
  INCOMPLETE_EMPLOYEE
  OVERTIME_CAPPED
}

/// BLOCKING stops finalization; WARNING is recorded and shown but does not.
enum PayrollExceptionSeverity {
  BLOCKING
  WARNING
}

/// Company-wide payroll configuration.
///
/// One row per company, created on demand with defaults that reproduce the most
/// common arrangement. Everything here can be overridden per employee on their
/// PayrollProfile; a null there means "inherit this".
model PayrollSettings {
  id        String @id @default(cuid())
  companyId String @unique

  /// How often payroll is run. Suggests period dates; nothing calculates from it.
  frequency PayrollFrequency @default(MONTHLY)

  /// Multipliers for overtime worked on a non-working day. Null uses the
  /// ordinary overtimeMultiplier, which is the behaviour before these existed.
  overtimeWeekendMultiplier Decimal? @db.Decimal(6, 3)
  overtimeHolidayMultiplier Decimal? @db.Decimal(6, 3)

  /// Scheduled minutes assumed for a day with no shift assignment behind it.
  /// Configuration rather than a constant: a company with a different working
  /// day should not need a deployment to say so.
  fallbackScheduledMinutes Int @default(480)

  /// How a monthly salary is prorated when it changes mid-period.
  prorationMethod PayrollProrationMethod @default(CALENDAR_DAYS)
  /// Day of the month pay is issued, used as the default pay date when a
  /// period is created. Null leaves the pay date to be set per period.
  payDay          Int?

  // --- what a day is worth --------------------------------------------------
  basis               PayrollBasis @default(FIXED_DAYS)
  /// Only consulted when basis is FIXED_DAYS.
  fixedBasisDays      Int          @default(30)
  /// Used to turn a daily rate into an hourly one for monthly and daily staff.
  standardHoursPerDay Decimal      @default(8) @db.Decimal(6, 2)

  // --- overtime -------------------------------------------------------------
  overtimeMode            PayrollOvertimeMode @default(MULTIPLIER)
  overtimeMultiplier      Decimal             @default(1.5) @db.Decimal(6, 3)
  /// Only consulted when overtimeMode is FIXED_RATE.
  overtimeFixedRate       Decimal             @default(0) @db.Decimal(14, 4)
  /// When true - the default - only overtime on an APPROVED timesheet is paid.
  /// Unapproved hours are still counted and reported as an exception.
  requireApprovedOvertime Boolean             @default(true)
  /// Most overtime minutes paid to one employee in one pay period. Null - the
  /// default - pays whatever the attendance engine reported, which already
  /// carries the attendance policy's daily, weekly and monthly caps. This is a
  /// pay ceiling on top of those, not a replacement for them.
  overtimeCapMinutes      Int?

  // --- what an absence costs ------------------------------------------------
  /// Whether a day recorded as ABSENT reduces pay.
  deductUnpaidAbsence Boolean @default(true)
  /// Whether leave on an unpaid leave type reduces pay.
  deductUnpaidLeave   Boolean @default(true)

  lateDeductionMode PayrollTimeDeductionMode @default(NONE)
  /// Per minute or per occurrence depending on the mode above.
  lateDeductionRate Decimal                  @default(0) @db.Decimal(14, 4)
  /// Lateness at or below this many minutes never costs anything, on top of
  /// whatever the attendance policy already forgave.
  lateGraceMinutes  Int                      @default(0)

  earlyLeaveDeductionMode PayrollTimeDeductionMode @default(NONE)
  earlyLeaveDeductionRate Decimal                  @default(0) @db.Decimal(14, 4)
  earlyLeaveGraceMinutes  Int                      @default(0)

  /// Whether a tax module is in play. Off, and nothing computes tax: the flag
  /// exists so components can be marked taxable now and a tax module written
  /// later without backfilling. No rate is stored here, because a rate that is
  /// wrong for a jurisdiction is worse than no rate at all.
  taxEnabled Boolean @default(false)

  // --- presentation ---------------------------------------------------------
  /// Decimal places money is rounded to when a line is written.
  roundingDecimals Int    @default(2)
  payslipPrefix    String @default("PS-")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

/// Per-employee payroll configuration.
///
/// Deliberately holds no amount. Money is effective-dated on EmployeeSalary;
/// this is the stable configuration that says how that money should be read.
/// Every override is nullable, and null means "use the company setting" - so a
/// company that changes its mind changes one row, not four hundred.
model PayrollProfile {
  id         String @id @default(cuid())
  companyId  String
  employeeId String @unique

  /// Excluded from every run while false, without deleting anything.
  isActive Boolean @default(true)

  basis               PayrollBasis?
  fixedBasisDays      Int?
  standardHoursPerDay Decimal?      @db.Decimal(6, 2)

  overtimeMode       PayrollOvertimeMode?
  overtimeMultiplier Decimal?             @db.Decimal(6, 3)
  overtimeFixedRate  Decimal?             @db.Decimal(14, 4)
  /// Set when this employee is paid a different hourly rate for overtime than
  /// their salary implies. Null derives it from the salary and the basis.
  hourlyRateOverride Decimal?             @db.Decimal(14, 4)

  deductUnpaidAbsence Boolean?
  deductUnpaidLeave   Boolean?

  /// Free text: bank, cash, cheque. Not a payment integration, just a note on
  /// how this person is paid, so a payslip can say so.
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("payroll_profiles")
}

/// What an employee is paid, from a date.
///
/// The rule the whole model exists for: a raise in July must not change what
/// June was worth. Records are never edited in place once a run has used them;
/// a new row is opened and the previous one closed, exactly as
/// EmployeeShiftAssignment already does for shifts.
///
/// `effectiveTo` null means "still in force". Overlapping open-ended rows are
/// rejected by the service and reported as an exception if they exist anyway.
model EmployeeSalary {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  salaryType PayrollSalaryType @default(MONTHLY)
  /// The monthly figure, the daily figure or the hourly figure, according to
  /// salaryType. One column because it is one contractual number; which unit it
  /// is read in is the type's business.
  amount     Decimal           @db.Decimal(14, 2)
  /// ISO 4217. Defaults from the company but stored per record, because a
  /// company that changes currency must not restate history.
  currency   String            @db.Char(3)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Set when this record was opened by a recorded increment rather than
  /// entered directly. The revision is the paperwork; this row is the money.
  revision SalaryRevision? @relation("RevisionSalary")

  @@index([employeeId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("employee_salaries")
}

/// The catalogue of things that can appear on a payslip besides basic pay.
///
/// A definition only: transport allowance exists as a concept here, and what
/// any particular person gets is an assignment below. Splitting the two is what
/// lets a company rename "Conveyance" to "Transport" without touching anyone's
/// pay.
model SalaryComponent {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?

  kind PayrollComponentKind
  calc PayrollComponentCalc @default(FIXED)

  /// Marks the component for a future tax module. Nothing computes tax today,
  /// and storing the flag now is cheaper than backfilling it later.
  isTaxable Boolean @default(true)
  isActive  Boolean @default(true)

  /// Where the line sits on a payslip. Lower first; ties fall back to name.
  displayOrder  Int       @default(0)
  /// The component does not apply to any period ending before this. Null
  /// means it always has.
  effectiveFrom DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeSalaryComponent[]

  @@unique([companyId, name])
  @@index([companyId, kind, isActive])
  @@map("salary_components")
}

/// One employee's entitlement to one component, from a date.
///
/// Effective-dated for the same reason salary is: a housing allowance that
/// started in March should not appear on February's payslip when February is
/// recalculated.
model EmployeeSalaryComponent {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  componentId String

  /// Read as money for FIXED and as a percentage for the PERCENT_ calcs.
  value     Decimal                   @db.Decimal(14, 4)
  frequency PayrollComponentFrequency @default(RECURRING)

  effectiveFrom DateTime  @db.Date
  /// For ONE_TIME entries this is set equal to effectiveFrom by the service, so
  /// a bonus cannot silently repeat.
  effectiveTo   DateTime? @db.Date

  isActive Boolean @default(true)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([companyId, componentId])
  @@map("employee_salary_components")
}

/// A stretch of time payroll is run for.
///
/// Kept separate from the run so the same period can be recalculated after a
/// cancelled attempt without losing the identity of the month itself.
model PayrollPeriod {
  id        String @id @default(cuid())
  companyId String
  name      String

  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  /// When people are actually paid. Reporting only; no calculation reads it.
  payDate   DateTime? @db.Date

  status PayrollPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    PayrollRun[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status])
  @@map("payroll_periods")
}

/// One attempt at paying a period.
///
/// A period may have several: a cancelled run and then a good one. Only one may
/// reach FINALIZED, which is what closes the period.
model PayrollRun {
  id        String @id @default(cuid())
  companyId String
  periodId  String

  status PayrollRunStatus @default(DRAFT)
  notes  String?

  /// Copied from company settings when the run is calculated, so the figures
  /// stay explicable after the settings change.
  currency String @db.Char(3)

  // --- totals, written by the calculation ------------------------------------
  employeeCount  Int     @default(0)
  grossTotal     Decimal @default(0) @db.Decimal(16, 2)
  deductionTotal Decimal @default(0) @db.Decimal(16, 2)
  netTotal       Decimal @default(0) @db.Decimal(16, 2)
  exceptionCount Int     @default(0)
  blockingCount  Int     @default(0)

  calculatedAt DateTime?
  calculatedBy String?
  reviewedAt   DateTime?
  reviewedBy   String?
  approvedAt   DateTime?
  approvedBy   String?
  finalizedAt  DateTime?
  finalizedBy  String?
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  /// Set while a calculation is in flight, cleared when it ends. A stale value
  /// is what tells a later request that a previous calculation died.
  calculationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           PayrollPeriod             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  lines            PayrollLine[]
  exceptions       PayrollException[]
  loanInstallments EmployeeLoanInstallment[]

  @@index([companyId, status])
  @@index([periodId, status])
  @@map("payroll_runs")
}

/// One employee's pay for one run.
///
/// Everything the calculation used is copied here, not referenced: the salary
/// amount, the basis, the multiplier, the day counts. That redundancy is the
/// point - it is what makes a finalized line survive a salary edit, an
/// attendance correction or a change of company policy without moving.
model PayrollLine {
  id         String @id @default(cuid())
  companyId  String
  runId      String
  employeeId String

  // --- snapshot of the terms used -------------------------------------------
  salaryType     PayrollSalaryType
  salaryAmount   Decimal           @db.Decimal(14, 2)
  currency       String            @db.Char(3)
  basis          PayrollBasis
  basisDays      Decimal           @db.Decimal(8, 2)
  dailyRate      Decimal           @db.Decimal(14, 4)
  hourlyRate     Decimal           @db.Decimal(14, 4)
  /// Set when more than one salary record covered the period, so a reviewer can
  /// see at a glance why the basic figure is not the round number they expect.
  salarySegments Int               @default(1)

  // --- attendance, consumed from the existing engine -------------------------
  scheduledDays           Decimal @db.Decimal(8, 2)
  scheduledMinutes        Int     @default(0)
  presentDays             Decimal @db.Decimal(8, 2)
  halfDays                Decimal @db.Decimal(8, 2)
  absentDays              Decimal @db.Decimal(8, 2)
  paidLeaveDays           Decimal @db.Decimal(8, 2)
  unpaidLeaveDays         Decimal @db.Decimal(8, 2)
  holidayDays             Decimal @db.Decimal(8, 2)
  weekendDays             Decimal @db.Decimal(8, 2)
  payableDays             Decimal @db.Decimal(8, 2)
  unpaidDays              Decimal @db.Decimal(8, 2)
  workedMinutes           Int     @default(0)
  lateOccurrences         Int     @default(0)
  lateMinutes             Int     @default(0)
  earlyLeaveOccurrences   Int     @default(0)
  earlyLeaveMinutes       Int     @default(0)
  overtimeMinutes         Int     @default(0)
  /// The subset of overtimeMinutes that sat on an approved timesheet. Only this
  /// is paid when the company requires approval.
  approvedOvertimeMinutes Int     @default(0)
  /// What was actually priced: the approved (or all) minutes after the payroll
  /// overtime cap. The overtime line on the payslip is this many minutes.
  paidOvertimeMinutes     Int     @default(0)

  // --- money ----------------------------------------------------------------
  basicAmount     Decimal @db.Decimal(14, 2)
  earningsTotal   Decimal @db.Decimal(14, 2)
  overtimeAmount  Decimal @db.Decimal(14, 2)
  deductionsTotal Decimal @db.Decimal(14, 2)
  adjustmentTotal Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @db.Decimal(14, 2)
  netAmount       Decimal @db.Decimal(14, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run        PayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  earnings   PayrollEarning[]
  deductions PayrollDeduction[]
  exceptions PayrollException[]
  payslip    Payslip?

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_lines")
}

/// One earning on one line, kept as its own row so a payslip can itemise.
///
/// The component name is copied rather than joined: renaming a component must
/// not change what a finalized payslip says it paid for.
model PayrollEarning {
  id     String @id @default(cuid())
  lineId String

  /// Null for the derived rows - basic pay and overtime - which have no
  /// catalogue entry behind them.
  componentId String?
  code        String?
  label       String
  kind        String  @default("COMPONENT")

  calc      PayrollComponentCalc @default(FIXED)
  /// The percentage or fixed figure the amount came from, for explicability.
  rate      Decimal?             @db.Decimal(14, 4)
  /// Hours or days the rate was multiplied by: overtime hours, payable days
  /// for a per-day allowance. Null when the line is a flat figure.
  units     Decimal?             @db.Decimal(10, 2)
  amount    Decimal              @db.Decimal(14, 2)
  isTaxable Boolean              @default(true)

  createdAt DateTime @default(now())

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("payroll_earnings")
}

/// One deduction on one line. Same reasoning as PayrollEarning.
model PayrollDeduction {
  id     String @id @default(cuid())
  lineId String

  componentId String?
  code        String?
  label       String
  /// ABSENCE, UNPAID_LEAVE, LATE, EARLY_LEAVE, COMPONENT, ADJUSTMENT - what
  /// produced this row, so a reviewer can tell a policy deduction from a
  /// deliberate one.
  kind        String  @default("COMPONENT")

  calc   PayrollComponentCalc @default(FIXED)
  rate   Decimal?             @db.Decimal(14, 4)
  /// The quantity the rate was applied to: days, minutes or occurrences.
  units  Decimal?             @db.Decimal(10, 2)
  amount Decimal              @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("payroll_deductions")
}

/// A correction to a finalized run.
///
/// The only way a finalized figure can be answered for. It never edits the
/// original line - it is applied to a later run, so both the original and the
/// correction remain visible and the history stays truthful.
model PayrollAdjustment {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// The finalized line being corrected, when the correction relates to one.
  originLineId String?
  /// The run the adjustment is applied in. Null until a run picks it up.
  appliedRunId String?

  kind   PayrollComponentKind
  label  String
  amount Decimal              @db.Decimal(14, 2)
  reason String

  appliedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([appliedRunId])
  @@map("payroll_adjustments")
}

/// The document an employee is entitled to see.
///
/// One per finalized line. It exists separately because it has its own identity
/// - a number people quote, an issue date, and a moment it became visible -
/// none of which belong to the calculation.
model Payslip {
  id         String @id @default(cuid())
  companyId  String
  lineId     String @unique
  employeeId String

  number      String
  issuedAt    DateTime  @default(now())
  /// Withheld until an administrator releases it, so a finalized run can be
  /// checked before anyone sees their own figure.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  line     PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([employeeId, issuedAt])
  @@map("payslips")
}

/// Something the calculation could not resolve.
///
/// Stored per run, and per line where one exists. A run carrying a BLOCKING
/// exception cannot be finalized, which is the mechanism behind "do not
/// silently produce questionable payroll".
model PayrollException {
  id         String  @id @default(cuid())
  companyId  String
  runId      String
  lineId     String?
  employeeId String?

  code     PayrollExceptionCode
  severity PayrollExceptionSeverity @default(BLOCKING)
  message  String
  /// Whatever the detector saw, for diagnosis. Never money owed to anyone.
  detail   Json?

  createdAt DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run     PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  line    PayrollLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([companyId, code])
  @@map("payroll_exceptions")
}

// ---------------------------------------------------------------- phase 10
//
// Employment paperwork and money owed: contracts, policies, salary revisions
// and loans. Everything here is append-only history by design - a contract
// that ends is not deleted, a policy that gets a new version is a new row, and
// a salary revision writes a new EmployeeSalary rather than editing the old
// one. Nothing in this section rewrites attendance, punches or a finalized
// payroll figure.

/// Company presence on the public internet, as configuration.
///
/// Deliberately a table rather than columns: "which platforms does this
/// company have?" is an answer that grows, and a new one should be a row an
/// administrator adds, not a migration. `Company.website` stays where it is -
/// this is the wider list that sits alongside it.
enum CompanyLinkKind {
  WEBSITE
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
  YOUTUBE
  DISCORD
  GITHUB
  CAREERS
  OTHER
}

model CompanyLink {
  id        String @id @default(cuid())
  companyId String

  kind  CompanyLinkKind @default(OTHER)
  /// What to call it in the UI. Free text so "GamEmpires website" and
  /// "Careers portal" are both expressible without a new enum member.
  label String
  url   String

  /// Lower first; ties fall back to label.
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, label])
  @@index([companyId, isActive, displayOrder])
  @@map("company_links")
}

// ------------------------------------------------------------------ contracts

enum EmployeeContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  INTERNSHIP
  CONSULTANCY
  PART_TIME
  TEMPORARY
}

/// Where a contract is in its life.
///
/// EXPIRED is derived from the end date in the reading layer as well, so a
/// contract nobody has touched still reports honestly; this column records the
/// decision somebody made about it.
enum EmployeeContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

/// One contract, kept forever.
///
/// Superseding a contract opens a new row and closes the old one; it never
/// edits the old one, so "what were they on last March?" stays answerable.
model EmployeeContract {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  contractType EmployeeContractType   @default(PERMANENT)
  status       EmployeeContractStatus @default(ACTIVE)

  /// A reference number as it appears on the paper, when there is one.
  reference String?

  startDate DateTime  @db.Date
  /// Null means open-ended, which is the ordinary shape of a permanent
  /// contract. A fixed-term one without an end date is reported as a gap
  /// rather than silently treated as permanent.
  endDate   DateTime? @db.Date

  /// The signed document. A link, for the same reason leave evidence is:
  /// there is no file store in this system yet.
  documentUrl  String?
  documentName String?

  /// The contract this one replaces, when it is a renewal.
  previousContractId String? @unique

  notes String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  previousContract EmployeeContract? @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewedBy        EmployeeContract? @relation("ContractRenewal")

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([companyId, endDate])
  @@map("employee_contracts")
}

// ------------------------------------------------------------------- policies

/// A policy document, at one version.
///
/// A new version is a NEW row, never an edit: an acknowledgement is an
/// acknowledgement of a particular text, and rewriting the text under a
/// signature would make the record a lie. `supersedesId` chains them so the
/// history reads in order.
model CompanyPolicy {
  id        String @id @default(cuid())
  companyId String

  name    String
  /// Free text: "1.0", "2026-Q1", "Rev C". Companies number policies their own
  /// way and an enforced scheme would be wrong for most of them.
  version String @default("1.0")

  category    String?
  description String?

  effectiveDate DateTime @db.Date

  documentUrl  String?
  documentName String?

  /// Whether it may still be assigned. Withdrawing a policy never deletes the
  /// acknowledgements already given for it.
  isActive Boolean @default(true)

  /// The earlier version this one replaces.
  supersedesId String? @unique

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supersedes   CompanyPolicy?             @relation("PolicyVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy CompanyPolicy?             @relation("PolicyVersion")
  assignments  EmployeePolicyAssignment[]

  @@unique([companyId, name, version])
  @@index([companyId, isActive])
  @@map("company_policies")
}

enum PolicyAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  DECLINED
}

/// One employee's copy of one policy version.
///
/// Never deleted and never reassigned to a different version: assigning the
/// next version creates another row, so the trail shows what was accepted and
/// when, for every version in turn.
model EmployeePolicyAssignment {
  id         String @id @default(cuid())
  companyId  String
  policyId   String
  employeeId String

  status PolicyAcknowledgementStatus @default(PENDING)

  assignedAt     DateTime  @default(now())
  assignedBy     String?
  /// When the employee is expected to have read it by. Null is no deadline.
  dueDate        DateTime? @db.Date
  acknowledgedAt DateTime?
  /// What the employee said when they acknowledged or declined it.
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policy   CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId])
  @@index([companyId, status])
  @@index([employeeId, assignedAt])
  @@map("employee_policy_assignments")
}

// ----------------------------------------------------------- salary revisions

/// An increment, as a record of the decision rather than of the number.
///
/// The number itself lives where it always did: in EmployeeSalary, which is
/// what payroll reads and which is already effective-dated, so a revision
/// dated 1 July leaves June paying June's salary. This row is the paperwork
/// around it - what it was, what it became, who approved it and why - and it
/// points at the EmployeeSalary row it opened so the two can never disagree.
model SalaryRevision {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// The salary in force before the revision. Null for a first salary.
  previousSalaryId String?
  /// The salary record this revision opened.
  salaryId         String? @unique

  salaryType PayrollSalaryType @default(MONTHLY)
  currency   String            @db.Char(3)

  currentAmount    Decimal @db.Decimal(14, 2)
  newAmount        Decimal @db.Decimal(14, 2)
  /// Stored rather than derived so a reviewer reads the figures the decision
  /// was actually made with, even if a salary row is later corrected.
  incrementAmount  Decimal @db.Decimal(14, 2)
  /// Percentage of the previous salary, to two decimals. Zero when there was
  /// no previous salary to be a percentage of.
  incrementPercent Decimal @db.Decimal(8, 2)

  effectiveDate DateTime @db.Date

  reason String
  notes  String?

  /// Who signed it off. The user id when it was someone with an account, and
  /// the name as typed either way - a director who approved it by email has no
  /// login here and the record still has to say who they were.
  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salary   EmployeeSalary? @relation("RevisionSalary", fields: [salaryId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@index([companyId, effectiveDate])
  @@map("salary_revisions")
}

// ---------------------------------------------------------------------- loans

/// Where a loan is in its life.
///
/// The distinction that matters to payroll is exactly one: only ACTIVE and
/// COMPLETED loans have ever produced a deduction, and only an ACTIVE one can
/// produce another. PENDING and REJECTED cost nobody anything.
enum EmployeeLoanStatus {
  /// Applied for by the employee, awaiting a decision.
  PENDING
  /// Decided in favour but not yet released - the schedule exists, deductions
  /// start when it is activated.
  APPROVED
  REJECTED
  /// Being repaid. This is the only status payroll deducts against.
  ACTIVE
  /// Fully repaid.
  COMPLETED
  /// Withdrawn or written off before completion.
  CANCELLED
}

enum LoanInstallmentStatus {
  SCHEDULED
  /// Claimed by a payroll run that has not been finalized yet.
  PENDING_PAYROLL
  /// Deducted by a finalized payroll run.
  PAID
  /// Deliberately not collected, without ending the loan.
  WAIVED
  SKIPPED
}

/// A loan or salary advance.
///
/// Two ways in and one way out: an administrator creates one directly, or an
/// employee applies and someone approves it. Either way the repayment schedule
/// is generated up front, so "what is left?" is a sum over rows rather than a
/// figure someone maintains by hand.
model EmployeeLoan {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  reference String?

  principalAmount Decimal @db.Decimal(14, 2)
  currency        String  @db.Char(3)

  installmentCount Int
  /// What is taken each month. Held rather than derived because the last
  /// installment usually differs by a few cents and the schedule carries the
  /// exact figures.
  monthlyDeduction Decimal @db.Decimal(14, 2)

  /// The month the first deduction falls in, pinned to the first of the month.
  startMonth DateTime @db.Date

  status EmployeeLoanStatus @default(PENDING)

  purpose String?
  notes   String?

  /// Set when an employee applied for it rather than HR creating it outright.
  requestedByUserId String?
  requestedAt       DateTime?
  approvalRequestId String?   @unique

  approvedByUserId String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?

  /// When repayment actually began, i.e. when the loan went ACTIVE.
  activatedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  installments EmployeeLoanInstallment[]

  @@index([companyId, status])
  @@index([employeeId, status])
  @@map("employee_loans")
}

/// One scheduled repayment.
///
/// The payment history and the outstanding balance are both this table read
/// two ways, which is why neither is stored on the loan: a running total that
/// is maintained separately is a running total that eventually disagrees.
model EmployeeLoanInstallment {
  id         String @id @default(cuid())
  companyId  String
  loanId     String
  employeeId String

  /// 1-based position in the schedule.
  sequence Int
  /// The month this installment belongs to, pinned to the first of the month.
  dueMonth DateTime @db.Date

  amount Decimal @db.Decimal(14, 2)

  status LoanInstallmentStatus @default(SCHEDULED)

  /// The run that collected it. Cleared when a run is recalculated or
  /// cancelled, exactly as PayrollAdjustment.appliedRunId is.
  payrollRunId String?
  paidAt       DateTime?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loan     EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  run      PayrollRun?  @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@unique([loanId, sequence])
  @@index([employeeId, dueMonth])
  @@index([companyId, status, dueMonth])
  @@index([payrollRunId])
  @@map("employee_loan_installments")
}
