// ---------------------------------------------------------------------------
// HRMS data model
//
// Conventions
//  - cuid primary keys, createdAt/updatedAt on every table
//  - companyId on every business table from day one, so a second company is a
//    feature flag rather than a migration nightmare
//  - User (login account) is deliberately separate from Employee (HR record):
//    not every employee gets a login, and not every login is an employee
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------- enums

enum UserStatus {
  /// Created but has never set a password. Cannot sign in; the only thing an
  /// invited account may do is complete a password reset, which activates it.
  INVITED
  ACTIVE
  SUSPENDED
}

/// Why an account is suspended.
///
/// The distinction is the whole point: an account switched off because the
/// person left may be switched back on when they return, and an account
/// switched off because of a security concern may not. Without recording
/// which, reactivating an employee would silently undo a deliberate lock.
enum UserSuspensionReason {
  /// Suspended automatically because the employee was terminated.
  EMPLOYMENT_TERMINATED
  /// Suspended deliberately by an administrator, for any other reason.
  ADMINISTRATIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  /// Employed but not currently working and not on a recorded leave: a
  /// sabbatical, a long unpaid break, a record parked pending paperwork.
  /// Distinct from SUSPENDED, which is a disciplinary state, and from
  /// TERMINATED, which ends the employment.
  INACTIVE
  /// Left of their own accord. Kept apart from TERMINATED because who ended
  /// the employment is a fact people ask about, and because a resignation
  /// carries a resignation date of its own alongside the last working day.
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

/// What stage an employee's employment has reached.
///
/// Three questions the record already had to answer separately, and this is the
/// third of them. EmployeeStatus says whether somebody is employed at all;
/// EmploymentType says on what terms - hours, contract, headcount; this says how
/// far through the arrangement they are. A part-time permanent employee and a
/// full-time probationer are both ordinary, and no pair of the other two enums
/// can express either one.
///
/// Replaces the free-text `confirmationStatus` the payroll roster was imported
/// into. Same question, same column, now a closed set - so "Probation",
/// "probation" and "PROBATION" can no longer be three different answers, and
/// the loan and medical engines read one canonical value instead of matching
/// strings. Nullable on purpose: a record nobody has classified yet says
/// nothing, which is different from saying "permanent".
enum EmploymentStatus {
  /// Serving an initial period; not yet confirmed.
  PROBATION
  /// Confirmed in post. Normally carries a confirmationDate.
  PERMANENT
  /// On an internship. Deliberately NOT EmploymentType.INTERN, which describes
  /// the contract; a company may run interns on any employment type.
  INTERNEE
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// How much data a role reaches. Orthogonal to permissions: a permission says
/// which operation is allowed, the scope says which records it applies to.
enum DataScope {
  NONE
  OWN
  REPORTS
  REPORTS_AND_OWN
  DEPARTMENT
  ALL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

// ------------------------------------------------------------------- company

model Company {
  id           String  @id @default(cuid())
  name         String
  legalName    String?
  email        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  /// Prefix for auto-generated employee numbers, e.g. "EMP-" -> EMP-0007.
  employeeNumberPrefix String @default("EMP-")

  // Localisation defaults inherited by every module added later
  timezone     String    @default("UTC")
  currency     String    @default("USD") @db.Char(3)
  dateFormat   String    @default("dd MMM yyyy")
  weekStartsOn WeekDay   @default(MONDAY)
  /// Non-working days of the week. Data-driven so a Sunday-to-Thursday working
  /// week is configuration, not a code change.
  weekendDays  WeekDay[] @default([SATURDAY, SUNDAY])

  // --- attendance policy (phase 5) ---------------------------------------
  // Every threshold below is configuration. Nothing in the attendance
  // calculation may hard-code a number that appears here.

  /// Lateness forgiven entirely at or below this many minutes past shift start.
  graceMinutes            Int     @default(10)
  /// Worked minutes at or above this - but below fullDayMinutes - earn a half day.
  halfDayMinutes          Int     @default(240)
  /// Worked minutes at or above this earn a full present day.
  fullDayMinutes          Int     @default(480)
  /// Leaving early is forgiven at or below this many minutes before shift end.
  earlyLeaveGraceMinutes  Int     @default(10)
  overtimeEnabled         Boolean @default(true)
  /// Worked minutes beyond this count as overtime. Not additional time - a
  /// labelled portion of workedMinutes, so the two are never double-counted.
  overtimeAfterMinutes    Int     @default(480)
  /// Ceiling on overtime credited in one day, so a forgotten check-out cannot
  /// silently book 14 hours of overtime.
  overtimeDailyCapMinutes Int     @default(240)

  // --- attendance rules -----------------------------------------------------
  // The shift window an employee is measured against, and how the day either
  // side of it is scored. Defaults reproduce the confirmed office policy:
  // 09:00-18:00 with the break inside the window, overtime only after the
  // shift ends, and early arrival never earning any.

  /// Fallback shift window for an employee with no assignment. An assigned
  /// shift always wins; this is only the floor beneath it.
  defaultShiftStart String @default("09:00")
  defaultShiftEnd   String @default("18:00")

  /// Overtime measured from the applicable shift end rather than from a
  /// duration threshold. False restores the legacy behaviour, where anything
  /// past overtimeAfterMinutes of elapsed presence counted - which charges the
  /// unpaid break to the company on every ordinary day.
  overtimeFromShiftEnd         Boolean @default(true)
  /// Whether arriving before shift start earns overtime. Off: turning up early
  /// is not overtime.
  overtimeCountsEarlyArrival   Boolean @default(false)
  /// Whether arriving late is deducted from the overtime earned after shift
  /// end. Off: lateness and overtime are independent facts about the day.
  overtimeReducedByLateArrival Boolean @default(false)

  /// Whether lateness against shift start is measured at all.
  lateTrackingEnabled           Boolean @default(true)
  /// Whether leaving before shift end is measured at all.
  earlyDepartureTrackingEnabled Boolean @default(true)
  /// How far short of a full day someone may fall and still be credited one.
  ///
  /// Distinct from earlyLeaveGraceMinutes, which decides whether an early
  /// departure is RECORDED. This decides whether it costs them the day. Leaving
  /// half an hour early is worth reporting and not worth downgrading a day
  /// over, and the two thresholds are set independently because they answer
  /// different questions.
  fullDayToleranceMinutes       Int     @default(30)

  /// A check-in later than the cutoff makes the day irregular: it does not fit
  /// the shift it would otherwise be scored against, so no overtime is derived
  /// from it rather than crediting the whole evening.
  irregularCheckInEnabled         Boolean             @default(true)
  irregularCheckInCutoff          String              @default("11:00")
  irregularCheckInMode            IrregularCutoffMode @default(ABSOLUTE_TIME)
  /// Used when the mode is AFTER_SHIFT_START. 120 is the same distance the
  /// default 09:00 shift and 11:00 cutoff already express.
  irregularAfterShiftStartMinutes Int                 @default(120)

  /// Whether the break sits inside the shift window. True: the window already
  /// accounts for it and nothing is subtracted. False: the shift's break is
  /// deducted from the day before it is scored.
  breakIncludedInWindow Boolean @default(true)

  /// Overtime shorter than this is not credited at all, so a two-minute
  /// overrun does not become a payable figure. Zero credits every minute.
  overtimeMinimumMinutes    Int  @default(0)
  /// Credited overtime is rounded down to a multiple of this. Zero is no
  /// rounding.
  overtimeRoundingMinutes   Int  @default(0)
  /// Ceilings across a week and a month, applied after the daily cap. Null is
  /// no ceiling at that level.
  overtimeWeeklyCapMinutes  Int?
  overtimeMonthlyCapMinutes Int?

  /// What a day with a check-in and no check-out is worth, and what a day with
  /// neither is worth. Held as configuration because "still present" and
  /// "absent until corrected" are both defensible answers and the choice
  /// belongs to the company, not to this code.
  missingCheckOutStatus AttendanceMissingPunchRule @default(PRESENT)
  missingCheckInStatus  AttendanceMissingPunchRule @default(ABSENT)

  // --- punch integrity ----------------------------------------------------
  // What makes a day's punches trustworthy enough to derive hours from. These
  // exist because a terminal reports events, not intent: it will happily
  // record the same badge twice in a second, or a single stray evening swipe
  // that turns an ordinary day into fourteen hours. Both are configuration
  // rather than constants, because "how long is an implausible day?" is a
  // question about how this company works and has no universal answer.

  /// Two punches closer together than this are the same event seen twice, and
  /// the later one is ignored when pairing. Zero switches the collapsing off
  /// and takes every punch at face value.
  duplicatePunchWindowSeconds Int @default(60)

  /// The longest span between the first and last punch that is still believed.
  /// Beyond it the day is reported as irregular with no hours rather than
  /// crediting a figure nobody worked; the punches are untouched and the day
  /// stays visible for correction. Zero switches the check off.
  maxPlausibleSpanMinutes Int @default(960)

  /// Whether a day whose span exceeds the bound is scored on its punches
  /// anyway. Off by default: fabricating hours is the failure this prevents.
  /// On, it restores the previous behaviour for a company that wants it.
  allowImplausibleSpans Boolean @default(false)

  // --- the day that ends after midnight ------------------------------------
  // Somebody who stays until one in the morning punches out on a date that is
  // not the date they worked. Read literally, that punch opens a new day: the
  // long day is left with an arrival and no departure and earns nothing, and
  // the next day is scored from a 01:00 "arrival" it never had. Both halves
  // are wrong, and the evening's overtime is the part that costs somebody
  // money.
  //
  // The rule is deliberately conditional rather than a moved midnight. A fixed
  // cutoff cannot tell a late departure from an early arrival, so this asks
  // the only question that can: is the previous day still open?

  /// How long after a day's first punch a later punch can still be read as
  /// that day's departure. Zero switches the rule off entirely and restores
  /// reading every post-midnight punch as a fresh arrival.
  ///
  /// It is a span rather than an hour of the clock because the question is
  /// "how long can one working day be?", which is about this company, and a
  /// day that started at 09:00 and one that started at 14:00 do not stop
  /// being one day at the same moment.
  ///
  /// Deliberately longer than `maxPlausibleSpanMinutes`: this decides which
  /// day a punch belongs to, that decides whether the resulting day is
  /// believable. A day can be attributed correctly and still be too long to
  /// score, and the two answers are better given separately.
  overnightCheckOutWindowMinutes Int @default(1080)

  /// The latest local time at which a punch can still close the previous day.
  /// After it, a punch is an arrival however open yesterday looks - the guard
  /// that stops a forgotten departure being closed by the next morning's
  /// arrival, turning two days into one.
  overnightCheckOutCutoff String @default("06:00")

  // --- attendance module (step 1) ----------------------------------------
  // Flags and non-working-day behaviour. Defaults reproduce what the engine
  // did before these existed, so nothing derived changes until Super Admin
  // changes a setting.

  /// Break length assumed for the default schedule when no shift is assigned.
  /// Only subtracted when breakIncludedInWindow is false.
  defaultBreakMinutes Int @default(0)

  /// Lateness at or above this many minutes carries the LATE flag. Zero flags
  /// any lateness the grace period did not forgive. Grace decides what is
  /// recorded; this decides what is reported as a late day.
  lateThresholdMinutes       Int @default(0)
  /// Same rule for leaving early.
  earlyLeaveThresholdMinutes Int @default(0)

  /// What time worked on a weekend or holiday is worth.
  weekendWorkRule NonWorkingDayWorkRule @default(AS_WORKING_DAY)
  holidayWorkRule NonWorkingDayWorkRule @default(AS_WORKING_DAY)

  // --- check-in location restriction (phase 5) ----------------------------
  /// Off by default: existing companies keep unrestricted check-in.
  locationRestrictionEnabled Boolean  @default(false)
  /// Fallback radius for locations that do not set their own.
  defaultGeofenceRadiusM     Int      @default(200)
  /// Off by default: existing companies keep unrestricted check-in.
  ipRestrictionEnabled       Boolean  @default(false)
  /// Networks permitted to check in, as CIDR blocks or bare addresses. Empty
  /// while the restriction is on means nothing is permitted - fail closed.
  allowedCheckInCidrs        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments  Department[]
  teams        Team[]
  designations Designation[]
  locations    Location[]
  employees    Employee[]
  users        User[]
  roles        Role[]
  auditLogs    AuditLog[]

  // --- phase 3 ---
  approvalRequests      ApprovalRequest[]
  notifications         Notification[]
  attendanceRecords     AttendanceRecord[]
  attendanceAdjustments AttendanceAdjustment[]
  regularizations       AttendanceRegularizationRequest[]
  shifts                Shift[]
  shiftAssignments      EmployeeShiftAssignment[]
  shiftChangeRequests   ShiftChangeRequest[]
  timesheets            Timesheet[]

  // --- phase 6 ---
  attendancePolicies          AttendancePolicy[]
  attendancePolicyAssignments AttendancePolicyAssignment[]

  // --- phase 7 ---
  attendanceDevices        AttendanceDevice[]
  attendanceDeviceMappings AttendanceDeviceUserMapping[]
  attendanceDeviceSyncs    AttendanceDeviceSync[]
  attendanceRawPunches     AttendanceRawPunch[]
  attendanceDeviceUsers    AttendanceDeviceEnrolledUser[]

  // --- phase 4 ---
  leaveTypes    LeaveType[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  holidays      Holiday[]

  // --- phase 9 ---
  payrollSettings          PayrollSettings?
  payrollProfiles          PayrollProfile[]
  employeeSalaries         EmployeeSalary[]
  salaryComponents         SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollPeriods           PayrollPeriod[]
  payrollRuns              PayrollRun[]
  payrollLines             PayrollLine[]
  payrollAdjustments       PayrollAdjustment[]
  payslips                 Payslip[]
  payrollExceptions        PayrollException[]

  // --- phase 10 ---
  links             CompanyLink[]
  employeeContracts EmployeeContract[]
  policies          CompanyPolicy[]
  policyAssignments EmployeePolicyAssignment[]
  salaryRevisions   SalaryRevision[]
  employeeLoans     EmployeeLoan[]
  loanInstallments  EmployeeLoanInstallment[]
  loanPolicies      LoanPolicy[]

  // --- phase 11 ---
  medicalPolicies   MedicalPolicy[]
  medicalDependents MedicalDependent[]
  medicalClaims     MedicalClaim[]

  // --- celebrations ---
  momentGreetings MomentGreeting[]

  // --- cases (helpdesk) ---
  caseCategories  CaseCategory[]
  cases           Case[]
  caseMessages    CaseMessage[]
  caseAttachments CaseAttachment[]

  // --- lunch ---
  lunchMenuItems  LunchMenuItem[]
  lunchOrders     LunchOrder[]
  lunchOrderItems LunchOrderItem[]

  // --- recruitment ---
  jobOpenings              JobOpening[]
  candidates               Candidate[]
  candidateApplications    CandidateApplication[]
  candidateDocuments       CandidateDocument[]
  interviews               Interview[]
  interviewParticipants    InterviewParticipant[]
  interviewEvaluations     InterviewEvaluation[]
  interviewScheduleChanges InterviewScheduleChange[]
  offers                   Offer[]

  // --- assets ---
  assetCategories  AssetCategory[]
  assets           Asset[]
  assetAssignments AssetAssignment[]
  assetRepairs     AssetRepair[]
  assetIncidents   AssetIncident[]
  assetDocuments   AssetDocument[]

  // --- organisation hierarchy and multi-level approvals ---
  teamManagers           TeamManager[]
  approvalWorkflows      ApprovalWorkflow[]
  approvalStageAssignees ApprovalStageAssignee[]
  assetRequests          AssetRequest[]
  assetRequestItems      AssetRequestItem[]

  @@map("companies")
}

// -------------------------------------------------------------- organisation

model Department {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true)

  // Optional org-chart head. Named relation keeps it distinct from employees.
  headEmployeeId String?   @unique
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  // Self-hierarchy. Cycles are prevented in the service layer, not the database.
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams     Team[]
  employees Employee[] @relation("EmployeeDepartment")

  /// The helpdesk queues filed under this department, and the cases in them.
  /// A department is never copied into the cases module - it is pointed at.
  caseCategories CaseCategory[]
  cases          Case[]

  /// Recruitment. A job opening is filed against a real department for the
  /// same reason a case is: so "Development is hiring two people" is a query
  /// rather than a string comparison.
  jobOpenings JobOpening[]

  /// The assets that BELONG to this department - not the ones its people
  /// happen to be holding. A projector belongs to Facilities whether or not
  /// anybody has signed it out.
  assets Asset[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([parentDepartmentId])
  @@map("departments")
}

/// Job title as a lookup record rather than free text, so reporting and
/// filtering stay consistent across the organisation.
model Designation {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  /// What a candidate is being offered. Pointed at rather than copied, so a
  /// conversion hands the employee record the same designation row HR chose.
  offers Offer[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("designations")
}

/// Physical work location. Holiday calendars, shifts and attendance policies
/// hang off this in later phases.
model Location {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  timezone     String?

  /// Geofence centre. Optional: a location without coordinates simply cannot
  /// be used to restrict check-in, which is reported rather than assumed.
  latitude             Float?
  longitude            Float?
  /// Overrides the company default radius for this site.
  geofenceRadiusMeters Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  holidays  Holiday[]
  devices   AttendanceDevice[]

  /// Where a vacancy is based.
  jobOpenings JobOpening[]

  /// The assets kept at this site.
  assets Asset[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("locations")
}

model Team {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)

  /**
   * LEGACY, and no longer part of the organisation model.
   * Teams used to be children of departments: this column was NOT NULL and the
   * only way to create a team was to name a department for it. That is not the
   * shape this company works in. Department and Team are two INDEPENDENT
   * dimensions - a person is in Development AND on Team Alpha, and Team Alpha
   * is not a sub-unit of Development. Somebody who wanted a team the old form
   * could not place ended up inventing a department to hold it, which is how
   * `T-A` and `Team Clan` came to be departments.
   * The column is kept, nullable, holding exactly what it held, so that this
   * release can be rolled back without losing the old association. NOTHING
   * READS IT: the API does not select it, the forms do not offer it, and the
   * team lookups no longer carry it. An employee's department comes from
   * `Employee.departmentId` and from nowhere else.
   */
  departmentId String?

  /**
   * SUPERSEDED by `TeamManager`, and left in place only so that rolling this
   * release back does not lose what it held.
   * It could never be the manager relationship this product needs: it is ONE
   * employee, and it is `@unique`, so a team could have a single lead and a
   * lead could hold a single team. A team has one to three managers and a
   * manager may run more than one team, which is two facts this column cannot
   * represent. The migration that introduced `team_managers` copied every lead
   * into it as an active manager, and nothing reads or writes this column any
   * more - the roster is the single source of truth for who runs a team.
   */
  leadEmployeeId String?   @unique
  leadEmployee   Employee? @relation("TeamLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]  @relation("EmployeeTeam")

  /// Which team the vacancy is for, where the department alone is too coarse.
  jobOpenings JobOpening[]

  /// Who runs this team. One to three active rows; see `TeamManager`.
  managers TeamManager[]

  /// Team names are unique per COMPANY now, not per department. They used to be
  /// unique per department, which let two departments each hold a "Platform"
  /// and made "which Platform?" a question the rest of the product could not
  /// answer once the department stopped being part of a team's identity.
  @@unique([companyId, name])
  @@index([companyId, isActive])
  /// Only so the legacy FK's ON DELETE SET NULL stays cheap. Nothing queries it.
  @@index([departmentId])
  @@map("teams")
}

/**
 * Who runs a team.
 * AN EXPLICIT ROW, and that is the entire point of the model. Nothing in this
 * product decides that somebody manages a team because their job title says
 * Manager, because they head the department the team sits in, because their
 * role is called MANAGER, or because their name appears above other names on
 * an org chart. A person manages a team when a row exists here saying so, and
 * an administrator put it there.
 * ONE TO THREE ACTIVE MANAGERS. The floor is advisory - a team whose only
 * manager resigns must be allowed to exist for the hour it takes HR to name a
 * replacement, and refusing the removal would leave the leaver in charge. The
 * CEILING IS ENFORCED, in the service layer, inside the transaction that
 * writes the row: a count of active rows for the team is taken and the insert
 * is refused at three. A partial unique index cannot express "at most three",
 * and Prisma cannot describe one in any case.
 * ACTIVE, NOT DELETED. Replacing a manager ends their row - `isActive` false,
 * `endedAt`, who ended it and why - and inserts the successor's. The history of
 * who ran a team is a thing companies are asked about, and a DELETE answers it
 * with silence. The same row also keeps an in-flight approval honest: a step
 * already routed to a departed manager still says who it was routed to.
 * AN INACTIVE EMPLOYEE CANNOT HOLD AN ACTIVE ROW. Enforced in the service
 * layer on the way in, and again by the resolver on the way out: an approval
 * stage never resolves to an employee whose status is not ACTIVE, whatever
 * this table says, so a manager who is terminated tonight cannot silently
 * become the reason nobody's leave can be approved tomorrow.
 */
model TeamManager {
  id         String @id @default(cuid())
  companyId  String
  teamId     String
  employeeId String

  isActive Boolean @default(true)

  assignedAt       DateTime  @default(now())
  assignedByUserId String?
  endedAt          DateTime?
  endedByUserId    String?
  /// Why the row was ended - "left the company", "moved to Design". Free text,
  /// because the reasons are not a closed set and a wrong enum value is worse
  /// than a sentence somebody wrote.
  endReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endedBy  Employee? @relation("TeamManagerEndedBy", fields: [endedByEmployeeId], references: [id], onDelete: SetNull)

  /// Who ended the appointment, as an employee rather than a user, so the name
  /// survives the account being deleted.
  endedByEmployeeId String?

  /// One row per person per team. Re-appointing somebody reactivates the row
  /// they already have rather than writing a second one, so the pair stays
  /// unique and the history stays on one row.
  @@unique([teamId, employeeId])
  @@index([companyId, employeeId, isActive])
  @@index([teamId, isActive])
  @@map("team_managers")
}

model Employee {
  id             String @id @default(cuid())
  companyId      String
  employeeNumber String

  // --- identity -------------------------------------------------------------
  firstName     String
  middleName    String?
  lastName      String
  displayName   String?
  workEmail     String?
  personalEmail String?
  phone         String?
  personalPhone String?
  /**
   * A link to a photograph hosted somewhere else, as typed into the record.
   * Kept exactly as it was. It is the fallback the avatar falls back TO: an
   * uploaded photo takes precedence, and nothing in the upload path ever
   * writes this column - so a company that had been pasting links keeps them,
   * and removing an uploaded photo reveals the link again rather than losing it.
   */
  photoUrl      String?

  // --- profile photo (uploaded) ---------------------------------------------
  // The file itself lives in the object store, not here. Three columns is what
  // it takes to serve one back without a second lookup: which object, what it
  // is, and when it last changed - the last of which is the ETag and the
  // cache-buster. Deliberately NOT the bytes: an employee list would otherwise
  // drag several megabytes of image through every query that selects a row.

  /// Object-store key, e.g. `employee-photos/<companyId>/<employeeId>/<uuid>.jpg`.
  /// Never a filesystem path, and never sent to a browser.
  photoObjectKey   String?
  /// The image format, as sniffed from the file's own header on upload.
  photoContentType String?
  /// When the current photo was stored. Serves as the ETag and the `?v=` on the
  /// URL, so a replaced photo is picked up by an <img> already on screen.
  photoUpdatedAt   DateTime?

  /// Father's name, as carried by the payroll roster this record was imported
  /// from. Kept distinct from middleName: it is a separate person, not part of
  /// this employee's own name.
  fatherName String?

  // --- job ------------------------------------------------------------------
  /// Retained alongside designationId as a free-text fallback for imported
  /// records whose title does not yet map to a Designation.
  jobTitle           String?
  designationId      String?
  departmentId       String?
  teamId             String?
  locationId         String?
  managerId          String?
  /// Dual reporting - a second manager for matrix organisations.
  secondaryManagerId String?

  employmentType         EmploymentType    @default(FULL_TIME)
  status                 EmployeeStatus    @default(ACTIVE)
  /**
   * The employment stage: probation, permanent, or an internship.
   * The canonical field, and the ONLY one. Loans and medical both read this
   * column rather than keeping a probation flag of their own, which is what
   * stops the two benefits disagreeing about the same person.
   * Null means unclassified, and is left alone rather than guessed at. The
   * eligibility engines treat null as "this rule has nothing to say", exactly
   * as they already treat a missing confirmation date - refusing a benefit on
   * the strength of a field nobody filled in would be a worse answer than
   * having no answer.
   * Renamed from `confirmationStatus`, which held the roster's own wording.
   */
  employmentStatus       EmploymentStatus?
  hireDate               DateTime?         @db.Date
  /// The day a probationer was confirmed. Set alongside employmentStatus when
  /// it moves to PERMANENT; the two are written together and never apart.
  confirmationDate       DateTime?         @db.Date
  terminationDate        DateTime?         @db.Date
  /// The day the employee handed in their resignation. Set when the status is
  /// RESIGNED. Deliberately separate from terminationDate, which is the last
  /// day worked - the two are rarely the same and payroll reads the latter.
  resignationDate        DateTime?         @db.Date
  sourceOfHire           String?
  linkedinUrl            String?
  /// When the next salary increment falls due, as the payroll roster tracks it.
  /// Forward-looking, which is what keeps it off SalaryRevision: that model
  /// records increments that happened, this records one that is owed.
  nextIncrementDueDate   DateTime?         @db.Date
  /// Prior experience in whole months, kept as a number so it can be summed.
  priorExperienceMonths  Int?
  /**
   * Whether this person is counted by attendance at all.
   * A partner or director who never punches is not "absent" on a day they did
   * not punch - they are outside the question. Without this, the nightly
   * absence job records an ABSENT row for them every working day, and the
   * attendance sheet, reports and analytics all carry a person whose row can
   * only ever be wrong.
   * Deliberately NOT a status: they are an ACTIVE employee for every other
   * purpose - the org chart, approvals, assets, leave. This excludes them from
   * one subsystem, so it is read by `attendancePopulationWhere` and nowhere
   * else.
   */
  excludedFromAttendance Boolean           @default(false)

  // --- personal -------------------------------------------------------------
  dateOfBirth   DateTime?      @db.Date
  gender        Gender?
  maritalStatus MaritalStatus?
  nationality   String?
  bloodGroup    String?
  placeOfBirth  String?
  religion      String?

  presentAddress   String?
  permanentAddress String?
  /// Structured address parts, imported alongside the free-text address above
  /// rather than parsed out of it, because the roster supplies them separately.
  addressCity      String?
  addressProvince  String?
  addressState     String?
  addressCountry   String?
  addressZipCode   String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // --- restricted ------------------------------------------------------------
  // Readable only with employee.sensitive.read. Field-level enforcement and
  // read-auditing land in phase 8; until then the API strips these from
  // responses for callers without that permission.
  nationalId        String?
  /// Issue and expiry of the national identity document above (CNIC / Emirates
  /// ID). Separate from the passport dates: they are different documents.
  nationalIdIssued  DateTime? @db.Date
  nationalIdExpiry  DateTime? @db.Date
  passportNumber    String?
  passportExpiry    DateTime? @db.Date
  visaNumber        String?
  visaExpiry        DateTime? @db.Date
  bankAccountNumber String?
  bankAccountTitle  String?
  bankName          String?

  // --- roster attributes (imported) ----------------------------------------
  // Values carried by the payroll roster that have no behavioural meaning here
  // yet. Held as supplied so the import is lossless and nothing has to be
  // re-keyed when a feature does start reading them.

  /// Site grouping as the roster labels it. Parallel to locationId, which is
  /// the HRMS's own record - this is the source system's wording, kept verbatim.
  area                     String?
  employeeGroup            String?
  /// Outsourcing arrangement, where the roster records one.
  vendor                   String?
  familyCode               String?
  expectedConfirmationDays Int?
  /// Access template named by the roster. Not a Role: nothing reads it, and
  /// mapping it onto one would grant permissions the import never intended.
  roleTemplate             String?
  allowManualAttendance    Boolean?
  allowEmployeeLogin       Boolean?

  notes String?

  // Optional link to a login account (1:1)
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department?                   @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  team             Team?                         @relation("EmployeeTeam", fields: [teamId], references: [id], onDelete: SetNull)
  designation      Designation?                  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location         Location?                     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  deviceMappings   AttendanceDeviceUserMapping[]
  rawPunches       AttendanceRawPunch[]
  manager          Employee?                     @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          Employee[]                    @relation("EmployeeManager")
  secondaryManager Employee?                     @relation("EmployeeSecondaryManager", fields: [secondaryManagerId], references: [id], onDelete: SetNull)
  secondaryReports Employee[]                    @relation("EmployeeSecondaryManager")
  user             User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)

  workExperience EmployeeWorkExperience[]
  education      EmployeeEducation[]

  headOfDepartment Department? @relation("DepartmentHead")
  leadOfTeam       Team?       @relation("TeamLead")

  // --- phase 3 ---
  approvalRequests      ApprovalRequest[]                 @relation("ApprovalRequester")
  approvalSteps         ApprovalStep[]                    @relation("ApprovalApprover")
  attendanceRecords     AttendanceRecord[]
  attendanceAdjustments AttendanceAdjustment[]
  regularizations       AttendanceRegularizationRequest[]
  shiftAssignments      EmployeeShiftAssignment[]
  shiftChangeRequests   ShiftChangeRequest[]
  timesheets            Timesheet[]

  // --- phase 4 ---
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  // --- phase 9 ---
  payrollProfile     PayrollProfile?
  salaries           EmployeeSalary[]
  salaryComponents   EmployeeSalaryComponent[]
  payrollLines       PayrollLine[]
  payrollAdjustments PayrollAdjustment[]
  payslips           Payslip[]

  // --- phase 10: contracts, policies, salary revisions and loans ---
  contracts         EmployeeContract[]
  policyAssignments EmployeePolicyAssignment[]
  salaryRevisions   SalaryRevision[]
  loans             EmployeeLoan[]
  loanInstallments  EmployeeLoanInstallment[]

  // --- phase 11: medical ---
  medicalDependents MedicalDependent[]
  medicalClaims     MedicalClaim[]

  /// HR's per-employee answer to "is the medical benefit theirs", over the
  /// policy's. Null follows the policy. ELIGIBLE covers somebody the policy's
  /// personal rules would refuse (service, probation, employment stage);
  /// NOT_ELIGIBLE refuses somebody it would cover. Neither reaches past the
  /// benefit being switched off company-wide, or a parked or ended record.
  medicalEligibilityOverride MedicalEligibilityOverride?
  /// This employee's own annual limit, in place of the policy's. Null: the
  /// policy's limit applies.
  medicalAnnualLimitOverride Decimal?                    @db.Decimal(14, 2)
  /// Why the override was made. Required by the API whenever one is set.
  medicalOverrideNote        String?

  // --- celebrations ---
  greetingsReceived MomentGreeting[] @relation("MomentGreetingRecipient")
  greetingsSent     MomentGreeting[] @relation("MomentGreetingSender")

  // --- cases (helpdesk) ---
  casesRaised Case[] @relation("CaseRequester")

  // --- lunch ---
  lunchOrders LunchOrder[]

  // --- recruitment ---
  // Employees appear in recruitment as the people DOING the hiring, never as
  // the people being hired: a candidate is a separate record until the moment
  // HR converts one, and `hiredFromCandidate` below is that single link back.
  jobOpeningsManaged   JobOpening[]           @relation("JobOpeningHiringManager")
  jobOpeningsRecruited JobOpening[]           @relation("JobOpeningRecruiter")
  candidatesRecruited  Candidate[]            @relation("CandidateRecruiter")
  interviewsScheduled  Interview[]            @relation("InterviewScheduledBy")
  interviewSeats       InterviewParticipant[]
  /// The candidate record this employee was created from, if any. Set once, by
  /// Convert to Employee, and never by anything else.
  hiredFromCandidate   Candidate?             @relation("CandidateHiredEmployee")

  // --- assets ---
  /// Every spell this person has had of holding company equipment, including
  /// the ones that ended. Restrict on the assignment side: an employee who has
  /// ever been issued an asset cannot be deleted out from under that history.
  assetAssignments AssetAssignment[]
  /// Problems this person reported with an asset they were holding.
  assetIncidents   AssetIncident[]   @relation("AssetIncidentEmployee")
  /// Disposals this person signed off.
  assetDisposals   Asset[]           @relation("AssetDisposalApprover")

  // --- organisation hierarchy and multi-level approvals ---
  /// The teams this person manages, past and present. See `TeamManager`.
  teamManagerships   TeamManager[]
  /// Company-wide approval seats held by this person - HR Manager, CEO.
  approvalStageSeats ApprovalStageAssignee[]
  /// Every approval step this person is one of the named approvers on. The
  /// step's `approverEmployeeId` is a display convenience; THIS is authority.
  approvalStepSeats  ApprovalStepApprover[]
  /// Equipment this person has asked for.
  assetRequests      AssetRequest[]
  /// Team-manager rows this person ended, and asset requests they decided on
  /// behalf of the register. Both nullable on the other side.
  teamManagersEnded  TeamManager[]           @relation("TeamManagerEndedBy")

  @@unique([companyId, employeeNumber])
  @@index([companyId, status])
  @@index([companyId, employmentStatus])
  @@index([companyId, departmentId])
  @@index([companyId, designationId])
  @@index([companyId, locationId])
  @@index([companyId, excludedFromAttendance])
  @@index([managerId])
  @@index([lastName, firstName])
  @@map("employees")
}

/// Repeating sub-record: employment history before joining this company.
model EmployeeWorkExperience {
  id         String @id @default(cuid())
  employeeId String

  companyName String
  jobTitle    String?
  fromDate    DateTime? @db.Date
  toDate      DateTime? @db.Date
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_work_experience")
}

/// Repeating sub-record: a qualification the employee holds.
///
/// Separate rows rather than columns on Employee because a person may hold any
/// number of qualifications, and the roster this was imported from already
/// carries two tiers with room for more.
model EmployeeEducation {
  id         String @id @default(cuid())
  employeeId String

  /// "Bachelors", "Masters" and so on, as the source records it. Free text
  /// rather than an enum: qualification systems differ by country and an enum
  /// would force the import to discard anything it did not anticipate.
  level         String
  degree        String?
  institution   String?
  /// Year of completion. An Int, not a date: the roster records only the year.
  yearCompleted Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_education")
}

// ---------------------------------------------------------------- auth & rbac

model User {
  id        String @id @default(cuid())
  companyId String

  email        String
  passwordHash String
  firstName    String
  lastName     String

  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)

  /// Set while suspended, cleared on restore. Null on an account that has never
  /// been suspended.
  suspendedReason        UserSuspensionReason?
  suspendedAt            DateTime?
  /// The user who suspended this account. Null when the system did it.
  suspendedById          String?
  /// What the status was before suspension, so restoring puts it back rather
  /// than assuming everyone was ACTIVE. An invited account that never signed in
  /// returns to INVITED, not to a working login it never had.
  statusBeforeSuspension UserStatus?

  // Deterministic avatar tint so the UI needs no uploaded images yet
  avatarColor String @default("#3f6cd6")

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              Employee?
  userRoles             UserRole[]
  sessions              Session[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  attendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustmentActor")

  /// Who suspended this account, when an administrator did.
  suspendedBy    User?  @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers User[] @relation("UserSuspendedBy")

  // --- phase 3 ---
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  // --- cases (helpdesk) ---
  casesAssigned    Case[]           @relation("CaseAssignee")
  caseMessagesSent CaseMessage[]    @relation("CaseMessageSender")
  caseAttachments  CaseAttachment[] @relation("CaseAttachmentUploader")

  // --- recruitment ---
  candidateDocuments CandidateDocument[] @relation("CandidateDocumentUploader")

  // --- lunch ---
  /// Orders this account recorded the payment for. The office boy's own trail.
  lunchPaymentsTaken   LunchOrder[] @relation("LunchOrderPaidBy")
  lunchOrdersCancelled LunchOrder[] @relation("LunchOrderCancelledBy")
  lunchRefundsRecorded LunchOrder[] @relation("LunchOrderRefundedBy")

  // --- assets ---
  /// The handovers this account performed. The storekeeper's own trail.
  assetsIssued           AssetAssignment[] @relation("AssetAssignedBy")
  assetsReceived         AssetAssignment[] @relation("AssetReturnedBy")
  assetsAcknowledged     AssetAssignment[] @relation("AssetAcknowledgedBy")
  assetRepairsSent       AssetRepair[]     @relation("AssetRepairSentBy")
  assetRepairsCompleted  AssetRepair[]     @relation("AssetRepairCompletedBy")
  assetIncidentsFiled    AssetIncident[]   @relation("AssetIncidentReportedBy")
  assetIncidentsResolved AssetIncident[]   @relation("AssetIncidentResolvedBy")
  assetDocumentsUploaded AssetDocument[]   @relation("AssetDocumentUploader")

  @@unique([email])
  @@index([companyId, status])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?

  /// How far this role can see. Narrows every list query and record fetch,
  /// independently of which permissions the role holds.
  dataScope DataScope @default(OWN)

  /// Seeded by the system - cannot be deleted.
  isSystem Boolean @default(false)

  /// SUPER_ADMIN - permissions cannot be edited away, which prevents lock-out.
  isProtected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  groupKey    String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Server-side session. The cookie carries an opaque token; only its SHA-256
/// hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// --------------------------------------------------------------------- audit

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  actorId   String?

  /// Dotted verb, e.g. auth.login, company.update, role.permissions.update
  action     String
  entityType String
  entityId   String?
  summary    String?

  /// Field-level diff. Secrets are redacted before they reach here.
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ===========================================================================
// PHASE 3 - approvals, notifications, and the time-tracking foundation
// ===========================================================================

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Which domain record an approval is about. The engine stays generic: it
/// never imports the domain modules, it only stores the pair
/// (subjectType, subjectId) and lets each module resolve its own record.
enum ApprovalSubjectType {
  ATTENDANCE_REGULARIZATION
  SHIFT_CHANGE
  TIMESHEET
  LEAVE_REQUEST
  /// An employee asking for a salary advance or loan. Same engine as every
  /// other request; the loan record is the subject.
  LOAN_REQUEST
  /// An employee asking for equipment - a laptop, a monitor, a headset. The
  /// chain agrees to the request; ISSUING the kit is a separate act by the
  /// asset manager, and the engine has nothing to do with it.
  ASSET_REQUEST
}

/**
 * Which rung of the organisation fills an approval stage.
 * A stage is a JOB, not a person. `TEAM_MANAGER` resolves, at submission time,
 * to the active managers of the requester's own team; `HR_MANAGER` and `CEO`
 * resolve to the people a company has explicitly named in
 * `ApprovalStageAssignee`. Neither is ever inferred from a job title, a
 * designation, a department name or a role name - inference is exactly how an
 * approval chain comes to route a request to somebody who happens to be called
 * "Manager, Facilities".
 * `LINE_MANAGER` and `DEPARTMENT_HEAD` are the chain this product had before
 * stages existed - the requester's own `managerId`, then their department head.
 * They are kept because attendance corrections, shift changes, timesheets and
 * loans still use them, and because they are the fallback when a company has
 * configured no hierarchy at all.
 */
enum ApprovalStage {
  TEAM_MANAGER
  HR_MANAGER
  CEO
  LINE_MANAGER
  DEPARTMENT_HEAD
}

/// How many of a stage's approvers have to agree before the stage is done.
enum ApprovalStageMode {
  /// The first decision carries the stage. The default, and what a team with
  /// three managers wants: any one of them may sign, and once one has, the
  /// other two see a completed stage rather than a second button.
  ANY_ONE
  /// Every named approver must approve. One rejection still ends the request.
  ALL
}

enum NotificationType {
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_CANCELLED
  PASSWORD_RESET
  SYSTEM
  /// A colleague greeted you on your birthday, work anniversary or first week.
  CELEBRATION
  /// Something happened on a helpdesk case you raised: it was received, it
  /// moved, or somebody replied. Its own type rather than SYSTEM so the
  /// inbox can group it and a company can mute it without muting everything.
  CASE_UPDATE
  /// You have been put on an interview panel.
  INTERVIEW_SCHEDULED
  /// An interview you are on has moved. Carries both times in its message,
  /// because "it moved" without saying from what is the one thing an
  /// interviewer cannot act on.
  INTERVIEW_RESCHEDULED
  /// An interview you are on is off.
  INTERVIEW_CANCELLED
  /// An interview you are on is coming up.
  INTERVIEW_REMINDER
  /// An interview you sat on is over and your evaluation has not been filed.
  INTERVIEW_EVALUATION_PENDING
}

enum AttendanceStatus {
  PRESENT
  /// Worked at least halfDayMinutes but less than fullDayMinutes.
  HALF_DAY
  ABSENT
  ON_LEAVE
  WEEKEND
  HOLIDAY
}

enum AttendanceSource {
  SELF
  SYSTEM
  ADMIN
  /// Derived from punches captured by a physical attendance terminal.
  DEVICE
}

/// Where the person worked from. Recorded at check-in.
/// What a day with a punch missing on one end is worth.
/// How the irregular-arrival cutoff is expressed.
enum IrregularCutoffMode {
  /// A wall-clock time, e.g. 11:00. Right for one shared office schedule.
  ABSOLUTE_TIME
  /// Minutes past the employee's own shift start. The only form that works
  /// when different people start at different times.
  AFTER_SHIFT_START
}

enum AttendanceMissingPunchRule {
  /// Counted present. The day is still running, or somebody forgot.
  PRESENT
  /// Counted absent until a correction is approved.
  ABSENT
  /// Scored on the elapsed thresholds like any other day.
  THRESHOLD
}

enum AttendanceMode {
  OFFICE
  REMOTE
}

/// What time worked on a non-working day is worth.
enum NonWorkingDayWorkRule {
  /// Scored by the ordinary rules: overtime after the shift end, and any
  /// overtime flows to payroll at the non-working-day multiplier. The
  /// behaviour in force before the rule existed.
  AS_WORKING_DAY
  /// Every worked minute is overtime, up to the daily cap.
  ALL_OVERTIME
  /// The punches are kept and shown; nothing is credited.
  IGNORE
}

/// Why an attendance adjustment was written.
enum AttendanceAdjustmentKind {
  /// A person corrected a processed day.
  CORRECTION
  /// A PunchCode mapping changed and punches were re-attributed.
  MAPPING_CHANGE
}

/// A reported property of a day, alongside its status. A late day is still a
/// present day; the flag says what else was true about it.
enum AttendanceFlag {
  LATE
  EARLY_LEAVE
  OVERTIME
  MISSING_PUNCH
  IRREGULAR
  MANUAL
}

/// What an employee says went wrong with a day they are asking to have
/// corrected.
///
/// Kept beside the requested times rather than inferred from them: "I forgot
/// to scan out" and "the terminal wrote the wrong time" both arrive as a
/// requested check-out, and the reviewer deciding between them should be
/// reading the complaint that was actually made.
enum AttendanceCorrectionIssue {
  /// A punch never reached the system at all.
  MISSING_PUNCH
  INCORRECT_CHECK_IN
  INCORRECT_CHECK_OUT
  /// Anything the times cannot express. The reason carries it.
  OTHER
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------ approvals

/// One approval request, whatever it is about.
model ApprovalRequest {
  id        String @id @default(cuid())
  companyId String

  subjectType ApprovalSubjectType
  /// Id of the domain record. Deliberately not a foreign key - the engine is
  /// shared by several tables and must not depend on any of them.
  subjectId   String

  requesterEmployeeId String
  requesterUserId     String?

  title   String
  summary String?

  status      ApprovalStatus @default(PENDING)
  currentStep Int            @default(1)

  decidedAt       DateTime?
  decidedByUserId String?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterEmployee Employee        @relation("ApprovalRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  steps             ApprovalStep[]
  events            ApprovalEvent[]

  @@unique([subjectType, subjectId])
  @@index([companyId, status])
  @@index([companyId, subjectType, subjectId])
  @@index([requesterEmployeeId, status])
  @@map("approval_requests")
}

/// One level of an approval chain. Multi-level flows are several rows with
/// increasing stepOrder; the request advances as each is approved.
model ApprovalStep {
  id                String @id @default(cuid())
  approvalRequestId String
  stepOrder         Int

  /**
   * The step's named owner, for display and for the chains that predate
   * stages. AUTHORITY LIVES IN `approvers`, never here: a stage filled by three
   * team managers has three rows there and, having no single owner, null here.
   * A step that resolves to exactly one person carries that person in both,
   * which is what lets every row written before `approval_step_approvers`
   * existed keep working - the migration copied each one across.
   */
  approverEmployeeId String?
  approverRoleKey    String?

  /**
   * Which rung of the organisation this step was filled from, recorded at
   * submission time. Null on the chains raised before stages existed.
   * Written down rather than recomputed because it is the question asked six
   * months later - "who approved this, and as what?" - and the answer must not
   * change when somebody is moved to another team.
   */
  stage ApprovalStage?
  /// ANY_ONE or ALL, copied from the workflow at submission time for the same
  /// reason: re-reading the workflow later would re-decide settled history.
  mode  ApprovalStageMode @default(ANY_ONE)

  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  comment         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalRequest  ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approverEmployee Employee?              @relation("ApprovalApprover", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  approvers        ApprovalStepApprover[]

  @@unique([approvalRequestId, stepOrder])
  @@index([approverEmployeeId, status])
  @@map("approval_steps")
}

/// Append-only transition history. Never updated, never deleted - the API
/// exposes no mutation for this table at all.
model ApprovalEvent {
  id                String @id @default(cuid())
  approvalRequestId String

  actorUserId String?
  action      String
  fromStatus  ApprovalStatus?
  toStatus    ApprovalStatus
  comment     String?

  createdAt DateTime @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId, createdAt])
  @@map("approval_events")
}

/**
 * One named approver on one step.
 * This table is what makes "any one of the three managers" expressible. The
 * step holds the stage and the mode; this holds the candidates and, once
 * somebody decides, WHICH of them decided and what they said. A stage in
 * ANY_ONE mode completes on the first APPROVED row here; a stage in ALL mode
 * completes when no PENDING row is left. Either way one REJECTED row ends the
 * whole request.
 * Rows are never deleted when the roster changes. A manager who left the
 * company keeps their seat on the requests that were already in flight, so the
 * history says who was asked - and an administrator with `approval.manage`
 * overrides the step if nobody remaining can sign it.
 */
model ApprovalStepApprover {
  id             String @id @default(cuid())
  approvalStepId String
  employeeId     String

  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?
  decidedAt       DateTime?
  comment         String?

  createdAt DateTime @default(now())

  approvalStep ApprovalStep @relation(fields: [approvalStepId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([approvalStepId, employeeId])
  @@index([employeeId, status])
  @@map("approval_step_approvers")
}

/**
 * The approval chain a company uses for one kind of request.
 * Configuration, not code: the default chain lives in the shared package
 * (`DEFAULT_APPROVAL_STAGES`) and is used when a company has stored no
 * workflow, so a fresh installation routes leave through Team Manager, HR
 * Manager and CEO without anybody configuring anything. A row here overrides
 * that for one subject type, and only for the company that owns it.
 */
model ApprovalWorkflow {
  id          String              @id @default(cuid())
  companyId   String
  subjectType ApprovalSubjectType
  name        String
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages  ApprovalWorkflowStage[]

  @@unique([companyId, subjectType])
  @@map("approval_workflows")
}

/// One rung of a configured chain. Sequential: stageOrder 1 decides first.
model ApprovalWorkflowStage {
  id         String            @id @default(cuid())
  workflowId String
  stageOrder Int
  stage      ApprovalStage
  mode       ApprovalStageMode @default(ANY_ONE)
  isActive   Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stageOrder])
  @@map("approval_workflow_stages")
}

/**
 * Who fills a company-wide approval stage.
 * `TEAM_MANAGER` is not configured here - it is answered by the team roster,
 * which is the whole point of `TeamManager`. `HR_MANAGER` and `CEO` have no
 * such roster, and the alternative to naming them is guessing from a
 * designation called "Chief Executive Officer", which is precisely the
 * inference this feature exists to remove.
 * Several people may hold one seat: two HR managers, an acting CEO. The
 * stage's mode decides whether one of them is enough.
 */
model ApprovalStageAssignee {
  id         String        @id @default(cuid())
  companyId  String
  stage      ApprovalStage
  employeeId String
  isActive   Boolean       @default(true)

  assignedAt       DateTime @default(now())
  assignedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, stage, employeeId])
  @@index([companyId, stage, isActive])
  @@map("approval_stage_assignees")
}

// -------------------------------------------------------------- notifications

model Notification {
  id        String @id @default(cuid())
  companyId String
  /// Recipient login account.
  userId    String

  type    NotificationType
  title   String
  message String

  /// Optional pointer back to whatever this is about.
  entityType String?
  entityId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------ password resets

/// Only the SHA-256 hash of the token is stored, exactly as with sessions, so
/// a database leak cannot be replayed as a reset.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestedIp String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------- attendance

model AttendanceRecord {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime @db.Date

  status        AttendanceStatus @default(PRESENT)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  workedMinutes Int?
  notes         String?
  source        AttendanceSource @default(SELF)
  mode          AttendanceMode?

  /// The shift in force on the day, captured at check-in so a later shift
  /// change cannot retrospectively alter how late someone was.
  shiftId     String?
  lateMinutes Int?

  /// Derived from the policy at write time so reports never have to recompute.
  earlyLeaveMinutes Int?
  /// The portion of workedMinutes beyond the configured overtime threshold.
  overtimeMinutes   Int?
  /// The day started too late to fit the shift it was scored against. Stored
  /// by the engine at write time; rows from before the column existed read
  /// false, which is what they were reported as.
  irregular         Boolean @default(false)

  /// Where the check-in came from, when the company records it. Stored for the
  /// audit trail even when the restriction is switched off.
  checkInLatitude  Float?
  checkInLongitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift          Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  adjustments    AttendanceAdjustment[]
  leaveReversals LeaveReversal[]

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@index([companyId, status])
  @@map("attendance_records")
}

/// One manual change to processed attendance, or one re-attribution of
/// punches after a mapping correction.
///
/// The raw punch is never edited and the record is overwritten in place, so
/// this ledger is what makes a correction auditable: old value, new value,
/// who, why and when, per field. Nothing here is ever deleted.
model AttendanceAdjustment {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime @db.Date
  recordId   String?

  kind          AttendanceAdjustmentKind @default(CORRECTION)
  /// Names of the fields that changed, in the order they are shown.
  changedFields String[]
  before        Json
  after         Json
  reason        String
  actorId       String?

  createdAt DateTime @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record   AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  actor    User?             @relation("AttendanceAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([companyId, createdAt])
  @@map("attendance_adjustments")
}

/// A request to correct an attendance record. Carries its own status mirroring
/// the approval so the domain table can be queried without joining the engine.
model AttendanceRegularizationRequest {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  attendanceDate DateTime @db.Date

  /// What the employee says is wrong. Null on every row raised before the
  /// field existed, and on anything filed without one - it is a description of
  /// the complaint, never an input to how the correction is applied.
  issueType           AttendanceCorrectionIssue?
  requestedCheckInAt  DateTime?
  requestedCheckOutAt DateTime?
  requestedStatus     AttendanceStatus?
  reason              String

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, attendanceDate])
  @@map("attendance_regularization_requests")
}

// --------------------------------------------------------------------- shifts

model Shift {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?

  /// Local wall-clock times as HH:mm. Timezone comes from the work location.
  startTime    String
  endTime      String
  breakMinutes Int     @default(0)
  isActive     Boolean @default(true)
  description  String?

  /// Days this shift works. Empty means the company's working days (every day
  /// that is not a configured weekend day). A day outside the list is an off
  /// day for anyone on the shift.
  workingDays WeekDay[] @default([])

  /// Rostered minutes, for reports and payroll. Null derives it from the
  /// window and the break, the way it always has been.
  expectedMinutes Int?

  /// Rule overrides. Null inherits the company attendance rules, so a shift
  /// states only what is different about it.
  graceMinutes                  Int?
  earlyLeaveGraceMinutes        Int?
  lateTrackingEnabled           Boolean?
  earlyDepartureTrackingEnabled Boolean?
  overtimeEnabled               Boolean?
  overtimeDailyCapMinutes       Int?
  overtimeMinimumMinutes        Int?

  /// When the definition took effect, for the record. Assignments carry their
  /// own dates; this documents the shift itself.
  effectiveFrom DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeShiftAssignment[]
  attendance  AttendanceRecord[]
  requestedBy ShiftChangeRequest[]      @relation("RequestedShift")
  currentOf   ShiftChangeRequest[]      @relation("CurrentShift")

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("shifts")
}

model EmployeeShiftAssignment {
  id         String @id @default(cuid())
  companyId  String
  employeeId String
  shiftId    String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([companyId, shiftId])
  @@map("employee_shift_assignments")
}

model ShiftChangeRequest {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  currentShiftId   String?
  requestedShiftId String
  effectiveFrom    DateTime @db.Date
  reason           String

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentShift   Shift?   @relation("CurrentShift", fields: [currentShiftId], references: [id], onDelete: SetNull)
  requestedShift Shift    @relation("RequestedShift", fields: [requestedShiftId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([employeeId, effectiveFrom])
  @@map("shift_change_requests")
}

// ----------------------------------------------------------------- timesheets

model Timesheet {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status       TimesheetStatus @default(DRAFT)
  totalMinutes Int             @default(0)
  notes        String?

  submittedAt       DateTime?
  approvalRequestId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  TimesheetEntry[]

  @@unique([employeeId, periodStart])
  @@index([companyId, status])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  date        DateTime @db.Date
  minutes     Int
  description String?

  /// MANUAL unless the line was filled from captured attendance.
  source             TimesheetEntrySource @default(MANUAL)
  /// The attendance day this line mirrors, when it came from one.
  attendanceRecordId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId, date])
  @@map("timesheet_entries")
}

// ===========================================================================
// PHASE 4 - leave and holidays
// ===========================================================================

/// Half-day support. A range longer than one day is always FULL_DAY; the half
/// options only make sense for a single-day request.
enum LeaveDayPart {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

/// Leave policy, entirely data-driven. Nothing about entitlement, accrual or
/// carry-forward is hard-coded in the services - they read these columns.
model LeaveType {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?

  /// Days granted per full year. Accrual is capped at this figure so an
  /// employee can never silently exceed their entitlement.
  annualEntitlementDays Decimal @db.Decimal(6, 2)

  /// Days earned per completed month. Usually annualEntitlement / 12, but kept
  /// separate so a policy can accrue faster or slower than a flat twelfth.
  monthlyAccrualDays Decimal @db.Decimal(6, 2)

  carryForwardEnabled Boolean  @default(false)
  /// Maximum days that survive a year boundary. Null means uncapped, which is
  /// only meaningful when carryForwardEnabled is true.
  carryForwardCapDays Decimal? @db.Decimal(6, 2)

  /// Unpaid leave still consumes a balance but is flagged for payroll later.
  isPaid Boolean @default(true)

  /// Whether payroll deducts this leave even though it is paid.
  ///
  /// Off for every leave type, and deliberately so: approved paid leave is
  /// leave the company agreed to pay for, and deducting it by default would
  /// make "paid" meaningless. A company that runs a type which accrues,
  /// approves and still costs the employee a day - some sick or compassionate
  /// arrangements do - turns this on for that type alone.
  isDeductible Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]
  balances LeaveBalance[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("leave_types")
}

/// Per employee, per leave type, per year.
///
/// Deliberately stores only what cannot be derived: the opening balance carried
/// in from last year, and any manual adjustment an administrator has made.
/// Accrued, used and pending are all computed from the leave type policy and
/// the request rows, so a stored total can never drift from reality.
model LeaveBalance {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String
  year        Int

  /// Carried forward from the previous year, already capped on write.
  openingDays    Decimal @default(0) @db.Decimal(6, 2)
  /// Administrative correction, positive or negative.
  adjustmentDays Decimal @default(0) @db.Decimal(6, 2)
  adjustmentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  leaveTypeId String

  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  dayPart   LeaveDayPart @default(FULL_DAY)

  /// Working days consumed, weekends and applicable holidays already removed.
  /// Stored because the holiday calendar may change after approval and the
  /// figure the decision was made on must not move retrospectively.
  totalDays Decimal @db.Decimal(6, 2)

  reason String

  /// Supporting evidence for the request - a medical certificate, a booking.
  /// Held as a link rather than a file: there is no document store yet, and a
  /// URL is lossless where a missing upload endpoint would be a blocker.
  documentUrl  String?
  documentName String?

  status            ApprovalStatus @default(PENDING)
  approvalRequestId String?        @unique

  decidedAt   DateTime?
  cancelledAt DateTime?

  /// Set when the system, not a person, cancelled the request: every day it
  /// covered turned out to be worked. A person's cancellation leaves both
  /// empty, so the leave screens never present one as the other.
  cancelledBySystem  Boolean @default(false)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  reversals LeaveReversal[]

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([employeeId, status])
  @@map("leave_requests")
}

/// One day of approved leave given back because attendance was recorded on it.
///
/// The leave request is never edited or deleted: its `totalDays` stays the
/// figure the approval was made on, and the balance subtracts these rows from
/// it. The (leaveRequestId, date) key is what makes reconciliation idempotent -
/// a second run for the same day collides here and restores nothing.
///
/// The attendance that triggered it is copied, not only linked, so the reason
/// survives a later correction or deletion of that record.
model LeaveReversal {
  id             String   @id @default(cuid())
  companyId      String
  employeeId     String
  leaveRequestId String
  date           DateTime @db.Date

  /// Leave days restored: 1 for a full day, 0.5 for a half day.
  days   Decimal @db.Decimal(6, 2)
  reason String

  /// The person who gave the day back - a Super Admin resolving the conflict
  /// by hand. Null when attendance reconciliation did it automatically.
  reversedById String?

  attendanceRecordId String?
  attendanceSource   AttendanceSource
  checkInAt          DateTime
  checkOutAt         DateTime?

  createdAt DateTime @default(now())

  leaveRequest     LeaveRequest      @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@unique([leaveRequestId, date])
  @@index([employeeId, date])
  @@map("leave_reversals")
}

/// A non-working day. `locationId` null means the holiday applies company-wide;
/// employees otherwise inherit the calendar of the location they are assigned to.
model Holiday {
  id        String   @id @default(cuid())
  companyId String
  name      String
  date      DateTime @db.Date

  /// Null = all locations.
  locationId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct, so this stops duplicates for a named
  // location only. The company-wide case is enforced in the service layer.
  @@unique([companyId, date, locationId])
  @@index([companyId, date])
  @@index([locationId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------- phase 6

/// How broadly an attendance policy applies. Resolution runs most specific
/// first, so an employee override beats a team one, which beats a department
/// one, which beats the company baseline.
enum AttendancePolicyScope {
  COMPANY
  DEPARTMENT
  TEAM
  EMPLOYEE
}

/// A named set of attendance thresholds.
///
/// The Company row still carries the baseline every employee falls back to, so
/// nothing here is required for the system to work. A policy exists only to
/// override that baseline for part of the workforce, or to change it from a
/// date onwards without rewriting how past days were scored.
model AttendancePolicy {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?

  graceMinutes            Int     @default(10)
  halfDayMinutes          Int     @default(240)
  fullDayMinutes          Int     @default(480)
  earlyLeaveGraceMinutes  Int     @default(10)
  overtimeEnabled         Boolean @default(true)
  overtimeAfterMinutes    Int     @default(480)
  overtimeDailyCapMinutes Int     @default(240)

  /// Nullable throughout: null means "inherit the company value". An override
  /// that had to restate every rule would drift from the baseline the moment
  /// the baseline changed.
  defaultShiftStart               String?
  defaultShiftEnd                 String?
  overtimeFromShiftEnd            Boolean?
  overtimeCountsEarlyArrival      Boolean?
  overtimeReducedByLateArrival    Boolean?
  fullDayToleranceMinutes         Int?
  overtimeMinimumMinutes          Int?
  overtimeRoundingMinutes         Int?
  overtimeWeeklyCapMinutes        Int?
  overtimeMonthlyCapMinutes       Int?
  breakIncludedInWindow           Boolean?
  irregularCheckInEnabled         Boolean?
  irregularCheckInMode            IrregularCutoffMode?
  irregularAfterShiftStartMinutes Int?
  irregularCheckInCutoff          String?
  lateTrackingEnabled             Boolean?
  earlyDepartureTrackingEnabled   Boolean?
  duplicatePunchWindowSeconds     Int?
  maxPlausibleSpanMinutes         Int?
  allowImplausibleSpans           Boolean?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments AttendancePolicyAssignment[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("attendance_policies")
}

/// Where and when a policy applies.
///
/// Effective dates are what keep history honest: rescoring a day in March has
/// to use the policy that was in force in March, not whatever is current. A
/// null `effectiveTo` means "still in force".
model AttendancePolicyAssignment {
  id        String                @id @default(cuid())
  companyId String
  policyId  String
  scope     AttendancePolicyScope

  /// Null for COMPANY scope; otherwise the department, team or employee id.
  /// Deliberately not a foreign key: one column cannot reference three tables,
  /// and the routes validate the target exists before writing.
  targetId String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policy  AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([companyId, scope, targetId])
  @@index([policyId])
  @@map("attendance_policy_assignments")
}

/// Where a timesheet line came from.
///
/// CAPTURED lines mirror attendance and are rewritten whenever the timesheet is
/// synced. MANUAL lines were typed by a person and a sync never touches them,
/// so the two can coexist on one timesheet without either overwriting the other.
enum TimesheetEntrySource {
  MANUAL
  CAPTURED
}

// ------------------------------------------------- attendance devices (P7)

/// How the HRMS talks to a physical attendance terminal.
enum AttendanceDeviceProtocol {
  /// ZKTeco standalone "SDK" protocol. The HRMS opens a socket to the device
  /// and pulls transaction records. Default port 4370.
  ZKTECO_TCP
  /// ZKTeco ADMS / iclock push. The device posts records to the HRMS on a
  /// schedule it manages itself; nothing is pulled.
  ZKTECO_ADMS
  /// ZKTeco terminal reached by a connector running on the device's own LAN.
  ///
  /// The terminal still speaks the plain TCP protocol above; what changes is
  /// who opens the socket. A device sitting on an office LAN that this server
  /// has no route to cannot be polled from here at all, and a terminal whose
  /// firmware has no ADMS option cannot push either. The connector closes that
  /// gap: it polls over the LAN exactly as ZKTECO_TCP would, then posts what it
  /// read over ordinary outbound HTTPS.
  ///
  /// Deliberately its own protocol rather than a flag on ZKTECO_TCP. The
  /// scheduler polls by protocol, so a device recorded as TCP is dialled every
  /// interval whether or not a route exists - which is precisely the failure
  /// this value exists to stop.
  ZKTECO_LAN_CONNECTOR
}

enum AttendanceDeviceStatus {
  /// Configured but never contacted.
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

/// How raw punches become an in and an out.
///
/// Many terminals report a punch state, but plenty are configured so every
/// punch is state 0. Guessing wrongly turns a genuine second entry into a
/// check-out, so which rule applies is per-device configuration.
enum AttendancePunchPairing {
  /// Earliest punch of the day is the in, latest is the out.
  FIRST_IN_LAST_OUT
  /// Trust the state the device reports, and ignore punches carrying none.
  DEVICE_STATE
}

enum AttendanceSyncStatus {
  RUNNING
  SUCCESS
  /// Finished, but at least one transaction could not be imported.
  PARTIAL
  FAILED
}

enum AttendanceSyncTrigger {
  SCHEDULED
  MANUAL
  STARTUP
  /// The device sent the records itself; nothing was polled.
  PUSH
}

/// A physical attendance terminal.
model AttendanceDevice {
  id         String  @id @default(cuid())
  companyId  String
  locationId String?

  name         String
  protocol     AttendanceDeviceProtocol @default(ZKTECO_TCP)
  host         String
  port         Int                      @default(4370)
  serialNumber String?

  /// The zone the device clock is set to. Punches arrive as local wall-clock
  /// readings with no offset, so without this they cannot be placed on the
  /// timeline at all.
  timeZone String @default("UTC")

  /// Comm key, encrypted at rest. Never returned by any endpoint - the API
  /// exposes only whether one is set.
  commKeyCipher String?

  isEnabled           Boolean                @default(true)
  syncIntervalMinutes Int                    @default(15)
  punchPairing        AttendancePunchPairing @default(FIRST_IN_LAST_OUT)

  status      AttendanceDeviceStatus @default(UNKNOWN)
  lastSeenAt  DateTime?
  lastSyncAt  DateTime?
  lastPunchAt DateTime?
  /// Most recent failure, kept so the screen can explain a red status without
  /// an administrator having to read server logs.
  lastError   String?

  /// Watermark. Only transactions at or after this instant are requested, which
  /// makes catch-up after an outage an ordinary sync rather than a special case.
  syncCursorAt DateTime?

  /// Held for the duration of a sync so two never overlap on one device.
  syncLockedAt  DateTime?
  syncLockToken String?

  // --- ADMS push (phase 8) -------------------------------------------------

  /// Last time the device - or its connector - posted anything, whether or not
  /// it carried records.
  lastPushAt DateTime?

  /// Version string the LAN connector last reported, so an operator can tell a
  /// stale connector from a stale device without going to the office.
  connectorVersion String?

  /// The device's shared secret, encrypted at rest.
  ///
  /// Used two ways, because both callers have the same problem: a serial number
  /// printed on a case is an identifier, not a credential. An ADMS terminal
  /// carries it as a path segment in its server URL, which is the only place
  /// its firmware can put one; a LAN connector sends it as a bearer token.
  /// Either way it is what turns a guessable identifier into a credential.
  pushTokenCipher String?

  /// Networks the device may push from. Empty means any source, which is the
  /// out-of-the-box behaviour: a terminal is plugged in and starts posting
  /// before anyone has had a chance to write down its address.
  allowedPushCidrs String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  mappings      AttendanceDeviceUserMapping[]
  syncs         AttendanceDeviceSync[]
  punches       AttendanceRawPunch[]
  enrolledUsers AttendanceDeviceEnrolledUser[]

  @@unique([companyId, name])
  @@unique([companyId, serialNumber])
  @@index([companyId, isEnabled])
  @@map("attendance_devices")
}

/// Device user id to HRMS employee.
///
/// Deliberately its own table. The number on the terminal is whatever whoever
/// enrolled the finger typed; assuming it equals an employee number, let alone a
/// database id, is how biometric imports end up attributed to the wrong person.
model AttendanceDeviceUserMapping {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  /// The identifier the device sends, as a string. Terminals pad and reuse
  /// these, so it is never treated as a number here.
  deviceUserId   String
  /// The name held on the device, for recognising a mapping at a glance.
  deviceUserName String?

  employeeId String
  isActive   Boolean @default(true)

  /// The period this mapping attributes punches for. Null `effectiveFrom`
  /// means "since the beginning", null `effectiveTo` means "still in force".
  /// A PIN reassigned to a new joiner keeps its old mapping, closed, so the
  /// leaver's punches stay theirs and the history is readable.
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One device user resolves to exactly one employee on a given DAY. The
  /// service refuses overlapping periods; the index only speeds the lookup.
  @@index([deviceId, deviceUserId])
  @@index([companyId, employeeId])
  @@map("attendance_device_user_mappings")
}

/// The enrolment roster a device holds, as last reported.
///
/// A cache, never a source of truth. It exists so the mapping screen can show
/// "PIN 1007 - AHMED" instead of asking an administrator to guess which number
/// belongs to whom, which is the difference between a mapping step that takes
/// ten minutes and one that takes an afternoon at the terminal.
///
/// Nothing here attributes a punch. Attribution is AttendanceDeviceUserMapping
/// and only that: a roster entry appearing or disappearing must never silently
/// change whose attendance a punch became.
model AttendanceDeviceEnrolledUser {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  /// The PIN as the device reports it, as a string. Terminals pad and reuse
  /// these, so it is never treated as a number.
  deviceUserId String
  name         String?
  privilege    Int?
  cardNumber   String?

  /// When the connector last saw this user on the device.
  seenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@index([companyId, deviceId])
  @@map("attendance_device_enrolled_users")
}

/// One synchronisation run, kept whether it succeeded or not.
model AttendanceDeviceSync {
  id        String @id @default(cuid())
  companyId String
  deviceId  String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  status  AttendanceSyncStatus  @default(RUNNING)
  trigger AttendanceSyncTrigger @default(SCHEDULED)

  fetched    Int @default(0)
  inserted   Int @default(0)
  duplicates Int @default(0)
  unmapped   Int @default(0)
  rejected   Int @default(0)

  /// The window actually requested, so a gap in coverage is visible.
  cursorFrom DateTime?
  cursorTo   DateTime?

  /// How many connection attempts this run took, including the successful one.
  attempts Int @default(1)

  error        String?
  /// Per-record failures: what was wrong, and with which transaction. Bounded
  /// so one broken batch cannot write an unbounded blob, and never carries a
  /// credential.
  errorDetails Json?

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  AttendanceDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  punches AttendanceRawPunch[]

  @@index([deviceId, startedAt])
  @@index([companyId, status])
  @@map("attendance_device_syncs")
}

/// A transaction exactly as the device reported it.
///
/// This is the audit trail and it is never rewritten. Attendance calculations
/// read punches and write AttendanceRecord; nothing writes back here, so a
/// recalculation can always be redone from the original evidence.
model AttendanceRawPunch {
  id        String  @id @default(cuid())
  companyId String
  deviceId  String
  syncId    String?

  deviceUserId String
  /// Resolved at import. Null means unmapped - the punch is kept and surfaced
  /// rather than dropped, and can be attributed later.
  employeeId   String?

  /// The device transaction identifier, where it provides one.
  deviceTransactionId String?
  /// The raw reading, untouched, for when a normalisation is ever questioned.
  rawTimestamp        String
  /// The zone used to normalise it, captured at import in case the device is
  /// later reconfigured.
  deviceTimeZone      String
  /// The normalised instant. This is what calculations use.
  punchedAt           DateTime
  /// The local day the punch belongs to, in the company zone.
  localDayKey         String

  /// Whatever the device said about direction, preserved verbatim.
  punchState String?
  /// Fingerprint, card, face, password - as reported.
  verifyMode String?

  /// Deterministic identity. Built from device, user, instant and whatever
  /// transaction identifier exists, so re-importing the same transaction is a
  /// no-op at the database level rather than a matter of application care.
  fingerprint String

  importedAt  DateTime  @default(now())
  /// Set once the punch has been folded into an AttendanceRecord.
  processedAt DateTime?

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device   AttendanceDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sync     AttendanceDeviceSync? @relation(fields: [syncId], references: [id], onDelete: SetNull)

  @@unique([deviceId, fingerprint])
  @@index([companyId, employeeId, localDayKey])
  @@index([companyId, deviceUserId])
  @@index([deviceId, punchedAt])
  @@index([companyId, employeeId, processedAt])
  @@map("attendance_raw_punches")
}

// ===========================================================================
// PHASE 9 - payroll
//
// The engine above decides what happened; this decides what it is worth. The
// boundary matters: nothing here reads a punch, re-derives a day or second
// guesses an attendance status. Payroll consumes DerivedDay, the same shape the
// attendance screens are built from, so a figure on a payslip can always be
// traced to a day an administrator can look at.
//
// Two rules shape most of these tables:
//
//   - Nothing is hard-coded. What a day is worth, what an absence costs, what
//     overtime multiplies by - all of it is configuration, because no two
//     companies agree and the ones that do change their minds.
//   - A finalized run is immutable. Every figure it used is copied onto the
//     line at calculation time, so a later salary edit, attendance correction
//     or policy change cannot silently rewrite what someone was paid.
// ===========================================================================

/// How an employee is paid. Effective-dated on the salary record rather than
/// the profile: moving someone from monthly to hourly is a change to their
/// terms, and last month's payroll must keep using the old ones.
enum PayrollSalaryType {
  MONTHLY
  DAILY
  HOURLY
}

/// What a monthly salary is divided by to reach a daily rate.
///
/// The single most argued-about number in payroll. A company paying by calendar
/// days and one paying by a fixed thirty produce different figures from the
/// same salary and the same attendance, and both are correct for their own
/// contracts, so this cannot be a constant in the code.
enum PayrollBasis {
  /// The actual number of days in the pay period.
  CALENDAR_DAYS
  /// A fixed figure, whatever the month contains. Usually 30 or 26.
  FIXED_DAYS
  /// Scheduled working days: the period less weekends and holidays.
  WORKING_DAYS
}

/// How often payroll is run.
///
/// Reporting and period suggestion only: the calculation reads the period's
/// actual start and end dates, so a company can run an irregular period without
/// this having to agree with it.
enum PayrollFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

/// How overtime is priced.
enum PayrollOvertimeMode {
  /// Overtime is not paid at all. Hours are still recorded and reported.
  NONE
  /// The employee's hourly rate multiplied by a factor.
  MULTIPLIER
  /// A flat amount per hour, ignoring the employee's own rate.
  FIXED_RATE
}

/// How lateness and early leaving translate into money.
enum PayrollTimeDeductionMode {
  NONE
  /// A rate for every minute past the grace period.
  PER_MINUTE
  /// A flat amount each time it happens, regardless of how long.
  PER_OCCURRENCE
}

/// How a day worked short of its roster is charged.
enum PayrollShortHoursMode {
  NONE
  /// A flat rate for every minute short, past the grace period.
  PER_MINUTE
  /// The employee's own hourly rate, applied to the hours they were short.
  /// The usual arrangement: an hour not worked costs an hour of pay.
  PRO_RATA
}

enum PayrollComponentKind {
  EARNING
  DEDUCTION
}

/// How a component's amount is arrived at.
enum PayrollComponentCalc {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  /// value x payable days in the period
  PER_DAY
  /// value x hours actually worked in the period
  PER_HOUR
}

/// How a monthly salary is split across the days a salary segment covers.
enum PayrollProrationMethod {
  /// share = calendar days covered / calendar days in period
  CALENDAR_DAYS
  /// share = scheduled working days covered / scheduled working days in period
  WORKING_DAYS
}

/// Whether a component repeats every period or applies once.
enum PayrollComponentFrequency {
  RECURRING
  ONE_TIME
}

enum PayrollPeriodStatus {
  OPEN
  /// A finalized run exists for this period; it no longer accepts new runs.
  CLOSED
}

/// The life of a payroll run.
///
/// CALCULATING is a real state, not a UI nicety: a run being calculated must
/// refuse a second calculation, and a process that dies mid-calculation has to
/// be distinguishable from one that never started.
enum PayrollRunStatus {
  DRAFT
  CALCULATING
  REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

/// Something the calculation could not resolve confidently.
///
/// Recorded rather than guessed at. A payroll that quietly pays zero because a
/// salary was missing is worse than one that refuses to finalize and says so.
enum PayrollExceptionCode {
  MISSING_SALARY
  MISSING_PROFILE
  OVERLAPPING_SALARY
  INVALID_ATTENDANCE
  MISSING_SHIFT
  UNAPPROVED_OVERTIME
  NON_POSITIVE_NET
  INCOMPLETE_EMPLOYEE
  OVERTIME_CAPPED
}

/// BLOCKING stops finalization; WARNING is recorded and shown but does not.
enum PayrollExceptionSeverity {
  BLOCKING
  WARNING
}

/// Company-wide payroll configuration.
///
/// One row per company, created on demand with defaults that reproduce the most
/// common arrangement. Everything here can be overridden per employee on their
/// PayrollProfile; a null there means "inherit this".
model PayrollSettings {
  id        String @id @default(cuid())
  companyId String @unique

  /// How often payroll is run. Suggests period dates; nothing calculates from it.
  frequency PayrollFrequency @default(MONTHLY)

  /// Multipliers for overtime worked on a non-working day. Null uses the
  /// ordinary overtimeMultiplier, which is the behaviour before these existed.
  overtimeWeekendMultiplier Decimal? @db.Decimal(6, 3)
  overtimeHolidayMultiplier Decimal? @db.Decimal(6, 3)

  /// Scheduled minutes assumed for a day with no shift assignment behind it.
  /// Configuration rather than a constant: a company with a different working
  /// day should not need a deployment to say so.
  fallbackScheduledMinutes Int @default(480)

  /// How a monthly salary is prorated when it changes mid-period.
  prorationMethod PayrollProrationMethod @default(CALENDAR_DAYS)
  /// Day of the month pay is issued, used as the default pay date when a
  /// period is created. Null leaves the pay date to be set per period.
  payDay          Int?

  // --- what a day is worth --------------------------------------------------
  basis               PayrollBasis @default(FIXED_DAYS)
  /// Only consulted when basis is FIXED_DAYS.
  fixedBasisDays      Int          @default(30)
  /// Used to turn a daily rate into an hourly one for monthly and daily staff.
  standardHoursPerDay Decimal      @default(8) @db.Decimal(6, 2)

  // --- overtime -------------------------------------------------------------
  overtimeMode            PayrollOvertimeMode @default(MULTIPLIER)
  overtimeMultiplier      Decimal             @default(1.5) @db.Decimal(6, 3)
  /// Only consulted when overtimeMode is FIXED_RATE.
  overtimeFixedRate       Decimal             @default(0) @db.Decimal(14, 4)
  /// When true - the default - only overtime on an APPROVED timesheet is paid.
  /// Unapproved hours are still counted and reported as an exception.
  requireApprovedOvertime Boolean             @default(true)
  /// Most overtime minutes paid to one employee in one pay period. Null - the
  /// default - pays whatever the attendance engine reported, which already
  /// carries the attendance policy's daily, weekly and monthly caps. This is a
  /// pay ceiling on top of those, not a replacement for them.
  overtimeCapMinutes      Int?

  // --- what an absence costs ------------------------------------------------
  /// Whether a day recorded as ABSENT reduces pay.
  deductUnpaidAbsence Boolean @default(true)
  /// Whether leave on an unpaid leave type reduces pay.
  deductUnpaidLeave   Boolean @default(true)

  lateDeductionMode PayrollTimeDeductionMode @default(NONE)
  /// Per minute or per occurrence depending on the mode above.
  lateDeductionRate Decimal                  @default(0) @db.Decimal(14, 4)
  /// Lateness at or below this many minutes never costs anything, on top of
  /// whatever the attendance policy already forgave.
  lateGraceMinutes  Int                      @default(0)

  earlyLeaveDeductionMode PayrollTimeDeductionMode @default(NONE)
  earlyLeaveDeductionRate Decimal                  @default(0) @db.Decimal(14, 4)
  earlyLeaveGraceMinutes  Int                      @default(0)

  // --- short hours ----------------------------------------------------------
  /// What a day attended but worked short of its roster costs.
  ///
  /// Distinct from the late and early-leave deductions, which charge the two
  /// ENDS of a day. This charges the middle: someone who arrives on time,
  /// leaves on time and was absent for three hours in between is neither late
  /// nor early, and only this notices. Off by default, so no existing figure
  /// moves until a company turns it on.
  shortHoursDeductionMode PayrollShortHoursMode @default(NONE)
  /// Only consulted when the mode is PER_MINUTE.
  shortHoursDeductionRate Decimal               @default(0) @db.Decimal(14, 4)
  /// Minutes short that are forgiven before anything is charged.
  shortHoursGraceMinutes  Int                   @default(0)

  /// Whether a tax module is in play. Off, and nothing computes tax: the flag
  /// exists so components can be marked taxable now and a tax module written
  /// later without backfilling. No rate is stored here, because a rate that is
  /// wrong for a jurisdiction is worse than no rate at all.
  taxEnabled Boolean @default(false)

  // --- presentation ---------------------------------------------------------
  /// Decimal places money is rounded to when a line is written.
  roundingDecimals Int    @default(2)
  payslipPrefix    String @default("PS-")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

/// Per-employee payroll configuration.
///
/// Deliberately holds no amount. Money is effective-dated on EmployeeSalary;
/// this is the stable configuration that says how that money should be read.
/// Every override is nullable, and null means "use the company setting" - so a
/// company that changes its mind changes one row, not four hundred.
model PayrollProfile {
  id         String @id @default(cuid())
  companyId  String
  employeeId String @unique

  /// Excluded from every run while false, without deleting anything.
  isActive Boolean @default(true)

  basis               PayrollBasis?
  fixedBasisDays      Int?
  standardHoursPerDay Decimal?      @db.Decimal(6, 2)

  overtimeMode       PayrollOvertimeMode?
  overtimeMultiplier Decimal?             @db.Decimal(6, 3)
  overtimeFixedRate  Decimal?             @db.Decimal(14, 4)
  /// Set when this employee is paid a different hourly rate for overtime than
  /// their salary implies. Null derives it from the salary and the basis.
  hourlyRateOverride Decimal?             @db.Decimal(14, 4)

  deductUnpaidAbsence Boolean?
  deductUnpaidLeave   Boolean?

  /// Null inherits the company setting, like every other override here.
  shortHoursDeductionMode PayrollShortHoursMode?
  shortHoursDeductionRate Decimal?               @db.Decimal(14, 4)
  shortHoursGraceMinutes  Int?

  /// Free text: bank, cash, cheque. Not a payment integration, just a note on
  /// how this person is paid, so a payslip can say so.
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("payroll_profiles")
}

/// What an employee is paid, from a date.
///
/// The rule the whole model exists for: a raise in July must not change what
/// June was worth. Records are never edited in place once a run has used them;
/// a new row is opened and the previous one closed, exactly as
/// EmployeeShiftAssignment already does for shifts.
///
/// `effectiveTo` null means "still in force". Overlapping open-ended rows are
/// rejected by the service and reported as an exception if they exist anyway.
model EmployeeSalary {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  salaryType PayrollSalaryType @default(MONTHLY)
  /// The monthly figure, the daily figure or the hourly figure, according to
  /// salaryType. One column because it is one contractual number; which unit it
  /// is read in is the type's business.
  amount     Decimal           @db.Decimal(14, 2)
  /// ISO 4217. Defaults from the company but stored per record, because a
  /// company that changes currency must not restate history.
  currency   String            @db.Char(3)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Set when this record was opened by a recorded increment rather than
  /// entered directly. The revision is the paperwork; this row is the money.
  revision SalaryRevision? @relation("RevisionSalary")

  @@index([employeeId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("employee_salaries")
}

/// The catalogue of things that can appear on a payslip besides basic pay.
///
/// A definition only: transport allowance exists as a concept here, and what
/// any particular person gets is an assignment below. Splitting the two is what
/// lets a company rename "Conveyance" to "Transport" without touching anyone's
/// pay.
model SalaryComponent {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  code        String?
  description String?

  kind PayrollComponentKind
  calc PayrollComponentCalc @default(FIXED)

  /// Marks the component for a future tax module. Nothing computes tax today,
  /// and storing the flag now is cheaper than backfilling it later.
  isTaxable Boolean @default(true)
  isActive  Boolean @default(true)

  /// Where the line sits on a payslip. Lower first; ties fall back to name.
  displayOrder  Int       @default(0)
  /// The component does not apply to any period ending before this. Null
  /// means it always has.
  effectiveFrom DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EmployeeSalaryComponent[]

  @@unique([companyId, name])
  @@index([companyId, kind, isActive])
  @@map("salary_components")
}

/// One employee's entitlement to one component, from a date.
///
/// Effective-dated for the same reason salary is: a housing allowance that
/// started in March should not appear on February's payslip when February is
/// recalculated.
model EmployeeSalaryComponent {
  id          String @id @default(cuid())
  companyId   String
  employeeId  String
  componentId String

  /// Read as money for FIXED and as a percentage for the PERCENT_ calcs.
  value     Decimal                   @db.Decimal(14, 4)
  frequency PayrollComponentFrequency @default(RECURRING)

  effectiveFrom DateTime  @db.Date
  /// For ONE_TIME entries this is set equal to effectiveFrom by the service, so
  /// a bonus cannot silently repeat.
  effectiveTo   DateTime? @db.Date

  isActive Boolean @default(true)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([companyId, componentId])
  @@map("employee_salary_components")
}

/// A stretch of time payroll is run for.
///
/// Kept separate from the run so the same period can be recalculated after a
/// cancelled attempt without losing the identity of the month itself.
model PayrollPeriod {
  id        String @id @default(cuid())
  companyId String
  name      String

  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  /// When people are actually paid. Reporting only; no calculation reads it.
  payDate   DateTime? @db.Date

  status PayrollPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runs    PayrollRun[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status])
  @@map("payroll_periods")
}

/// One attempt at paying a period.
///
/// A period may have several: a cancelled run and then a good one. Only one may
/// reach FINALIZED, which is what closes the period.
model PayrollRun {
  id        String @id @default(cuid())
  companyId String
  periodId  String

  status PayrollRunStatus @default(DRAFT)
  notes  String?

  /// Copied from company settings when the run is calculated, so the figures
  /// stay explicable after the settings change.
  currency String @db.Char(3)

  // --- totals, written by the calculation ------------------------------------
  employeeCount  Int     @default(0)
  grossTotal     Decimal @default(0) @db.Decimal(16, 2)
  deductionTotal Decimal @default(0) @db.Decimal(16, 2)
  netTotal       Decimal @default(0) @db.Decimal(16, 2)
  exceptionCount Int     @default(0)
  blockingCount  Int     @default(0)

  calculatedAt DateTime?
  calculatedBy String?
  reviewedAt   DateTime?
  reviewedBy   String?
  approvedAt   DateTime?
  approvedBy   String?
  finalizedAt  DateTime?
  finalizedBy  String?
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  /// Set while a calculation is in flight, cleared when it ends. A stale value
  /// is what tells a later request that a previous calculation died.
  calculationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           PayrollPeriod             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  lines            PayrollLine[]
  exceptions       PayrollException[]
  loanInstallments EmployeeLoanInstallment[]

  @@index([companyId, status])
  @@index([periodId, status])
  @@map("payroll_runs")
}

/// One employee's pay for one run.
///
/// Everything the calculation used is copied here, not referenced: the salary
/// amount, the basis, the multiplier, the day counts. That redundancy is the
/// point - it is what makes a finalized line survive a salary edit, an
/// attendance correction or a change of company policy without moving.
model PayrollLine {
  id         String @id @default(cuid())
  companyId  String
  runId      String
  employeeId String

  // --- snapshot of the terms used -------------------------------------------
  salaryType     PayrollSalaryType
  salaryAmount   Decimal           @db.Decimal(14, 2)
  currency       String            @db.Char(3)
  basis          PayrollBasis
  basisDays      Decimal           @db.Decimal(8, 2)
  dailyRate      Decimal           @db.Decimal(14, 4)
  hourlyRate     Decimal           @db.Decimal(14, 4)
  /// Set when more than one salary record covered the period, so a reviewer can
  /// see at a glance why the basic figure is not the round number they expect.
  salarySegments Int               @default(1)

  // --- attendance, consumed from the existing engine -------------------------
  scheduledDays           Decimal @db.Decimal(8, 2)
  scheduledMinutes        Int     @default(0)
  presentDays             Decimal @db.Decimal(8, 2)
  halfDays                Decimal @db.Decimal(8, 2)
  absentDays              Decimal @db.Decimal(8, 2)
  paidLeaveDays           Decimal @db.Decimal(8, 2)
  unpaidLeaveDays         Decimal @db.Decimal(8, 2)
  holidayDays             Decimal @db.Decimal(8, 2)
  weekendDays             Decimal @db.Decimal(8, 2)
  payableDays             Decimal @db.Decimal(8, 2)
  unpaidDays              Decimal @db.Decimal(8, 2)
  workedMinutes           Int     @default(0)
  lateOccurrences         Int     @default(0)
  lateMinutes             Int     @default(0)
  earlyLeaveOccurrences   Int     @default(0)
  earlyLeaveMinutes       Int     @default(0)
  overtimeMinutes         Int     @default(0)
  /// The subset of overtimeMinutes that sat on an approved timesheet. Only this
  /// is paid when the company requires approval.
  approvedOvertimeMinutes Int     @default(0)
  /// What was actually priced: the approved (or all) minutes after the payroll
  /// overtime cap. The overtime line on the payslip is this many minutes.
  paidOvertimeMinutes     Int     @default(0)

  // --- money ----------------------------------------------------------------
  basicAmount     Decimal @db.Decimal(14, 2)
  earningsTotal   Decimal @db.Decimal(14, 2)
  overtimeAmount  Decimal @db.Decimal(14, 2)
  deductionsTotal Decimal @db.Decimal(14, 2)
  adjustmentTotal Decimal @default(0) @db.Decimal(14, 2)
  grossAmount     Decimal @db.Decimal(14, 2)
  netAmount       Decimal @db.Decimal(14, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run        PayrollRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  earnings   PayrollEarning[]
  deductions PayrollDeduction[]
  exceptions PayrollException[]
  payslip    Payslip?

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_lines")
}

/// One earning on one line, kept as its own row so a payslip can itemise.
///
/// The component name is copied rather than joined: renaming a component must
/// not change what a finalized payslip says it paid for.
model PayrollEarning {
  id     String @id @default(cuid())
  lineId String

  /// Null for the derived rows - basic pay and overtime - which have no
  /// catalogue entry behind them.
  componentId String?
  code        String?
  label       String
  kind        String  @default("COMPONENT")

  calc      PayrollComponentCalc @default(FIXED)
  /// The percentage or fixed figure the amount came from, for explicability.
  rate      Decimal?             @db.Decimal(14, 4)
  /// Hours or days the rate was multiplied by: overtime hours, payable days
  /// for a per-day allowance. Null when the line is a flat figure.
  units     Decimal?             @db.Decimal(10, 2)
  amount    Decimal              @db.Decimal(14, 2)
  isTaxable Boolean              @default(true)

  createdAt DateTime @default(now())

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("payroll_earnings")
}

/// One deduction on one line. Same reasoning as PayrollEarning.
model PayrollDeduction {
  id     String @id @default(cuid())
  lineId String

  componentId String?
  code        String?
  label       String
  /// ABSENCE, UNPAID_LEAVE, LATE, EARLY_LEAVE, COMPONENT, ADJUSTMENT - what
  /// produced this row, so a reviewer can tell a policy deduction from a
  /// deliberate one.
  kind        String  @default("COMPONENT")

  calc   PayrollComponentCalc @default(FIXED)
  rate   Decimal?             @db.Decimal(14, 4)
  /// The quantity the rate was applied to: days, minutes or occurrences.
  units  Decimal?             @db.Decimal(10, 2)
  amount Decimal              @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("payroll_deductions")
}

/// A correction to a finalized run.
///
/// The only way a finalized figure can be answered for. It never edits the
/// original line - it is applied to a later run, so both the original and the
/// correction remain visible and the history stays truthful.
model PayrollAdjustment {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// The finalized line being corrected, when the correction relates to one.
  originLineId String?
  /// The run the adjustment is applied in. Null until a run picks it up.
  appliedRunId String?

  kind   PayrollComponentKind
  label  String
  amount Decimal              @db.Decimal(14, 2)
  reason String

  appliedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([appliedRunId])
  @@map("payroll_adjustments")
}

/// The document an employee is entitled to see.
///
/// One per finalized line. It exists separately because it has its own identity
/// - a number people quote, an issue date, and a moment it became visible -
/// none of which belong to the calculation.
model Payslip {
  id         String @id @default(cuid())
  companyId  String
  lineId     String @unique
  employeeId String

  number      String
  issuedAt    DateTime  @default(now())
  /// Withheld until an administrator releases it, so a finalized run can be
  /// checked before anyone sees their own figure.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  line     PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([employeeId, issuedAt])
  @@map("payslips")
}

/// Something the calculation could not resolve.
///
/// Stored per run, and per line where one exists. A run carrying a BLOCKING
/// exception cannot be finalized, which is the mechanism behind "do not
/// silently produce questionable payroll".
model PayrollException {
  id         String  @id @default(cuid())
  companyId  String
  runId      String
  lineId     String?
  employeeId String?

  code     PayrollExceptionCode
  severity PayrollExceptionSeverity @default(BLOCKING)
  message  String
  /// Whatever the detector saw, for diagnosis. Never money owed to anyone.
  detail   Json?

  createdAt DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run     PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  line    PayrollLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([runId, severity])
  @@index([companyId, code])
  @@map("payroll_exceptions")
}

// ---------------------------------------------------------------- phase 10
//
// Employment paperwork and money owed: contracts, policies, salary revisions
// and loans. Everything here is append-only history by design - a contract
// that ends is not deleted, a policy that gets a new version is a new row, and
// a salary revision writes a new EmployeeSalary rather than editing the old
// one. Nothing in this section rewrites attendance, punches or a finalized
// payroll figure.

/// Company presence on the public internet, as configuration.
///
/// Deliberately a table rather than columns: "which platforms does this
/// company have?" is an answer that grows, and a new one should be a row an
/// administrator adds, not a migration. `Company.website` stays where it is -
/// this is the wider list that sits alongside it.
enum CompanyLinkKind {
  WEBSITE
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
  YOUTUBE
  DISCORD
  GITHUB
  CAREERS
  OTHER
}

model CompanyLink {
  id        String @id @default(cuid())
  companyId String

  kind  CompanyLinkKind @default(OTHER)
  /// What to call it in the UI. Free text so "GamEmpires website" and
  /// "Careers portal" are both expressible without a new enum member.
  label String
  url   String

  /// Lower first; ties fall back to label.
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, label])
  @@index([companyId, isActive, displayOrder])
  @@map("company_links")
}

// ------------------------------------------------------------------ contracts

enum EmployeeContractType {
  PERMANENT
  FIXED_TERM
  PROBATION
  INTERNSHIP
  CONSULTANCY
  PART_TIME
  TEMPORARY
}

/// Where a contract is in its life.
///
/// EXPIRED is derived from the end date in the reading layer as well, so a
/// contract nobody has touched still reports honestly; this column records the
/// decision somebody made about it.
enum EmployeeContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

/// One contract, kept forever.
///
/// Superseding a contract opens a new row and closes the old one; it never
/// edits the old one, so "what were they on last March?" stays answerable.
model EmployeeContract {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  contractType EmployeeContractType   @default(PERMANENT)
  status       EmployeeContractStatus @default(ACTIVE)

  /// A reference number as it appears on the paper, when there is one.
  reference String?

  startDate DateTime  @db.Date
  /// Null means open-ended, which is the ordinary shape of a permanent
  /// contract. A fixed-term one without an end date is reported as a gap
  /// rather than silently treated as permanent.
  endDate   DateTime? @db.Date

  /// The signed document. A link, for the same reason leave evidence is:
  /// there is no file store in this system yet.
  documentUrl  String?
  documentName String?

  /// The contract this one replaces, when it is a renewal.
  previousContractId String? @unique

  notes String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  previousContract EmployeeContract? @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewedBy        EmployeeContract? @relation("ContractRenewal")

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([companyId, endDate])
  @@map("employee_contracts")
}

// ------------------------------------------------------------------- policies

/// A policy document, at one version.
///
/// A new version is a NEW row, never an edit: an acknowledgement is an
/// acknowledgement of a particular text, and rewriting the text under a
/// signature would make the record a lie. `supersedesId` chains them so the
/// history reads in order.
model CompanyPolicy {
  id        String @id @default(cuid())
  companyId String

  name    String
  /// Free text: "1.0", "2026-Q1", "Rev C". Companies number policies their own
  /// way and an enforced scheme would be wrong for most of them.
  version String @default("1.0")

  category    String?
  description String?

  effectiveDate DateTime @db.Date

  documentUrl  String?
  documentName String?

  /// Whether it may still be assigned. Withdrawing a policy never deletes the
  /// acknowledgements already given for it.
  isActive Boolean @default(true)

  /// The earlier version this one replaces.
  supersedesId String? @unique

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supersedes   CompanyPolicy?             @relation("PolicyVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy CompanyPolicy?             @relation("PolicyVersion")
  assignments  EmployeePolicyAssignment[]

  @@unique([companyId, name, version])
  @@index([companyId, isActive])
  @@map("company_policies")
}

enum PolicyAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  DECLINED
}

/// One employee's copy of one policy version.
///
/// Never deleted and never reassigned to a different version: assigning the
/// next version creates another row, so the trail shows what was accepted and
/// when, for every version in turn.
model EmployeePolicyAssignment {
  id         String @id @default(cuid())
  companyId  String
  policyId   String
  employeeId String

  status PolicyAcknowledgementStatus @default(PENDING)

  assignedAt     DateTime  @default(now())
  assignedBy     String?
  /// When the employee is expected to have read it by. Null is no deadline.
  dueDate        DateTime? @db.Date
  acknowledgedAt DateTime?
  /// What the employee said when they acknowledged or declined it.
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  policy   CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([policyId, employeeId])
  @@index([companyId, status])
  @@index([employeeId, assignedAt])
  @@map("employee_policy_assignments")
}

// ----------------------------------------------------------- salary revisions

/// An increment, as a record of the decision rather than of the number.
///
/// The number itself lives where it always did: in EmployeeSalary, which is
/// what payroll reads and which is already effective-dated, so a revision
/// dated 1 July leaves June paying June's salary. This row is the paperwork
/// around it - what it was, what it became, who approved it and why - and it
/// points at the EmployeeSalary row it opened so the two can never disagree.
model SalaryRevision {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// The salary in force before the revision. Null for a first salary.
  previousSalaryId String?
  /// The salary record this revision opened.
  salaryId         String? @unique

  salaryType PayrollSalaryType @default(MONTHLY)
  currency   String            @db.Char(3)

  currentAmount    Decimal @db.Decimal(14, 2)
  newAmount        Decimal @db.Decimal(14, 2)
  /// Stored rather than derived so a reviewer reads the figures the decision
  /// was actually made with, even if a salary row is later corrected.
  incrementAmount  Decimal @db.Decimal(14, 2)
  /// Percentage of the previous salary, to two decimals. Zero when there was
  /// no previous salary to be a percentage of.
  incrementPercent Decimal @db.Decimal(8, 2)

  effectiveDate DateTime @db.Date

  reason String
  notes  String?

  /// Who signed it off. The user id when it was someone with an account, and
  /// the name as typed either way - a director who approved it by email has no
  /// login here and the record still has to say who they were.
  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salary   EmployeeSalary? @relation("RevisionSalary", fields: [salaryId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@index([companyId, effectiveDate])
  @@map("salary_revisions")
}

// ---------------------------------------------------------------------- loans

/// Where a loan is in its life.
///
/// The distinction that matters to payroll is exactly one: only ACTIVE and
/// COMPLETED loans have ever produced a deduction, and only an ACTIVE one can
/// produce another. PENDING and REJECTED cost nobody anything.
enum EmployeeLoanStatus {
  /// Applied for by the employee, awaiting a decision.
  PENDING
  /// Decided in favour but not yet released - the schedule exists, deductions
  /// start when it is activated.
  APPROVED
  REJECTED
  /// Being repaid. This is the only status payroll deducts against.
  ACTIVE
  /// Fully repaid.
  COMPLETED
  /// Withdrawn or written off before completion.
  CANCELLED
}

/// What was lent. A salary advance is pay handed over early: the whole amount
/// comes back from one payslip, its ceiling is a share of one month's salary
/// rather than a multiple of it, and a payslip names it separately from a
/// loan repayment. Everything else - approval, release, collection - is the
/// loan machinery unchanged.
enum LoanKind {
  LOAN
  SALARY_ADVANCE
}

enum LoanInstallmentStatus {
  SCHEDULED
  /// Claimed by a payroll run that has not been finalized yet.
  PENDING_PAYROLL
  /// Deducted by a finalized payroll run.
  PAID
  /// Deliberately not collected, without ending the loan.
  WAIVED
  SKIPPED
}

/// A loan or salary advance.
///
/// Two ways in and one way out: an administrator creates one directly, or an
/// employee applies and someone approves it. Either way the repayment schedule
/// is generated up front, so "what is left?" is a sum over rows rather than a
/// figure someone maintains by hand.
model EmployeeLoan {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  kind LoanKind @default(LOAN)

  reference String?

  principalAmount Decimal @db.Decimal(14, 2)
  currency        String  @db.Char(3)

  installmentCount Int
  /// What is taken each month. Held rather than derived because the last
  /// installment usually differs by a few cents and the schedule carries the
  /// exact figures.
  monthlyDeduction Decimal @db.Decimal(14, 2)

  /// The month the first deduction falls in, pinned to the first of the month.
  startMonth DateTime @db.Date

  status EmployeeLoanStatus @default(PENDING)

  purpose String?
  notes   String?

  /// Set when an employee applied for it rather than HR creating it outright.
  requestedByUserId String?
  requestedAt       DateTime?
  approvalRequestId String?   @unique

  approvedByUserId String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?

  /// When repayment actually began, i.e. when the loan went ACTIVE.
  activatedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  installments EmployeeLoanInstallment[]

  @@index([companyId, status])
  @@index([employeeId, status])
  @@index([companyId, kind])
  @@map("employee_loans")
}

/// One scheduled repayment.
///
/// The payment history and the outstanding balance are both this table read
/// two ways, which is why neither is stored on the loan: a running total that
/// is maintained separately is a running total that eventually disagrees.
model EmployeeLoanInstallment {
  id         String @id @default(cuid())
  companyId  String
  loanId     String
  employeeId String

  /// 1-based position in the schedule.
  sequence Int
  /// The month this installment belongs to, pinned to the first of the month.
  dueMonth DateTime @db.Date

  amount Decimal @db.Decimal(14, 2)

  status LoanInstallmentStatus @default(SCHEDULED)

  /// The run that collected it. Cleared when a run is recalculated or
  /// cancelled, exactly as PayrollAdjustment.appliedRunId is.
  payrollRunId String?
  paidAt       DateTime?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loan     EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  run      PayrollRun?  @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@unique([loanId, sequence])
  @@index([employeeId, dueMonth])
  @@index([companyId, status, dueMonth])
  @@index([payrollRunId])
  @@map("employee_loan_installments")
}

/// The company-wide loan policy, as one immutable version.
///
/// Rows are never edited. Saving a change writes a NEW row with its own
/// `effectiveFrom`, and the policy in force at an instant is the newest row at
/// or before it. Three things fall out of that, and each is the reason for it:
///
///   - An existing loan stays explicable. The rules that governed an
///     application are the version in force when it was submitted, and that
///     version is still on file, unedited, however often the policy has moved
///     since. Nothing here ever rewrites a schedule or an installment.
///   - The change history needs no second table. It is this table read in
///     order, with the field-level difference between neighbours derived on
///     read - so the log cannot disagree with the values it describes.
///   - A change can be announced before it bites, by giving it a future
///     `effectiveFrom`.
///
/// Every threshold is configuration. Nothing in the eligibility engine carries
/// a literal for any of these.
model LoanPolicy {
  id        String @id @default(cuid())
  companyId String

  // --- eligibility ----------------------------------------------------------
  /// Ceiling on the principal, as a multiple of monthly salary. Never stored
  /// against an employee: the maximum is recomputed from the salary in force
  /// and the policy in force each time it is asked for.
  maxSalaryMultiplier Decimal @default(1) @db.Decimal(6, 2)
  minEmploymentMonths Int     @default(3)
  minSalary           Decimal @default(0) @db.Decimal(14, 2)

  // --- eligible employment statuses ----------------------------------------
  // One switch per value of EmploymentStatus, read against the employee's own
  // `employmentStatus` column. Three booleans rather than a set column because
  // that is the shape the medical policy already uses for the same question,
  // and because a per-status switch is what the settings screen renders.
  //
  // No status is refused in code. An internship is not inherently ineligible
  // for a loan - it is ineligible when a company says so, which is what the
  // default below says and what a company may change.

  /// Probation cover. Also governs the probation signals the enum does not
  /// carry: an ACTIVE probation contract and a confirmation date still ahead.
  allowProbation Boolean @default(false)
  allowPermanent Boolean @default(true)
  allowInternee  Boolean @default(false)

  // --- attendance -----------------------------------------------------------
  minAttendancePercent  Decimal @default(90) @db.Decimal(5, 2)
  maxUnapprovedAbsences Int     @default(3)
  maxLateDays           Int     @default(10)
  maxMissingPunches     Int     @default(3)
  /// How many COMPLETED calendar months the attendance rules look back over.
  /// Completed on purpose: a part-finished month is not evidence of anything.
  evaluationMonths      Int     @default(3)

  // --- loan shape -----------------------------------------------------------
  maxMonthlyDeductionPercent Decimal @default(30) @db.Decimal(5, 2)
  maxTenureMonths            Int     @default(12)
  maxInstallments            Int     @default(12)
  oneActiveLoan              Boolean @default(true)
  onePendingLoan             Boolean @default(true)

  // --- salary advance -------------------------------------------------------
  /// Ceiling on an advance, as a percent of one month's salary. An advance is
  /// recovered from a single payslip, so this - not the monthly deduction
  /// ceiling, which it would always exceed - is what bounds it.
  advanceMaxSalaryPercent    Decimal @default(50) @db.Decimal(5, 2)

  // --- employment status ----------------------------------------------------
  blockTerminated Boolean @default(true)
  blockResigned   Boolean @default(true)

  // --- override -------------------------------------------------------------
  allowHrOverride       Boolean @default(true)
  requireOverrideReason Boolean @default(true)

  /// When this version starts. The seeded first version uses the epoch so that
  /// every application ever made has a policy in force behind it.
  effectiveFrom DateTime

  createdAt DateTime @default(now())
  /// Null for the version seeded on first read, which nobody authored.
  createdBy String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// One version per instant per company. Two administrators saving at once
  /// cannot produce two policies in force at the same moment - the second
  /// write fails rather than making "the current policy" a matter of ordering.
  @@unique([companyId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("loan_policies")
}

// -------------------------------------------------- phase 11: medical benefit

/// What a medical claim can be made against.
///
/// A fixed list rather than free text: each category carries limits and a
/// contribution split of its own, so it has to be something a policy can be
/// configured for. Mirrored exactly by MEDICAL_CATEGORIES in
/// packages/shared/src/dto/medical-policy.ts.
enum MedicalCategory {
  OPD
  HOSPITALIZATION
  MEDICINES
  DIAGNOSTICS
  DENTAL
  OPTICAL
  EMERGENCY
}

/// Who a dependent is to the employee. Deliberately three values: the policy
/// configures coverage per relationship, so a relationship it cannot express is
/// a relationship it cannot cover.
enum MedicalDependentRelationship {
  SPOUSE
  CHILD
  PARENT
}

/// Whether a dependent is still to be considered. INACTIVE rather than deleted,
/// so a dependent who was covered when a claim was paid can still be named by
/// that claim.
enum MedicalDependentStatus {
  ACTIVE
  INACTIVE
}

/// What a supporting document is.
///
/// Mirrors the policy's document requirements one for one, so "require a
/// receipt" can be checked by asking whether a RECEIPT is attached rather than
/// by reading a free-text label and hoping.
enum MedicalClaimDocumentType {
  RECEIPT
  PRESCRIPTION
  /// A diagnosis, discharge summary or other treatment document.
  DIAGNOSIS
  OTHER
}

/// Where a medical claim is in its life.
///
/// The order below is not the order a claim moves through: a claim is submitted
/// PENDING and then reaches exactly one of the rest, which is why every other
/// state is terminal apart from APPROVED and PARTIALLY_APPROVED, and those go
/// only to PAID.
enum MedicalClaimStatus {
  /// Submitted and awaiting a decision. Costs the company nothing and is
  /// deliberately NOT counted against the annual limit.
  PENDING
  APPROVED
  /// Approved for less than was asked for.
  PARTIALLY_APPROVED
  REJECTED
  /// Withdrawn by the employee before a decision.
  CANCELLED
  /// Approved and paid out.
  PAID
}

/// The company-wide medical policy, as one immutable version.
///
/// Rows are never edited. Saving a change writes a NEW row with its own
/// `effectiveFrom`, and the policy in force at an instant is the newest row at
/// or before it. Three things fall out of that, and each is the reason for it:
///
///   - A decided claim stays explicable. The rules that governed it are the
///     version in force when it was submitted, and that version is still on
///     file, unedited, however often the policy has moved since. Nothing here
///     ever rewrites a claim.
///   - The change history needs no second table. It is this table read in
///     order, with the field-level difference between neighbours derived on
///     read - so the log cannot disagree with the values it describes.
///   - A change can be announced before it bites, by giving it a future
///     `effectiveFrom`.
///
/// Every limit, percentage and deadline is configuration. Nothing in the
/// eligibility engine carries a literal for any of these, and no amount here
/// carries a currency: amounts are in the company's own currency, read from
/// `Company.currency` exactly as payroll and loans read it.
model MedicalPolicy {
  id        String @id @default(cuid())
  companyId String

  // --- general --------------------------------------------------------------
  /// The master switch. Off makes every employee ineligible, whatever the rest
  /// of the policy says, and is how a company suspends the benefit without
  /// losing the configuration behind it.
  enabled     Boolean @default(true)
  policyName  String  @default("Company Medical Benefit")
  description String  @default("")

  // --- eligibility ----------------------------------------------------------
  minEmploymentMonths Int @default(3)

  // One switch per value of EmploymentStatus, read against the employee's own
  // `employmentStatus` column - the same column the loan policy reads. The
  // first two already existed and are unchanged; allowInternee completes the
  // set so an internship is a configured decision rather than an omission.
  allowProbation Boolean @default(false)
  allowPermanent Boolean @default(true)
  allowInternee  Boolean @default(false)

  blockResigned   Boolean @default(true)
  blockTerminated Boolean @default(true)

  // --- annual benefit -------------------------------------------------------
  /// The yearly entitlement per employee, in the company's currency.
  annualLimitPerEmployee Decimal @default(100000) @db.Decimal(14, 2)

  // --- dependents -----------------------------------------------------------
  spouseCovered                Boolean @default(true)
  childrenCovered              Boolean @default(true)
  maxChildren                  Int     @default(4)
  parentsCovered               Boolean @default(false)
  maxParents                   Int     @default(2)
  /// True: dependents draw on the employee's annual limit. False: they have
  /// `dependentAnnualLimit` of their own.
  dependentsShareEmployeeLimit Boolean @default(true)
  dependentAnnualLimit         Decimal @default(0) @db.Decimal(14, 2)

  // --- document requirements ------------------------------------------------
  requireReceipt       Boolean @default(true)
  requirePrescription  Boolean @default(false)
  requireDiagnosis     Boolean @default(false)
  requireHospitalName  Boolean @default(true)
  requireTreatmentDate Boolean @default(true)

  // --- claim rules ----------------------------------------------------------
  claimSubmissionDeadlineDays Int     @default(30)
  allowBackdatedClaims        Boolean @default(true)
  maxBackdatedDays            Int     @default(30)
  requireHrApproval           Boolean @default(true)
  allowPartialApproval        Boolean @default(true)
  allowEmployeeCancelPending  Boolean @default(true)
  allowHrOverride             Boolean @default(true)
  requireOverrideReason       Boolean @default(true)

  // --- carry forward --------------------------------------------------------
  /// Configuration only. Nothing computes a carried balance: the benefit summary
  /// deliberately does not add one, because a carried figure has to be struck
  /// from a closed year and this product has no year-end close to strike it at.
  /// Stored so the intent survives until there is one.
  allowCarryForward     Boolean @default(false)
  maxCarryForwardAmount Decimal @default(0) @db.Decimal(14, 2)

  /// When this version starts. The seeded first version uses the epoch so that
  /// every claim ever made has a policy in force behind it.
  effectiveFrom DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Null for the version seeded on first read, which nobody authored.
  createdBy String?

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories MedicalPolicyCategory[]
  claims     MedicalClaim[]

  /// One version per instant per company. Two administrators saving at once
  /// cannot produce two policies in force at the same moment - the second
  /// write fails rather than making "the current policy" a matter of ordering.
  @@unique([companyId, effectiveFrom])
  @@index([companyId, effectiveFrom])
  @@map("medical_policies")
}

/// One category's settings within one policy version.
///
/// A child table rather than thirty-five columns on the policy: the seven
/// categories carry identical settings, and a column per category per setting
/// would make adding an eighth a migration instead of a row. Immutable with its
/// parent - a new policy version writes a new set of these.
model MedicalPolicyCategory {
  id       String @id @default(cuid())
  policyId String

  category MedicalCategory
  enabled  Boolean         @default(true)

  /// Null: this category has no cap of its own, and only the employee's annual
  /// limit binds. Distinct from zero, which is a cap of nothing.
  annualLimit    Decimal? @db.Decimal(14, 2)
  /// Null: no ceiling on a single claim.
  maxClaimAmount Decimal? @db.Decimal(14, 2)

  /// How one claim is divided. The two are validated to total 100 before a
  /// version is written, so no part of a claim belongs to nobody.
  companyContributionPercent  Decimal @default(100) @db.Decimal(5, 2)
  employeeContributionPercent Decimal @default(0) @db.Decimal(5, 2)

  policy MedicalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, category])
  @@index([policyId])
  @@map("medical_policy_categories")
}

/// HR's per-employee decision about the medical benefit. See
/// `Employee.medicalEligibilityOverride`.
enum MedicalEligibilityOverride {
  ELIGIBLE
  NOT_ELIGIBLE
}

/// Somebody an employee's medical benefit may extend to.
///
/// Deliberately thin. A name, a relationship, a date of birth and a status is
/// everything the policy needs to decide coverage; there is no condition, no
/// diagnosis and no document here, and none is needed to answer "who does this
/// cover".
///
/// Coverage is NOT stored. Whether a dependent is covered is derived on read
/// from the policy in force - the maximum number of children can change, and a
/// stored flag would go on describing the policy as it was on the day the
/// record was created. So a fourth child under a three-child policy is recorded
/// and is simply not covered, which is also what makes raising the maximum
/// cover them without anybody re-keying anything.
model MedicalDependent {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  name         String
  relationship MedicalDependentRelationship
  dateOfBirth  DateTime?                    @db.Date
  gender       Gender?
  status       MedicalDependentStatus       @default(ACTIVE)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  claims   MedicalClaim[]

  @@index([companyId, employeeId])
  /// Coverage is decided in registration order, so the order has to be a
  /// stable, indexed one rather than whatever the planner returns.
  @@index([employeeId, relationship, createdAt])
  @@map("medical_dependents")
}

/// A medical claim.
///
/// Two columns carry the weight of this table, and both are deliberate:
///
///   - `policyId` pins the version the claim was submitted under. A claim
///     decided last March stays measured by March's rules however often the
///     policy has moved since - the limit it was judged against, the category
///     cap and the contribution split are all read from that version. That is a
///     column rather than a convention precisely because re-reading the live
///     policy would silently re-judge a decided claim.
///   - `companyAmount` is the figure that consumes the annual limit, and it is
///     stored rather than derived. The employee's own share never drew on their
///     entitlement, so the benefit summary sums this and not `approvedAmount`.
///
/// A claim is decided by a holder of `medical.claim.approve`, NOT through the
/// ordinary approval chain. That chain runs through the employee's line manager,
/// and a manager has no business seeing what treatment somebody had. It is the
/// only place in this product that departs from the house approval pattern.
model MedicalClaim {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// The reference people quote. Generated per company from the same
  /// highest-so-far rule employee numbers use, and unique within the company.
  claimNumber String

  /// Null when the claim is for the employee themselves.
  dependentId String?

  category      MedicalCategory
  /// When the treatment happened.
  ///
  /// Nullable because `requireTreatmentDate` is a policy switch, and a column
  /// that cannot be empty would make switching it off unimplementable - which
  /// is the hardcoded-rule failure this module exists to avoid. Every date rule
  /// (the submission deadline, backdating, which benefit year it lands in) is
  /// simply not applied when there is no date, and the policy that allowed the
  /// blank is the one on file against the claim.
  treatmentDate DateTime?       @db.Date
  /// Where the treatment happened. Required or not by the policy in force.
  providerName  String?
  /// What the claim is for, in the claimant's words. Deliberately free text and
  /// deliberately optional: nothing here asks anybody to disclose a condition.
  notes         String?

  requestedAmount Decimal  @db.Decimal(14, 2)
  /// Set when a decision has been made. Null while PENDING.
  approvedAmount  Decimal? @db.Decimal(14, 2)
  /// The split of `approvedAmount`, resolved from the category's contribution
  /// percentages at the moment of the decision. `companyAmount` is the figure
  /// that counts against the annual limit - the employee's own share never
  /// consumed any of their entitlement.
  companyAmount   Decimal? @db.Decimal(14, 2)
  employeeAmount  Decimal? @db.Decimal(14, 2)

  status MedicalClaimStatus @default(PENDING)

  /// The policy version in force when the claim was submitted. Never updated:
  /// re-pointing it at a newer version would silently re-judge a decided claim.
  policyId String

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  reviewedByUserId String?
  /// What the reviewer said when deciding. Shown to the claimant.
  decisionNote     String?
  rejectionReason  String?
  /// Why an authorised user allowed a claim the rules refused. Mandatory when
  /// the policy in force says so.
  overrideReason   String?

  cancelledByUserId String?
  /// Who recorded the payment, and against what. Separate from the approver:
  /// agreeing that money is owed and recording that it went out are two acts,
  /// the same way a loan is approved by one person and released by another.
  paidByUserId      String?
  paymentReference  String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dependent MedicalDependent?      @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  policy    MedicalPolicy          @relation(fields: [policyId], references: [id])
  documents MedicalClaimDocument[]

  /// One claim number per company. The generator reads the highest so far, so
  /// this index is what actually guarantees uniqueness under a race.
  @@unique([companyId, claimNumber])
  @@index([companyId, status])
  /// The benefit summary's query: this employee's consuming claims in a year.
  @@index([employeeId, status, treatmentDate])
  @@index([policyId])
  @@map("medical_claims")
}

/// Proof attached to a claim.
///
/// This product has no file storage, so what is recorded is the DOCUMENT
/// rather than the file: its type and the reference printed on it - a receipt
/// number, an invoice number, a prescription number. That is enough to make the
/// policy's document requirements enforceable (a claim that must carry a
/// receipt is refused until a RECEIPT row exists) and enough to reconcile a
/// payment against paperwork held elsewhere.
///
/// When a file store lands, a nullable file reference joins this row. It is
/// deliberately not here yet: a column nothing can fill is a promise the system
/// cannot keep.
model MedicalClaimDocument {
  id        String @id @default(cuid())
  companyId String
  claimId   String

  type      MedicalClaimDocumentType
  /// The number printed on the document. Free text - a receipt number is
  /// whatever the clinic decided to print.
  reference String
  note      String?

  createdBy String?
  createdAt DateTime @default(now())

  claim MedicalClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([companyId, type])
  @@map("medical_claim_documents")
}

// ------------------------------------------------------- celebration greetings

/// Which celebration a greeting was sent for.
///
/// The same three the dashboard shows. Kept as an enum rather than inferred
/// from the date, because a person can have a birthday and an anniversary on
/// the same day and the two greetings are not the same greeting.
enum MomentOccasion {
  BIRTHDAY
  ANNIVERSARY
  NEW_JOINER
}

/// One colleague wishing another a happy birthday, a happy work anniversary,
/// or a warm welcome.
///
/// The row is keyed by the OCCASION rather than by the moment it was written,
/// and that is what makes "you have already greeted them" a fact the database
/// enforces instead of a check the UI hopes to have done. `occasionDate` is the
/// day the occasion falls on - today for a birthday or an anniversary, and the
/// HIRE DATE for a new joiner, whose welcome window runs five working days. A
/// welcome is therefore one per joiner however many days of that window the
/// sender saw, while next year's birthday is a new occasion and a new greeting.
///
/// Nothing here decides WHO may be greeted. The server re-derives the sender's
/// own celebration lists and refuses anybody who is not on one of them today,
/// so this cannot be used to send a message to an arbitrary employee.
model MomentGreeting {
  id        String @id @default(cuid())
  companyId String

  /// Who is being celebrated.
  recipientEmployeeId String
  /// Who sent the greeting.
  senderEmployeeId    String

  occasion     MomentOccasion
  /// The day the occasion falls on - see the model note.
  occasionDate DateTime       @db.Date

  /// The greeting itself: one of the suggested lines, or the sender's own.
  message String

  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipient Employee @relation("MomentGreetingRecipient", fields: [recipientEmployeeId], references: [id], onDelete: Cascade)
  sender    Employee @relation("MomentGreetingSender", fields: [senderEmployeeId], references: [id], onDelete: Cascade)

  /// One greeting per sender, per person, per occasion.
  @@unique([recipientEmployeeId, senderEmployeeId, occasion, occasionDate], map: "moment_greetings_recipient_sender_occasion_date_key")
  /// How the dashboard counts a person's greetings for today.
  @@index([recipientEmployeeId, occasion, occasionDate])
  @@index([companyId, occasionDate])
  @@map("moment_greetings")
}

// -------------------------------------------------------- cases (helpdesk)

/// How badly a case needs attention, in the requester's own judgement.
///
/// Set by whoever raises the case and re-settable by an agent in phase 2. Four
/// levels rather than three or five: three cannot separate "I am blocked" from
/// "the building is on fire", and five produces a middle nobody can tell apart.
enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Where a case is in its life.
///
/// Two of these are easy to confuse and mean opposite things about whose move
/// it is, so they are stated here rather than left to a UI label:
///
///   PENDING  waiting on the REQUESTER. Nothing happens until they answer.
///   ON_HOLD  waiting on anything else - a part, a vendor, a change window.
///
/// The transitions between them live in one place, `CASE_STATUS_TRANSITIONS` in
/// `packages/shared/src/dto/cases.ts`, and the server refuses anything that map
/// does not allow. Phase 1 uses exactly one edge of it - a requester reopening
/// their own settled case - and defines the rest so phase 2 adds screens rather
/// than columns.
enum CaseStatus {
  /// Raised and not yet picked up. Every new case starts here.
  OPEN
  IN_PROGRESS
  /// Waiting on the requester.
  PENDING
  /// Waiting on something outside the team.
  ON_HOLD
  RESOLVED
  CLOSED
  /// Was settled, and came back. Deliberately its own status rather than a
  /// return to OPEN: a case that has been through this once is not the same
  /// thing as a case nobody has looked at, and a queue should be able to see
  /// the difference.
  REOPENED
}

/// One routing queue, as ordinary configuration rather than as an enum.
///
/// The tree is Department -> Category -> Subcategory, and it is TWO levels of
/// this table under one existing department: a row with no parent is a
/// category, a row with a parent is a subcategory of it. One self-referencing
/// table rather than two, because the two levels carry identical fields and
/// differ only in depth - and because a company that eventually wants a third
/// level gets it without a migration.
///
/// The department is a real `departments` row, never a name copied in here. A
/// helpdesk that kept its own department list would drift from the real one
/// inside a release, and "IT" on a case would stop meaning the IT department.
///
/// Nothing here is seeded into the frontend. The web app renders whatever the
/// catalogue endpoint returns and knows none of the names, so phase 2's admin
/// screen is a CRUD form over this table and changes no other code.
model CaseCategory {
  id        String @id @default(cuid())
  companyId String

  /// The existing department this queue belongs to.
  departmentId String

  /// Null for a category; set for a subcategory of that category.
  parentCategoryId String?

  name        String
  description String?

  /// Display order within its level. Ties fall back to name, so a catalogue
  /// nobody has ordered still comes out the same way twice.
  sortOrder Int @default(0)

  /// Retired rather than deleted. A category with cases behind it cannot be
  /// removed without orphaning them, and the history of why a case was routed
  /// somewhere is worth more than a tidy list.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  parent     CaseCategory?  @relation("CaseCategoryTree", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  children   CaseCategory[] @relation("CaseCategoryTree")

  casesAsCategory    Case[] @relation("CaseCategory")
  casesAsSubcategory Case[] @relation("CaseSubcategory")

  /// One name per level, per department.
  ///
  /// Honest about what this does and does not enforce: PostgreSQL treats NULLs
  /// as distinct, so this constrains SUBCATEGORIES (which always have a parent)
  /// and cannot constrain top-level categories, whose parent is null. Duplicate
  /// top-level names are refused in the service layer instead - the same place
  /// the department hierarchy refuses a cycle, and for the same reason: the
  /// database cannot express the rule and pretending otherwise is worse than
  /// stating where it lives.
  @@unique([departmentId, parentCategoryId, name])
  /// The catalogue endpoint's query: this company's live queues, in order.
  @@index([companyId, isActive, sortOrder])
  @@index([departmentId, isActive])
  @@index([parentCategoryId])
  @@map("case_categories")
}

/// One case: somebody asked for something to be done, and here is where it got to.
///
/// Not an approval. Every other request in this product ends in a decision, and
/// the shared approval engine models exactly that; a case ends in work, and the
/// states worth knowing about are the ones in the middle. Routing it through
/// the approval chain would have produced a queue of PENDING approvals nobody
/// could act on and a conversation with nowhere to live.
///
/// The requester is an EMPLOYEE and the assignee is a USER, and the asymmetry
/// is deliberate rather than an oversight. A case is raised about somebody's
/// working life, which is a fact about their employee record - their department,
/// their manager, their payroll. It is worked by whoever is signed in and holds
/// the grant, which is a fact about an account. Phase 1 never sets an assignee;
/// the column is here so phase 2 fills it rather than migrating for it.
model Case {
  id        String @id @default(cuid())
  companyId String

  /// The reference people quote: `CASE-2026-000001`. Generated per company from
  /// the highest number issued in that YEAR, and unique within the company -
  /// see the unique index below, which is what actually holds under a race.
  ///
  /// Deliberately not the id. The id is a cuid, which is right for a primary
  /// key and unreadable down a phone line, and a case number is read aloud
  /// constantly.
  caseNumber String

  /// Who raised it. The whole of the employee-side security story: every
  /// employee query is pinned to this column, resolved from the session.
  requesterEmployeeId String

  /// Where it was filed. Carried on the case as well as on the category so a
  /// queue can be re-parented later without rewriting the cases it holds, and
  /// so the commonest list query - this department's open cases - is one index.
  departmentId String

  categoryId    String
  /// Absent when the chosen category has no subcategories, which is ordinary.
  subcategoryId String?

  subject     String
  description String

  priority CasePriority @default(NORMAL)
  status   CaseStatus   @default(OPEN)

  /// Null until somebody picks it up.
  assignedUserId String?
  /// When the current assignee was given it. Cleared with the assignee; the
  /// full history of hand-overs is the `case.assign` audit trail.
  assignedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the last message was added, of any kind.
  ///
  /// Here because a reply does not otherwise touch this row, so `updatedAt`
  /// would not move and a list sorted by "last updated" would show a case that
  /// has been talked about all morning as untouched since it was raised.
  lastMessageAt DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester   Employee      @relation("CaseRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  department  Department    @relation(fields: [departmentId], references: [id])
  category    CaseCategory  @relation("CaseCategory", fields: [categoryId], references: [id])
  subcategory CaseCategory? @relation("CaseSubcategory", fields: [subcategoryId], references: [id])
  /// SetNull rather than Cascade: deleting the account of somebody who left
  /// must not delete the cases they were working on.
  assignedTo  User?         @relation("CaseAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  messages    CaseMessage[]
  attachments CaseAttachment[]

  /// One case number per company. The generator reads the highest so far, so
  /// this index is what actually guarantees uniqueness under a race - the
  /// generator retries on it rather than trusting its own read.
  @@unique([companyId, caseNumber])
  /// The employee's own list, filtered and sorted. Their whole side of the
  /// module is this index.
  @@index([requesterEmployeeId, status, createdAt])
  @@index([companyId, status, createdAt])
  /// Phase 2's queue: a department's open cases, worst first.
  @@index([companyId, departmentId, status, priority])
  @@index([companyId, categoryId])
  @@index([assignedUserId, status])
  @@index([companyId, updatedAt])
  @@map("cases")
}

/// One message on a case. The conversation, and the audit trail people read.
///
/// `isInternal` is what makes this table usable by both sides of the desk. A
/// note an agent writes to another agent lives in the same thread as the
/// replies it is about, because a note that scrolls somewhere else is a note
/// nobody reads - and it is filtered out of every employee-facing query rather
/// than hidden at render time, so it is absent from the response, not merely
/// invisible in it. Phase 2 exposes the UI for writing one; the employee
/// endpoints write `false` unconditionally and take no flag from the body.
model CaseMessage {
  id        String @id @default(cuid())
  companyId String
  caseId    String

  /// Who wrote it. Null for a message the system wrote about itself - a status
  /// change, say - which is why these are one stream rather than two tables.
  senderUserId String?

  message String

  /// Staff-only. Never true on anything an employee is sent.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case    Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender  User?   @relation("CaseMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  attachments CaseAttachment[]

  /// How a case detail reads its thread: this case, oldest first, and - for an
  /// employee - only the messages that are not notes.
  @@index([caseId, isInternal, createdAt])
  @@index([companyId, createdAt])
  @@map("case_messages")
}

/// A file on a case.
///
/// The bytes live in the object store, exactly as an employee photo does, and
/// this row is the only thing that knows where. Four rules hold it together:
///
///   - `objectKey` is generated server-side from a UUID and is never built from
///     anything a client sent. `fileName` is a LABEL - what to show and what to
///     put in Content-Disposition - and has no bearing on where the file lives,
///     so a hostile name has nowhere to land.
///   - `contentType` is sniffed from the file's own leading bytes, not taken
///     from the request, and it is the type the file is served back as.
///   - the key is never sent to a browser. Downloads go through an endpoint
///     that re-checks the case against the caller, so a file is exactly as
///     private as the case it belongs to.
///   - `isInternal` mirrors the message it arrived on, so a file attached to a
///     note is as invisible to the requester as the note is.
model CaseAttachment {
  id        String @id @default(cuid())
  companyId String
  caseId    String

  /// The reply it arrived with. Null when it was attached to the case itself,
  /// which is what the create form does.
  messageId String?

  uploadedByUserId String?

  /// The display name, sanitised. Never a path and never used to build one.
  fileName    String
  /// Sniffed from the bytes. What the file is served back as.
  contentType String
  sizeBytes   Int

  /// Object-store key, e.g. `case-attachments/<companyId>/<caseId>/<uuid>.pdf`.
  /// Never a filesystem path, and never sent to a browser.
  objectKey String

  /// Attached to a staff-only note. Filtered out of employee responses.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message    CaseMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("CaseAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  /// The detail view's read, and the per-case count the upload limit checks.
  @@index([caseId, isInternal, createdAt])
  @@index([messageId])
  @@index([companyId, createdAt])
  @@map("case_attachments")
}

// ---------------------------------------------------------------- lunch

/// Where a lunch order is in its life.
///
/// Four live states and one end. The four are the lunch round as it runs, and
/// the last of them is load-bearing rather than decorative: DELIVERED is the
/// line after which an order can no longer simply be called off, because the
/// food has been eaten. Everything before it can be.
///
/// CANCELLED is the one that carries weight, and it carries it in two places:
/// every figure on the collection screen ignores cancelled orders, and so does
/// the count of plates the kitchen is told to make.
///
/// What CANCELLED does NOT do is erase a payment. An order paid for and then
/// cancelled keeps `paymentStatus = PAID` and gains a `refundStatus` beside it.
/// Losing the fact that money changed hands is the one outcome a cash system
/// must never produce.
enum LunchOrderStatus {
  ORDERED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

/// What happened to the money when a PAID order was cancelled.
///
/// The payment stays PAID and this records the decision taken beside it, so
/// that "the money went back" and "the money stayed in the box" are different
/// rows rather than the same row read two ways.
///
/// RETAINED is a value rather than the absence of one deliberately: "paid,
/// cancelled, nobody has said" and "paid, cancelled, and we agreed I keep it"
/// are the same record if the decision is only ever inferred, and the second is
/// something somebody agreed to and should be able to point at.
enum LunchRefundStatus {
  NONE
  REFUNDED
  RETAINED
}

/// Whether the money has arrived. Every order starts UNPAID - an order is a
/// promise to pay at lunchtime, not a payment.
enum LunchPaymentStatus {
  UNPAID
  PAID
}

/// How the money arrived, in the office boy's own words.
///
/// Recorded because he reconciles a cash box at the end of the day and a
/// transfer is not in it. Note what these are NOT: they are not channels the
/// software operates. Nothing in this module initiates, verifies or settles a
/// payment - two people exchanged money, and this is the word for how.
enum LunchPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

/// One thing that can be ordered, and what it costs today.
///
/// Ordinary configuration, like a leave type or a case category: a company
/// types its own menu and nothing in the frontend has an opinion about what is
/// on it. Retired rather than deleted, because orders point at these rows and a
/// company that stops selling chapati has not stopped having sold it on
/// Tuesday.
///
/// The price here is TODAY'S price and it is never read for a historical order.
/// Every order line copies the name and the price it was placed at, so putting
/// the karahi up by fifty rupees cannot rewrite what the office boy collected
/// last week.
model LunchMenuItem {
  id        String @id @default(cuid())
  companyId String

  name        String
  description String?

  /// Two decimals, the same precision the order lines and their totals use.
  price Decimal @db.Decimal(12, 2)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   LunchOrderItem[]

  /// One name per company. Two rows called "Biryani" at different prices is an
  /// ordering mistake waiting to happen on a dropdown sixty people use daily.
  @@unique([companyId, name])
  /// The order form's query: this company's live items, in the order they are shown.
  @@index([companyId, isActive, sortOrder])
  @@map("lunch_menu_items")
}

/// One person's lunch on one day, and the money owed for it.
///
/// Deliberately attached to nothing financial. There is no payroll link, no
/// salary deduction, no loan, no approval chain and no subsidy column, and none
/// of them is a gap: lunch is settled in cash with the office boy the same day,
/// and a deduction would put a month between ordering a biryani and accounting
/// for it. The reporting an administrator gets out of this module is a day's
/// figures, not a ledger.
///
/// Who pays and who is paid are two different kinds of thing, and the columns
/// say so. The order belongs to an EMPLOYEE, because owing for lunch is a fact
/// about a person on the roster. The payment was taken by a USER, because it is
/// an act somebody performed while signed in - and being able to name that
/// account is the whole point of recording it.
model LunchOrder {
  id        String @id @default(cuid())
  companyId String

  /// `LUNCH-2026-09-16-00042`. Per company and per DAY - see the unique index,
  /// which is what actually holds under a race; the generator reads the highest
  /// issued today and retries on it rather than trusting its own read.
  ///
  /// Per day rather than per year because an order lives for one lunchtime and
  /// the number is used to find a row on a list of sixty. The day in it says
  /// which collection the order belongs to without a lookup.
  orderNumber String

  /// Who ordered, and therefore who owes. The whole of the employee-side
  /// security story: every employee query is pinned to this column, resolved
  /// from the session and never from the request.
  employeeId String

  /// The lunch day, as a date with no time. Chosen in the COMPANY's timezone
  /// and stored at UTC midnight, the same contract every other date column in
  /// this schema keeps.
  serviceDate DateTime @db.Date

  status LunchOrderStatus @default(ORDERED)

  /// What the order came to, computed server-side from the menu prices at the
  /// moment it was placed. Nothing a client sends contributes to it.
  totalAmount Decimal @db.Decimal(12, 2)

  paymentStatus LunchPaymentStatus  @default(UNPAID)
  /// Null while unpaid. Set together with `paidAt` and `paidByUserId`, and
  /// cleared together with them when a payment is corrected back to unpaid -
  /// the three are one fact and a row carrying two of them is a row that says
  /// nobody was paid by somebody at half past one.
  paymentMethod LunchPaymentMethod?
  paidAt        DateTime?
  paidByUserId  String?

  /// "No chillies." Goes to the kitchen, not to the money.
  note String?

  // --- if it was called off ------------------------------------------------
  cancelledAt        DateTime?
  /// Who called it off. Null for an order nobody has. The employee's own
  /// cancel writes their account here too, so "cancelled by" is answerable
  /// without inferring it from who happens to hold a grant.
  cancelledByUserId  String?
  /// Why. Optional when an employee cancels their own unpaid order - they owe
  /// nobody an explanation - and COMPULSORY when an operator cancels somebody
  /// else's, which is enforced by the endpoint rather than by this column:
  /// the rule is about who is asking, and a column cannot see that.
  cancellationReason String?

  // --- and what happened to money already taken ---------------------------
  /// NONE unless a paid order was cancelled. See `LunchRefundStatus`.
  refundStatus     LunchRefundStatus @default(NONE)
  refundedAt       DateTime?
  refundedByUserId String?
  /// The operator's note on the refund decision. Never sent to the employee -
  /// they are told the decision and the cancellation reason, and this is
  /// working that belongs to the desk and the audit trail.
  refundReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// SetNull rather than Cascade: deleting the account of an office boy who has
  /// left must not delete the orders he collected for.
  paidBy      User?            @relation("LunchOrderPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  /// Both SetNull, for the same reason `paidBy` is: deleting the account of
  /// somebody who has left must not delete the orders they acted on.
  cancelledBy User?            @relation("LunchOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  refundedBy  User?            @relation("LunchOrderRefundedBy", fields: [refundedByUserId], references: [id], onDelete: SetNull)
  items       LunchOrderItem[]

  /// One order number per company. The generator retries on this constraint.
  @@unique([companyId, orderNumber])
  /// The collection screen's whole query: one company, one day, in order.
  @@index([companyId, serviceDate, status])
  /// The office boy's commonest filter - who has not paid yet, today.
  @@index([companyId, serviceDate, paymentStatus])
  /// The employee's own list, which is their entire side of this module.
  @@index([employeeId, serviceDate])
  @@map("lunch_orders")
}

/// One line of an order: what was ordered, how many, and at what price.
///
/// The name and the unit price are SNAPSHOTS, copied from the menu row when the
/// order was placed, and that is the point of this table existing rather than a
/// join. A menu price is a live setting somebody edits; what an order cost is a
/// historical fact that has already been collected against. Keeping the second
/// one behind a foreign key to the first would mean that re-pricing the karahi
/// silently changed last Tuesday's collection - and last Tuesday's collection
/// has already been counted out of a cash box and agreed.
model LunchOrderItem {
  id        String @id @default(cuid())
  companyId String
  orderId   String

  /// Where it came from. Null once that menu item is gone; the name and price
  /// below are what the order is actually made of.
  menuItemId String?

  itemName  String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  /// `unitPrice * quantity`, stored rather than derived so a line reads the
  /// same way a receipt does and so the order total is the sum of what is
  /// printed rather than of something recomputed beside it.
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order    LunchOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem LunchMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([companyId, menuItemId])
  @@map("lunch_order_items")
}

// ===========================================================================
// RECRUITMENT - job openings, candidates, interviews and offers
// ===========================================================================
//
// The one structural decision worth stating before the models: a CANDIDATE IS
// NOT AN EMPLOYEE, and nothing here writes to the employees table.
//
// Somebody applying for a job has no employee number, no department, no
// contract and no login, and forcing them into `employees` would mean every
// headcount, payroll run, attendance report and org chart in this product
// quietly counting people who have never worked here. So candidates live in
// their own table with their own lifecycle, and the ONLY bridge between the
// two is `Candidate.hiredEmployeeId` - written once, by Convert to Employee,
// after a human has reviewed the mapping.
//
// The second decision is that a candidate is not duplicated per vacancy.
// `CandidateApplication` is the join, so one person who applies for three
// roles is one row in `candidates` and three in `candidate_applications` -
// which is what lets "have we seen this person before?" be a query, and what
// stops three half-maintained copies of somebody's phone number.

/// Where a vacancy is in its life.
///
/// DRAFT is not OPEN: a half-written opening should not appear on a pipeline
/// or count towards "open positions", and the difference between "we are
/// hiring" and "somebody started typing" is a number HR reports upwards.
///
/// ON_HOLD and CANCELLED are deliberately apart from CLOSED. CLOSED is the
/// good ending - the seats were filled; CANCELLED is the vacancy going away
/// unfilled; ON_HOLD is neither, and is the state a budget freeze produces.
enum JobOpeningStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

/// How far a candidate has got, for one job.
///
/// The stage lives on the APPLICATION rather than on the candidate, because a
/// person can be shortlisted for one role and rejected for another on the same
/// afternoon, and a single stage column on the candidate could only ever record
/// one of those two facts. `Candidate.stage` exists as well and is a derived
/// summary - the furthest stage across their applications - kept for the list
/// screen, and never the thing a decision is made against.
///
/// REJECTED and WITHDRAWN are both terminal and are kept apart on purpose: who
/// ended it is exactly the question somebody asks six months later when the
/// same person applies again.
enum CandidateStage {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

/// What kind of conversation an interview is.
enum InterviewType {
  HR
  TECHNICAL
  MANAGER
  FINAL
  OTHER
}

/// Which pass through the process this is. Named rather than numbered so
/// FINAL can exist: a final round is not "round 4", it is the last one.
enum InterviewRound {
  ROUND_1
  ROUND_2
  ROUND_3
  FINAL
}

/// Where an interview stands.
///
/// COMPLETED and NO_SHOW are both endings and both keep the row. Nothing in
/// this module deletes an interview that happened - a cancelled interview is
/// CANCELLED and stays readable, because "we cancelled on this candidate
/// twice" is a fact about us, not noise to be tidied away.
enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

/// An interviewer's bottom line, in their own words.
///
/// Advice, never arithmetic. Nothing in this module adds these up, averages
/// them or moves a candidate's stage because of them - the decision belongs to
/// whoever is hiring, and an enum that silently drove the pipeline would make
/// a panel's disagreement invisible.
enum InterviewRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// What a file attached to a candidate is.
enum CandidateDocumentType {
  RESUME
  COVER_LETTER
  PORTFOLIO
  CERTIFICATE
  OTHER
}

// ------------------------------------------------------------- job openings

model JobOpening {
  id        String @id @default(cuid())
  companyId String

  /// Sequential, per company, e.g. JOB-0007. Readable in a conversation in a
  /// way a cuid is not.
  reference String

  title String

  /// Pointed at, never copied. The department and team are real organisation
  /// rows, so a vacancy answers "which part of the company is short-handed"
  /// with a join rather than with a string.
  departmentId String?
  teamId       String?
  locationId   String?

  employmentType EmploymentType @default(FULL_TIME)

  /// What the successful candidate would be hired ON: probation, permanent or
  /// an internship. The SAME canonical enum the employee record uses - there
  /// is deliberately no second employment-status field anywhere in this
  /// module, so a conversion carries the value across rather than translating
  /// it. Nullable because a vacancy that has not decided is not the same as
  /// one offering permanence.
  expectedEmploymentStatus EmploymentStatus?

  vacancies Int @default(1)

  /// The two people a vacancy belongs to. Employees, not free text, and both
  /// nullable because an opening can be drafted before either is settled.
  /// They are also what narrows this module for a manager: somebody holding
  /// only `recruitment.read` sees the openings where their own employee id is
  /// in one of these two columns.
  hiringManagerId String?
  recruiterId     String?

  description  String?
  requirements String?
  /// Free text rather than a skills table. A skills taxonomy is a product of
  /// its own, and phase 1 needs "Unity, C#, 5 years" to be searchable, which
  /// a text column with an index answers honestly.
  skills       String?

  minExperienceYears Int?

  /// Optional, and optional for a reason: plenty of companies advertise
  /// without a band. Stored as Decimal like every other money column here.
  salaryMin      Decimal? @db.Decimal(12, 2)
  salaryMax      Decimal? @db.Decimal(12, 2)
  salaryCurrency String?

  openingDate DateTime? @db.Date
  closingDate DateTime? @db.Date

  status JobOpeningStatus @default(DRAFT)

  /// Set when the status last moved to CLOSED or CANCELLED, with the reason.
  /// Kept rather than inferred from the audit log, because a list screen
  /// cannot join the audit log.
  closedAt     DateTime?
  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team          Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hiringManager Employee?   @relation("JobOpeningHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiter     Employee?   @relation("JobOpeningRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)

  applications CandidateApplication[]
  interviews   Interview[]
  offers       Offer[]

  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, teamId])
  @@index([hiringManagerId])
  @@index([recruiterId])
  @@index([companyId, openingDate])
  @@map("job_openings")
}

// ---------------------------------------------------------------- candidates

model Candidate {
  id        String @id @default(cuid())
  companyId String

  /// Sequential, per company, e.g. CAN-0042.
  reference String

  fullName String
  email    String
  phone    String?

  currentLocation String?
  linkedinUrl     String?
  portfolioUrl    String?

  skills          String?
  experienceYears Int?
  currentCompany  String?
  currentTitle    String?

  // --- restricted ------------------------------------------------------------
  // What somebody earns now, what they want, and whatever HR has written about
  // them. Readable only with `candidate.manage`; the API strips this block for
  // anybody else, which is what lets an interviewer open a candidate they are
  // meeting without being handed their salary history.
  currentSalary  Decimal? @db.Decimal(12, 2)
  expectedSalary Decimal? @db.Decimal(12, 2)
  salaryCurrency String?
  notes          String?

  /// How long they have to give their present employer, in days. A number
  /// rather than "one month" so a joining date can be worked out from it.
  noticePeriodDays Int?

  /// Where they came from: a referral, a job board, an agency. Free text,
  /// matching `Employee.sourceOfHire`, so the value survives a conversion.
  source String?

  /// The recruiter carrying this person. An employee, and one of the two
  /// columns a narrowed reader is matched against.
  recruiterId String?

  /// The furthest stage reached across this candidate's applications.
  ///
  /// DERIVED, and recomputed from `candidate_applications` whenever one of
  /// them moves. It exists so the candidate list can show and filter a stage
  /// without a per-row aggregate, and it is never what a decision reads: the
  /// application's own stage is the fact, this is a summary of several facts.
  stage CandidateStage @default(NEW)

  /// The employee this candidate became, if HR converted them.
  ///
  /// The only link between recruitment and the employee record, written once
  /// by Convert to Employee and never by anything else. Unique, so one
  /// candidate cannot be converted into two employees - the duplicate
  /// protection is a database constraint rather than a hopeful check.
  hiredEmployeeId String?   @unique
  hiredAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter     Employee? @relation("CandidateRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  hiredEmployee Employee? @relation("CandidateHiredEmployee", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)

  applications CandidateApplication[]
  interviews   Interview[]
  documents    CandidateDocument[]
  offers       Offer[]

  /// One person, one record, per company. Case-insensitivity is enforced in
  /// the service layer by storing and comparing a normalised address; the
  /// index is what makes it impossible to end up with two by racing.
  @@unique([companyId, email])
  @@unique([companyId, reference])
  @@index([companyId, stage])
  @@index([companyId, recruiterId])
  @@index([companyId, createdAt])
  @@index([companyId, fullName])
  @@map("candidates")
}

/// One person applying for one job. The join, and the thing a stage lives on.
model CandidateApplication {
  id           String @id @default(cuid())
  companyId    String
  candidateId  String
  jobOpeningId String

  stage CandidateStage @default(NEW)

  /// When the stage last moved, and who moved it. Denormalised from the audit
  /// log for the same reason `closedAt` is: a pipeline board cannot join it.
  stageChangedAt DateTime @default(now())
  stageChangedBy String?

  /// Why a terminal stage was reached. Compulsory for REJECTED and WITHDRAWN
  /// at the API, because "rejected" with no reason is the answer nobody can
  /// use when the same CV arrives again next year.
  outcomeReason String?

  appliedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate  Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  interviews Interview[]
  offers     Offer[]

  /// Applying twice for the same job is the same application.
  @@unique([candidateId, jobOpeningId])
  @@index([companyId, stage])
  @@index([jobOpeningId, stage])
  @@index([companyId, stageChangedAt])
  @@map("candidate_applications")
}

/// A file on a candidate: the CV, a cover letter, a portfolio, a certificate.
///
/// Deliberately the same shape as `CaseAttachment`, and stored through the same
/// object store: a key, a sniffed content type, a size, and a display name that
/// has no bearing on where the bytes live. Nothing here is a second file
/// storage system.
model CandidateDocument {
  id          String @id @default(cuid())
  companyId   String
  candidateId String

  type CandidateDocumentType @default(OTHER)

  uploadedByUserId String?

  /// The display name, sanitised. Never a path and never used to build one.
  fileName    String
  /// Sniffed from the bytes. What the file is served back as.
  contentType String
  sizeBytes   Int

  /// Object-store key, e.g. `candidate-documents/<companyId>/<candidateId>/<uuid>.pdf`.
  /// Never a filesystem path, and never sent to a browser.
  objectKey String

  /// A file only the HR side may read - a reference check, a background
  /// report, an internal assessment. Filtered out by the QUERY for anybody
  /// without `candidate.manage`, the way an internal case note is.
  isConfidential Boolean @default(false)

  createdAt DateTime @default(now())

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("CandidateDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([candidateId, isConfidential, createdAt])
  @@index([companyId, createdAt])
  @@map("candidate_documents")
}

// ---------------------------------------------------------------- interviews

model Interview {
  id        String @id @default(cuid())
  companyId String

  candidateId   String
  jobOpeningId  String?
  /// The application this interview is part of, where there is one. Null for
  /// an exploratory conversation held before anybody picked a vacancy.
  applicationId String?

  type  InterviewType
  round InterviewRound @default(ROUND_1)

  /// Stored as instants, in UTC, like every other time in this product. The
  /// zone below is the one the interview was ARRANGED in, kept so "10:00 AM"
  /// still reads as 10:00 to the people who agreed to it even if the company
  /// default changes or a panellist sits elsewhere.
  startsAt DateTime
  endsAt   DateTime
  timezone String

  /// A room, or an address. Free text; a meeting link is the column below.
  location    String?
  meetingLink String?

  notes String?

  status InterviewStatus @default(SCHEDULED)

  /// Filled when the interview is marked over, so "did it happen" is one
  /// column rather than an inference from the clock.
  completedAt     DateTime?
  /// Set when CANCELLED, with the reason. A cancelled interview is never
  /// deleted: it is part of how this candidate was treated.
  cancelledAt     DateTime?
  cancelledReason String?

  /// Who arranged it.
  scheduledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening  JobOpening?           @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  application CandidateApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  scheduledBy Employee?             @relation("InterviewScheduledBy", fields: [scheduledById], references: [id], onDelete: SetNull)

  participants    InterviewParticipant[]
  evaluations     InterviewEvaluation[]
  scheduleChanges InterviewScheduleChange[]

  @@index([companyId, startsAt])
  @@index([companyId, status, startsAt])
  @@index([candidateId, startsAt])
  @@index([jobOpeningId])
  @@index([applicationId])
  @@map("interviews")
}

/// One seat on an interview panel.
///
/// An interviewer is an EMPLOYEE - an existing HRMS person - and never a
/// duplicate user record. That is the whole reason this table exists rather
/// than a text column of names: it makes "show me my interviews" a query on
/// an indexed foreign key, which is what the interviewer's own screen is.
model InterviewParticipant {
  id          String @id @default(cuid())
  companyId   String
  interviewId String
  employeeId  String

  /// The panellist whose call it is, where a panel has one. Purely
  /// informational: it confers no extra permission and drives no arithmetic.
  isLead Boolean @default(false)

  /// The panellist said they will be there. Distinct from the interview's own
  /// CONFIRMED, which is about the appointment rather than about one person.
  confirmedAt DateTime?

  createdAt DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  evaluation InterviewEvaluation?

  /// One seat per person per interview.
  @@unique([interviewId, employeeId])
  /// The interviewer's own screen, and the clash check, both read this.
  @@index([employeeId])
  @@index([companyId, employeeId])
  @@map("interview_participants")
}

/// What one interviewer thought.
///
/// Hung off the PARTICIPANT rather than off the interview, and unique on it,
/// which is the database's way of saying what section 12 asks for: three
/// panellists produce three evaluations and none of them can overwrite
/// another. A missing row is "pending", which is a different and honest thing
/// from a row full of zeros.
model InterviewEvaluation {
  id            String @id @default(cuid())
  companyId     String
  interviewId   String
  participantId String

  /// Each out of ten, each optional: an HR interviewer has no business
  /// scoring technical skill, and a nulled score says "not assessed" where a
  /// zero would say "assessed, and terrible".
  technicalScore      Int?
  problemSolvingScore Int?
  communicationScore  Int?
  experienceScore     Int?
  cultureFitScore     Int?

  recommendation InterviewRecommendation

  comments String?

  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interview   Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participant InterviewParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId])
  @@index([interviewId])
  @@index([companyId, submittedAt])
  @@map("interview_evaluations")
}

/// An interview that moved, and what it moved from.
///
/// A rescheduled interview keeps its id, its panel and its evaluations - it is
/// the same appointment - so without this table the old time would simply be
/// overwritten and "you have changed this on me three times" would have no
/// evidence behind it. One row per move, with both times and the reason.
model InterviewScheduleChange {
  id          String @id @default(cuid())
  companyId   String
  interviewId String

  previousStartsAt DateTime
  previousEndsAt   DateTime
  previousTimezone String

  newStartsAt DateTime
  newEndsAt   DateTime
  newTimezone String

  reason String

  changedById String?
  createdAt   DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@map("interview_schedule_changes")
}

// -------------------------------------------------------------------- offers

/// What a candidate is being offered.
///
/// Deliberately thin. Phase 1 is not a contract system and is not payroll: the
/// proposed salary here is a NUMBER ON AN OFFER, it creates no EmployeeSalary,
/// no payroll profile and no contract, and converting a candidate does not
/// carry it into any of those. Somebody who accepts still has their pay set by
/// payroll, by a person, on purpose.
model Offer {
  id            String  @id @default(cuid())
  companyId     String
  candidateId   String
  jobOpeningId  String?
  applicationId String?

  /// The designation as an organisation row where one fits, and free text
  /// beside it for the case where it does not - the same pair the employee
  /// record carries, so a conversion can hand across whichever is set.
  designationId String?
  proposedTitle String?

  employmentType EmploymentType @default(FULL_TIME)

  /// The stage the hire would start on. Canonical `EmploymentStatus` again,
  /// and defaulted to PROBATION at the API rather than here, so a company
  /// that means something else has to say so.
  employmentStatus EmploymentStatus?

  proposedSalary Decimal? @db.Decimal(12, 2)
  salaryCurrency String?

  expectedJoiningDate DateTime? @db.Date

  status OfferStatus @default(DRAFT)

  /// The three dates an offer actually has. Kept as columns because "when did
  /// we send it" and "when did they answer" are reportable facts, not audit
  /// trivia.
  sentAt      DateTime?
  respondedAt DateTime?
  expiresAt   DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate   Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening  JobOpening?           @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  application CandidateApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  designation Designation?          @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([candidateId])
  @@index([jobOpeningId])
  @@index([applicationId])
  @@map("offers")
}

// ===========================================================================
// ASSETS - the company's equipment, who is holding it, and what state it is in
// ===========================================================================

/// Where an asset is in the company's custody. See `ASSET_STATUSES` in
/// `packages/shared/src/dto/assets.ts` for what each value commits to.
///
/// RETURNED is deliberately not a synonym for AVAILABLE: something handed back
/// has not yet been checked over, and the gap between those two facts is where
/// the missing charger is discovered.
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  LOST
  DAMAGED
  RETURNED
  RETIRED
  DISPOSED
}

/// What state the thing is actually in - never the same question as its status.
///
/// DAMAGED appears in both enums and that is not a duplication. The status says
/// "we are not issuing this to anybody"; the condition says "the screen is
/// cracked". An asset is routinely ASSIGNED and DAMAGED at the same time, which
/// is exactly why they are two columns.
enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  CRITICAL
}

/// How one spell of somebody holding an asset ended, or that it has not.
///
/// The three endings are kept apart because the question later is not "did it
/// come back" but "what happened to it": handed in, passed straight to somebody
/// else, or never seen again.
enum AssetAssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  WRITTEN_OFF
}

/// Whether the person holding an asset has said they have it.
///
/// Three states, and the third is the point: a handover where the employee says
/// "this arrived with a cracked lid" is neither acknowledged nor merely
/// un-acknowledged. A two-state flag would have to round that to one of them.
enum AssetAcknowledgementStatus {
  PENDING
  ACKNOWLEDGED
  ISSUE_REPORTED
}

enum AssetRepairStatus {
  IN_PROGRESS
  COMPLETED
  /// The repair never happened. Still ends the repair, so the asset cannot be
  /// stranded in UNDER_REPAIR forever by a job somebody called off.
  CANCELLED
}

/// Something went wrong with an asset. One shape, three writers - see
/// `AssetIncident`.
enum AssetIncidentKind {
  ISSUE_REPORTED
  DAMAGED
  LOST
}

enum AssetDisposalMethod {
  SOLD
  SCRAPPED
  DONATED
  RECYCLED
  OTHER
}

/// What a file attached to an asset is. The bytes live in the SAME object store
/// the case attachments and candidate documents use; no second file system was
/// created for this module.
enum AssetDocumentType {
  INVOICE
  PURCHASE_RECEIPT
  WARRANTY
  REPAIR_RECEIPT
  HANDOVER
  OTHER
}

/// What kind of thing an asset is. Configuration, never a hard-coded dropdown.
///
/// Two levels through a self-relation, the same shape `CaseCategory` uses: a
/// GROUP somebody reports on ("IT Equipment") and a TYPE somebody picks on a
/// form ("Laptop"). An asset may point at either level, so a company that only
/// wants "Vehicles" is not made to invent a child row it will never use.
///
/// Seeded from `DEFAULT_ASSET_CATEGORY_CATALOGUE` and the company's from that
/// moment on. Nothing in the API or the UI matches on any of those names.
model AssetCategory {
  id        String @id @default(cuid())
  companyId String

  /// Null for a group; set for a type under that group.
  parentCategoryId String?

  name        String
  description String?

  /// Display order within its level. Ties fall back to name, so a catalogue
  /// nobody has ordered still comes out the same way twice.
  sortOrder Int @default(0)

  /// Retired rather than deleted, and there is no delete endpoint at all.
  /// Assets point at categories; removing one would orphan them and lose the
  /// answer to "what did we buy under Office Equipment in 2024". Retiring takes
  /// it off the create form and leaves every asset that carries it untouched.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   AssetCategory?  @relation("AssetCategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children AssetCategory[] @relation("AssetCategoryTree")

  assets Asset[]

  /// One name per level, per company.
  ///
  /// Honest about what this does and does not enforce, exactly as
  /// `CaseCategory` is: PostgreSQL treats NULLs as distinct, so this constrains
  /// TYPES (which always have a parent) and cannot constrain groups, whose
  /// parent is null. Duplicate group names are refused in the route instead -
  /// the database cannot express the rule and pretending otherwise is worse
  /// The request lines asking for something of this kind. Restrict on the
  /// other side: a category somebody has asked for cannot be deleted out from
  /// under the request.
  requestItems AssetRequestItem[]

  /// than stating where it lives.
  @@unique([companyId, parentCategoryId, name])
  /// The catalogue endpoint's query: this company's live categories, in order.
  @@index([companyId, isActive, sortOrder])
  @@index([parentCategoryId])
  @@map("asset_categories")
}

/// One thing the company owns.
///
/// Note what is NOT on this model: any column naming the employee who has it.
/// A laptop goes to Ahmed, comes back, and goes to Sana, and a
/// `currentEmployeeId` would record the last of those three facts while
/// silently destroying the first two - which are precisely the facts somebody
/// needs when the machine turns up with a cracked screen. The holder is the
/// ACTIVE row in `asset_assignments`; everything before it is still there.
///
/// `departmentId` is a different claim and is genuinely a property of the
/// asset: which part of the company the thing BELONGS to, which survives the
/// person holding it leaving. A meeting room projector belongs to Facilities
/// whether or not anybody has signed it out.
model Asset {
  id        String @id @default(cuid())
  companyId String

  /// The label physically stuck on the thing, e.g. `IT-LAP-0042`. Unique per
  /// company, supplied rather than generated, because it has to match what is
  /// already printed on the sticker.
  assetTag String

  name String

  /// Pointed at, never copied. What kind of thing this is is a real category
  /// row, so "how many laptops" is a query.
  categoryId String

  brand String?
  model String?

  /// The manufacturer's serial. Optional - a chair has none - and unique within
  /// the company WHEN PRESENT, which the index below gives for free because
  /// PostgreSQL treats NULLs as distinct.
  serialNumber String?

  purchaseDate  DateTime? @db.Date
  /// Decimal(12,2) everywhere money appears, matching payroll, loans and lunch.
  purchasePrice Decimal?  @db.Decimal(12, 2)
  /// What it is reckoned to be worth now. A separate figure from what was paid
  /// and never derived from it: depreciation is a policy this module does not
  /// have, and a computed value nobody set would be a number reported upwards
  /// that no human agreed to.
  currentValue  Decimal?  @db.Decimal(12, 2)

  vendor String?

  warrantyStart DateTime? @db.Date
  warrantyEnd   DateTime? @db.Date

  /// Which office the thing is at - a real organisation Location, pointed at.
  locationId String?
  /// Where it is within that office: a desk, a room, a shelf. Free text on
  /// purpose, because "third floor, by the window" is not a row anybody wants
  /// to maintain in the organisation module.
  location   String?

  /// Which part of the company the asset belongs to. Not who is holding it.
  departmentId String?

  condition AssetCondition @default(GOOD)
  status    AssetStatus    @default(AVAILABLE)

  notes String?

  // --- the two endings ------------------------------------------------------
  // Columns rather than tables because an asset is retired once and disposed of
  // once. They are written by their own endpoints, never by the edit form, and
  // nothing clears them: an asset that came back from retirement keeps the
  // record of having been retired.

  /// When it was taken out of service, and why.
  retiredOn     DateTime? @db.Date
  retiredReason String?

  /// The disposal block. Set together, by `POST /assets/:id/dispose`, once.
  disposedOn           DateTime?            @db.Date
  disposalMethod       AssetDisposalMethod?
  disposalReason       String?
  disposalFinalValue   Decimal?             @db.Decimal(12, 2)
  /// Whoever in the company signed it off. An employee, pointed at rather than
  /// typed, so "who approved writing off eleven laptops" is a query.
  disposalApprovedById String?
  disposalNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a category must never delete the assets
  /// filed under it. It is also why the categories endpoint offers retirement
  /// and no delete at all.
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  site       Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  disposalApprovedBy Employee? @relation("AssetDisposalApprover", fields: [disposalApprovedById], references: [id], onDelete: SetNull)

  assignments AssetAssignment[]
  repairs     AssetRepair[]
  incidents   AssetIncident[]
  documents   AssetDocument[]

  /// The tag on the sticker is unique within the company. This is the
  /// constraint the duplicate check reports as a field error before it is ever
  /// reached, and the one that actually holds under a race.
  @@unique([companyId, assetTag])
  /// Unique WHEN PRESENT. A hundred chairs with no serial do not collide; two
  /// laptops claiming the same one do.
  @@unique([companyId, serialNumber])
  /// The register's own query: this company's assets by status, newest first.
  @@index([companyId, status])
  @@index([companyId, condition])
  @@index([companyId, categoryId])
  @@index([companyId, departmentId])
  @@index([companyId, locationId])
  @@index([companyId, createdAt])
  @@index([companyId, name])
  @@map("assets")
}

/// One spell of one employee holding one asset.
///
/// The history, and the reason there is no holder column on `assets`. A laptop
/// that has been through three people is three rows here, of which at most one
/// is ACTIVE, and none of the other two is destroyed by the next handover.
///
/// The subject is an EMPLOYEE and the two actors are USERS, and the asymmetry
/// is the same one the cases module draws: an asset is issued to somebody's
/// working life, which is a fact about their employee record, and it is handed
/// over by whoever was signed in at the counter, which is a fact about an
/// account.
///
/// AT MOST ONE ACTIVE ROW PER ASSET. That rule is enforced in the service layer
/// rather than by the database, and the reason is stated rather than hidden:
/// the constraint that would express it is a partial unique index
/// (`... WHERE status = 'ACTIVE'`), which Prisma cannot describe and would
/// therefore try to drop on the next migration. The same trade-off, and the
/// same disclosure, as the top-level name rule on `CaseCategory`.
model AssetAssignment {
  id        String @id @default(cuid())
  companyId String

  assetId    String
  employeeId String

  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  /// Who handed it over, and who took it back. Users, and nullable: an account
  /// can be deleted years after the handover, and losing the fact that the
  /// handover happened would be far worse than losing the name attached to it.
  assignedById String?
  returnedById String?

  /// The state the asset went out in, and the state it came back in.
  ///
  /// Recorded on the ASSIGNMENT rather than only on the asset, which is the
  /// whole point of writing them down: the asset carries one current condition,
  /// and the question that gets asked is "what state was it in when we gave it
  /// to him". Two columns here answer it; one column on the asset never can.
  conditionAtAssignment AssetCondition?
  conditionAtReturn     AssetCondition?

  /// What went out WITH the asset, what came back, and what did not.
  ///
  /// String arrays rather than a join table, because an accessory is a label on
  /// a handover and nothing in this product ever needs to ask a question about
  /// "all the chargers". `ASSET_ACCESSORY_SUGGESTIONS` in the shared package is
  /// what the form offers; it is a suggestion list and not a closed set, so a
  /// company that issues docking stations does not need a release to say so.
  ///
  /// `accessoriesMissing` is DERIVED at return time - issued minus returned,
  /// plus whatever else the person recording the return adds by hand - and
  /// stored rather than recomputed, so the record of what was missing on the
  /// day survives somebody later editing the issued list.
  accessoriesIssued   String[]
  accessoriesReturned String[]
  accessoriesMissing  String[]

  /// What was wrong with it when it came back, in words. Separate from the
  /// condition enum: "CRITICAL" does not tell the next person what happened.
  damageDescription String?

  /// The handover note, and the note written when it came back. Two columns,
  /// because one would mean a return overwriting what was said at issue.
  notes       String?
  returnNotes String?

  /// Why it moved on. Set on a TRANSFER, where somebody asked for this to
  /// happen and the reason is the only record of who and why.
  reason String?

  /// The handover this one succeeded, on a transfer.
  ///
  /// Unique, so one closed assignment can have at most one successor: a chain
  /// rather than a fork. It is what turns "Muhammad -> Ahmed -> Sana" into a
  /// readable sequence instead of three rows that happen to share an asset.
  previousAssignmentId String? @unique

  /// Whether the person has said they have it. PENDING until they do.
  ///
  /// On the ASSIGNMENT rather than on the asset, because it is a fact about one
  /// handover: the next person to be issued the same laptop has not
  /// acknowledged anything, and a column on the asset would say they had.
  acknowledgementStatus AssetAcknowledgementStatus @default(PENDING)
  acknowledgedAt        DateTime?
  acknowledgedById      String?

  status AssetAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy     User?    @relation("AssetAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  returnedBy     User?    @relation("AssetReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  acknowledgedBy User?    @relation("AssetAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  /// The handover this one succeeded, and the one that succeeded it.
  previous AssetAssignment? @relation("AssetAssignmentChain", fields: [previousAssignmentId], references: [id], onDelete: SetNull)
  next     AssetAssignment? @relation("AssetAssignmentChain")

  incidents AssetIncident[]

  /**
   * The approved request line this handover FULFILS, where there was one.
   * Nullable and always will be: most kit is issued because somebody asked for
   * it in person, and an assignment made that way is not less of an
   * assignment. What the column buys is the other direction - an approved
   * request can say how much of it has actually been delivered without a
   * second bookkeeping table, because the assignments ARE the delivery.
   */
  assetRequestItemId String?
  assetRequestItem   AssetRequestItem? @relation(fields: [assetRequestItemId], references: [id], onDelete: SetNull)

  /// "Who has this now" and "what has this person got", both as index lookups
  /// rather than scans. The first is read on every row of the register.
  @@index([assetId, status])
  @@index([companyId, employeeId, status])
  @@index([companyId, status])
  @@index([assetId, assignedAt])
  @@index([assetRequestItemId])
  @@map("asset_assignments")
}

/// One trip to the repairer.
///
/// Its own table rather than columns on the asset, because an asset is repaired
/// many times and the interesting question is the history: "this machine has
/// been back three times this year" is a decision about replacing it, and a
/// single set of columns could only ever remember the last trip.
///
/// `statusBeforeRepair` is the load-bearing column. Section 8 asks that
/// AVAILABLE -> UNDER_REPAIR -> AVAILABLE and ASSIGNED -> UNDER_REPAIR ->
/// ASSIGNED both hold, and this is how: the status the asset had when it left
/// is written down, and completing the repair puts it back. Without it the
/// return from repair would have to GUESS, and the guess that loses is the one
/// that quietly un-assigns a laptop somebody still has at home.
///
/// Note what a repair does NOT do: it does not close the assignment. The
/// employee still has the asset on paper while it is away being fixed, which is
/// both true and what section 8 means by "do not lose the employee assignment
/// history".
model AssetRepair {
  id        String @id @default(cuid())
  companyId String
  assetId   String

  problem String

  reportedOn       DateTime  @db.Date
  sentOn           DateTime  @db.Date
  expectedReturnOn DateTime? @db.Date
  returnedOn       DateTime? @db.Date

  vendor        String?
  estimatedCost Decimal? @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)

  /// Written when it was sent, and written when it came back. Two columns, so
  /// the outcome cannot overwrite the complaint.
  notes           String?
  completionNotes String?

  status AssetRepairStatus @default(IN_PROGRESS)

  /// What the asset goes back to when this ends. See the note above.
  statusBeforeRepair AssetStatus

  sentById      String?
  completedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset       Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sentBy      User?   @relation("AssetRepairSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  completedBy User?   @relation("AssetRepairCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  documents AssetDocument[]

  /// "Is this asset away right now" and "what has it been through", both as
  /// index lookups. The first is read on every detail page.
  @@index([assetId, status])
  @@index([assetId, sentOn])
  @@index([companyId, status])
  @@map("asset_repairs")
}

/// Something went wrong with an asset, and here is the record of it.
///
/// One table for three events of the same shape - a date, a reason, a
/// description and whoever said so. What separates them is WHO writes one and
/// what it does to the asset:
///
///   ISSUE_REPORTED - the employee holding it, from their own screen. Changes
///                    NOTHING about the asset. An employee cannot alter its
///                    condition, its value or its status, and "the charger is
///                    buzzing" must not silently do so; it raises a flag a
///                    person reads.
///   DAMAGED / LOST - somebody holding `asset.update`. Moves the asset's status
///                    and leaves this row as the reason.
///
/// Nothing here deletes an asset, which is section 9's whole instruction. A
/// lost laptop stays on the register as a LOST laptop, because "we lost eleven
/// laptops last year" is a fact about the company and not noise to be tidied.
model AssetIncident {
  id        String @id @default(cuid())
  companyId String
  assetId   String

  /// The handover this happened during, when there was one. Nullable: an asset
  /// can be found damaged in the store cupboard with nobody holding it.
  assignmentId String?

  kind AssetIncidentKind

  occurredOn  DateTime @db.Date
  reason      String
  description String?
  notes       String?

  /// Who said so. The account is always recorded; the EMPLOYEE is recorded as
  /// well when the report came from the person holding the asset, because
  /// "Ahmed reported this" is the fact somebody needs and an account id is not.
  reportedById         String?
  reportedByEmployeeId String?

  /// Closed off by somebody, with a note. An unresolved incident is the flag.
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignment         AssetAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  reportedBy         User?            @relation("AssetIncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedByEmployee Employee?        @relation("AssetIncidentEmployee", fields: [reportedByEmployeeId], references: [id], onDelete: SetNull)
  resolvedBy         User?            @relation("AssetIncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([assetId, occurredOn])
  @@index([companyId, kind])
  @@index([assignmentId])
  @@map("asset_incidents")
}

/// A file about an asset: the invoice, the warranty, a repair receipt, the
/// signed handover.
///
/// Shaped exactly like `case_attachments` and `candidate_documents` - an opaque
/// object key, a SNIFFED content type, a size and a display name with no
/// bearing on where the bytes live - because it uses the same object store.
/// Section 13 asks that no second storage system be created, and this is that
/// instruction taken literally: the only thing this table adds is the column
/// naming which asset the file is about.
model AssetDocument {
  id        String @id @default(cuid())
  companyId String
  assetId   String

  /// Hangs a repair receipt off the repair it belongs to, so the repair history
  /// carries its own paperwork instead of dumping it in one undifferentiated
  /// pile on the asset.
  repairId String?

  type AssetDocumentType @default(OTHER)

  fileName    String
  contentType String
  sizeBytes   Int
  objectKey   String

  uploadedByUserId String?

  createdAt DateTime @default(now())

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  repair     AssetRepair? @relation(fields: [repairId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation("AssetDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([repairId])
  @@map("asset_documents")
}

// ----------------------------------------------------------- asset requests

/**
 * Where an asset request has got to.
 * PENDING, APPROVED, REJECTED and CANCELLED are the approval engine's own
 * statuses, mirrored here so the request list reads without joining the
 * approval tables - exactly as `LeaveRequest.status` already does.
 * FULFILLED is the one that is NOT the engine's, and it is the distinction
 * section 7 is built around: APPROVED means the company has agreed to give
 * somebody a laptop, and FULFILLED means the asset manager has actually handed
 * one over. A request sits in APPROVED for as long as it takes, and an asset
 * manager cannot move it out of that state by approving anything - only by
 * issuing the kit.
 */
enum AssetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

/**
 * An employee asking the company for equipment.
 * The request is a LIST - a laptop, two monitors, a headset - because that is
 * how people ask, and because splitting it into three requests would send the
 * same chain the same question three times.
 * It carries no asset. An asset is a specific machine with a tag on it, and
 * choosing which one is the asset manager's job at fulfilment time, after the
 * chain has agreed. A request that named an asset up front would be a
 * reservation, which is a different feature and one nobody asked for.
 */
model AssetRequest {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  status AssetRequestStatus @default(PENDING)

  /// Why they need it. Compulsory on the form - a chain of three people cannot
  /// decide "laptop" - and the summary the approvers are shown.
  justification String
  /// When they need it by, where that matters. Optional.
  neededBy      DateTime? @db.Date

  /// The chain deciding this request. One-to-one, and the same shape
  /// `LeaveRequest` uses.
  approvalRequestId String? @unique

  decidedAt   DateTime?
  cancelledAt DateTime?

  /// When the LAST outstanding line was issued or declined. Written by the
  /// fulfilment path only, never by an approval.
  fulfilledAt       DateTime?
  fulfilledByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    AssetRequestItem[]

  @@index([companyId, status])
  @@index([companyId, employeeId, status])
  @@map("asset_requests")
}

/**
 * One line of a request: a category and how many.
 * A CATEGORY, not an asset - "a laptop", not "GE-LAP-014". The category
 * catalogue already exists and is what the register is organised by, so the
 * request speaks the register's own language and the asset manager filtering
 * for something to issue is filtering by the thing that was asked for.
 * Delivery is counted from `assignments`, which are ordinary asset
 * assignments carrying this line's id. A line is satisfied when it has as many
 * as were asked for, or when the asset manager declines it with a reason -
 * "we have no spare monitors until April" is an answer, and leaving the line
 * open forever is not.
 */
model AssetRequestItem {
  id             String @id @default(cuid())
  companyId      String
  assetRequestId String
  categoryId     String

  quantity Int     @default(1)
  notes    String?

  declinedAt       DateTime?
  declinedByUserId String?
  declineReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetRequest AssetRequest      @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)
  category     AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The handovers that fulfil this line. Ordinary assignments, pointed at.
  assignments  AssetAssignment[]

  @@index([assetRequestId])
  @@index([companyId, categoryId])
  @@map("asset_request_items")
}
