# ---------------------------------------------------------------------------
# HRMS - local development environment
# Copy to .env  ->  cp .env.example .env
# .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Created by: npm run db:setup   (see scripts/setup-db.ps1)
DATABASE_URL="postgresql://hrms_app:hrms_dev_password@localhost:5432/hrms_dev?schema=public"

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1

# Origin allowed to call the API with credentials (the Vite dev server)
WEB_ORIGIN=http://localhost:5173

# --- Sessions ---------------------------------------------------------------
# 32+ chars. Regenerate for any non-local environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev_only_secret_change_me_0123456789abcdefghijklmnop
SESSION_COOKIE_NAME=hrms_sid
SESSION_TTL_HOURS=8

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=debug

# --- Mail -------------------------------------------------------------------
# `console` logs the message instead of sending it - correct for development
# and test, and only for those. It delivers nothing.
#
# The API refuses to boot when:
#   - NODE_ENV=production and MAIL_PROVIDER=console, unless MAIL_REQUIRE_SMTP=false
#   - MAIL_PROVIDER=smtp without SMTP_HOST or SMTP_PORT
#   - SMTP_USER is set without SMTP_PASSWORD, or the other way round
#
# So production must be MAIL_PROVIDER=smtp with the SMTP_* values below.
MAIL_PROVIDER=console

# Whether a production boot insists on a real SMTP transport. Defaults to true.
# Set to false only as a temporary measure for a production system that has no
# relay yet: the API boots, mail features stay wired up but deliver nothing, and
# password reset stays unavailable until SMTP is configured. Every boot logs an
# error while it is false. Set it back to true once SMTP_* are filled in.
# MAIL_REQUIRE_SMTP=true
# Set this to an address your relay will accept as a sender. The default below
# is a placeholder; most relays reject it.
MAIL_FROM="HRMS <no-reply@hrms.local>"

# Base URL of the web app, used to build links inside emails.
APP_URL=http://localhost:5173

# Required when MAIL_PROVIDER=smtp. Never commit real credentials - set these
# in the deployment environment, not in a file that is tracked.
#
# SMTP_SECURE=true means implicit TLS, which is port 465. Port 587 upgrades
# with STARTTLS and wants SMTP_SECURE=false.
#
# SMTP_USER and SMTP_PASSWORD are optional as a pair: omit both for a relay
# that authenticates by IP. Supplying one without the other fails at boot.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Password reset ---------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=60

# --- Attendance terminals (ADMS push, LAN connector) ------------------------
# The address an inbound caller can reach this API on. API_HOST is normally
# 127.0.0.1, which a device on the LAN cannot use, so set this to the machine's
# LAN address when a pushing device is in play. It only affects the URL the
# devices screen shows an administrator; the endpoints work either way.
#
# A LAN connector uses the same setting, but it usually reaches this server
# from another building - so for a connector this should be the public HTTPS
# address rather than a LAN one.
# DEVICE_PUSH_ORIGIN=http://192.168.1.50:4000
#
# A pushing terminal also needs the API to be listening on that address.
# API_HOST above defaults to 127.0.0.1, which refuses connections from the
# network, so set API_HOST=0.0.0.0 as well - on a network you control.
