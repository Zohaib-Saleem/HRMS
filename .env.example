# ---------------------------------------------------------------------------
# HRMS - local development environment
# Copy to .env  ->  cp .env.example .env
# .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Created by: npm run db:setup   (see scripts/setup-db.ps1)
DATABASE_URL="postgresql://hrms_app:hrms_dev_password@localhost:5432/hrms_dev?schema=public"

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1

# Origin allowed to call the API with credentials (the Vite dev server)
WEB_ORIGIN=http://localhost:5173

# --- Sessions ---------------------------------------------------------------
# 32+ chars. Regenerate for any non-local environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev_only_secret_change_me_0123456789abcdefghijklmnop
SESSION_COOKIE_NAME=hrms_sid
SESSION_TTL_HOURS=8

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=debug

# --- Mail -------------------------------------------------------------------
# `console` logs the message instead of sending it - correct for development.
# Switch to `smtp` in production and supply the SMTP_* values below; the API
# refuses to boot if MAIL_PROVIDER=smtp without SMTP_HOST and SMTP_PORT.
MAIL_PROVIDER=console
MAIL_FROM="HRMS <no-reply@hrms.local>"

# Base URL of the web app, used to build links inside emails.
APP_URL=http://localhost:5173

# Required only when MAIL_PROVIDER=smtp. Never commit real credentials.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Password reset ---------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=60

# --- Attendance terminals (ADMS push) ---------------------------------------
# The address a biometric terminal can reach this API on. API_HOST is normally
# 127.0.0.1, which a device on the LAN cannot use, so set this to the machine's
# LAN address when a pushing device is in play. It only affects the URL the
# devices screen shows an administrator; the endpoints work either way.
# DEVICE_PUSH_ORIGIN=http://192.168.1.50:4000
#
# A pushing terminal also needs the API to be listening on that address.
# API_HOST above defaults to 127.0.0.1, which refuses connections from the
# network, so set API_HOST=0.0.0.0 as well - on a network you control.
