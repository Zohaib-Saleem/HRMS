# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
logs/

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# connector, on a machine where it is actually installed. The config holds a
# token, so it must never be committed by accident.
apps/connector/connector.config.json
apps/connector/connector.state.json
!apps/connector/connector.config.example.json

# Uploaded files (employee profile photos). The development default for
# STORAGE_ROOT; the deployment mounts a volume elsewhere. Employee PII.
#
# Anchored to the repository root on purpose. A bare `storage/` matches a
# directory of that name at ANY depth, which silently swallowed the API's own
# `apps/api/src/core/storage/` source directory.
/storage/

# misc
.cache/
coverage/

# Database dumps taken before imports/migrations. Contain employee PII.
backups/

# Plaintext login credentials and password plans. Never commit.
credentials/
