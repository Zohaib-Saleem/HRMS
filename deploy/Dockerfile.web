# HRMS web - Vite/React build, served as static files by Caddy.
#
# The Vite dev server is never used here: `vite build` emits a static bundle and
# a file server serves it. The app calls the API at the relative path /api/v1,
# so the edge proxy puts both on one origin and the session cookie stays
# same-site.
FROM node:22-bookworm-slim AS builder

WORKDIR /build

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/zkteco/package.json packages/zkteco/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/connector/package.json apps/connector/

# Every workspace manifest, because `npm ci` insists the lockfile describes the
# whole tree even when only one workspace is built here.
RUN npm ci

COPY packages/shared packages/shared
COPY apps/web apps/web

RUN npm -w @hrms/shared run build
RUN npm -w @hrms/web run build

# ---------------------------------------------------------------------------
FROM caddy:2-alpine AS runner

COPY --from=builder /build/apps/web/dist /srv
COPY deploy/Caddyfile.web /etc/caddy/Caddyfile

EXPOSE 80
