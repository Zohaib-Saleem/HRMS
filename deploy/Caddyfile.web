# Internal static file server for the HRMS SPA.
#
# Listens on plain HTTP on the container network only - TLS and the public
# hostname are handled by the edge Caddy. `try_files` sends unknown paths to
# index.html because client-side routing owns them; without it a refresh on
# /employees would 404.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed asset filenames are immutable; index.html must never be cached or
	# a deploy leaves browsers pinned to a stale bundle.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
